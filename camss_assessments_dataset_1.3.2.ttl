        owl:NamedIndividual ;
    cav:judgement """'HTTPS is not related to data accuracy. Therefore this criterion is not applicable to the specification.  \r
\r
HTTPS specification:\r
https://tools.ietf.org/html/rfc2818'"""@en ;
    cav:refersTo camssa:c8bc8c22-a22e-4ff7-8ddf-de0064990e6e .

camssa:6758c2ee-b8dd-41ef-90d9-616f22d43869 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"ISAE 3402 is part of the International Federation of Accountants (IFAC) standard providing companies in the \r
financial sector with an independent assessment tool on user entities' controls over financial reporting. The ISAE 3402 auditing tool, therefore, it does not allow customisation. \r
\r
ISAE 3402 handbook reference:\r
https://www.ifac.org/system/files/downloads/b014-2010-iaasb-handbook-isae-3402.pdf\""""@en ;
    cav:refersTo camssa:c37f41a1-f676-4905-91b9-fc6b8d29da52 .

camssa:67603478-ab36-40c0-a557-b0135fe175e3 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-c967c90bfc7bc13426924eca012de349ae51d4e8f652fe64bfbec2cccc8c8146 ;
    cav:value "0" .

