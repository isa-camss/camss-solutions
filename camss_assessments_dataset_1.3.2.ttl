camssa:028a54e1-63e7-4989-91b4-60eeace04f6b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISAE 3402 has been selected as the basis for the Cloud Computing Compliance Controls Catalogue \r
(C5), which outlines prerequisites for a conformity assessment using international standards (ISAE 3000, \r
ISAE 3402), adding cloud-specific requirements, especially for transparency.\r
\r
Joinup Cloud Computing (RP 2020):\r
https://joinup.ec.europa.eu/collection/rolling-plan-ict-standardisation/cloud-computing-rp2020'"""@en ;
    cav:refersTo camssa:08197085-9d53-415a-901b-441b2dd0b841 .

