camssa:8794e13c-d035-4422-9a09-b0859ec24c8f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are several studies assessing SOAP 1.2 performance and features in terms of efficiency and effectiveness. As REST and SOAP-based web services are living together nowadays, one of the topics is the performance comparison. Moreover, the comparison between different SOAP toolkits is an exploited topic. \r
\r
Performance and Usage Between REST and SOAP Reference: \r
https://aaltodoc.aalto.fi/bitstream/handle/123456789/29224/master_Makkonen_Joni_2017.pdf?sequence=1&isAllowed=y \r
\r
SOAP Toolkits Assessment Reference:\r
https://dl.acm.org/citation.cfm?id=1033266'"""@en ;
    cav:refersTo camssa:3148267b-d38b-4f1d-9b31-7336ba4874b3 .

camssa:87961ec8-dc69-46bb-889f-b5854c196e94 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d9b9ce1d270550422a8ea6097d2ffa1d923267fd681c56280e3b7810a14a580a ;
    cav:value "100" .

