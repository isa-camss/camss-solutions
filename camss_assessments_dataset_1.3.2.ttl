        owl:NamedIndividual ;
    cav:assignedTo sc:c-d2c939f8f97b2a02c254da4add5fcbea1311d465178344adc029d82366a0f642 ;
    cav:value "100" .

camssa:3833001f-19de-4ddf-8351-8b844491dcc4 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-c2cedd44f05183dae5548108bdeace2c092b84c7c5d89c475b0741ddae7fc7b2 ;
    cav:value "1" .

camssa:3837aa32-75d8-4b89-b166-cfef992a2330 a cav:Score,
        owl:NamedIndividual ;
