        owl:NamedIndividual ;
    cav:assignedTo sc:c-c265ca0c56e0f29a34039d496ba707b5486ccf6d445f9f058c19b4ece977861f ;
    cav:value "2" .

camssa:2811d860-37a3-4f66-8843-ce11c2c2d571 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Asset Administration Shell (AAS) has some provisions for data protection at technical level but no mentions to the regulations applied is to be found. In particular, the specification refers to the IEC 63278 as basis for the data protection protocols in place.

Data protection on the AAS:
https://admin-shell-io.github.io/aas-specs-antora/IDTA-01004/v3.0/introduction.html#_iec_63278

Details of the Asset Administration Shell (AAS)
https://industrialdigitaltwin.org/en/wp-content/uploads/sites/2/2024/06/IDTA-01001-3-0-1_SpecificationAssetAdministrationShell_Part1_Metamodel.pdf'"""@en ;
    cav:refersTo camssa:68e28e49-472d-4997-9fe6-9e414a3a9666 .

camssa:28150d3c-5c2f-4955-bced-30c6edd2cc1a a cav:Score,
