    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
    cav:value "100" .

camssa:54d8a72c-4456-4ea0-9038-d1b8ac9ea129 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is not related to the publication of public data as open data. Therefore this criterion is not applicable to this specification.

