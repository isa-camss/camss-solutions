    cav:assignedTo sc:c-245e5eb8db3a19aebfdf9ccc2c2ac0467bebccc76339696f519452e8bbd393ad ;
    cav:value "100" .

camssa:cca90758-e5c5-4896-be0f-b8341954af6b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'This specification has specific sections that present facet models that can be adapted into bussiness models. Furthermore, cloud data portability has an important part where it is thoroughly described how to operate in different case scenarios.\r
\r
ISO 19941: https://www.iso.org/obp/ui/en/#iso:std:iso-iec:19941:ed-1:v1:en'"""@en ;
    cav:refersTo camssa:30c9c668-81fa-4b06-9b89-c8226be32d57 .

