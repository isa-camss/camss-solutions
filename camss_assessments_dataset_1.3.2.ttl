camssa:83cf5a5e-5d96-4328-8ac8-67155d610172 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-26d7b17ff73e55cbf2e7b90ec0eaca8627f132b000e1c8f2de8e5157d8ebe216 ;
