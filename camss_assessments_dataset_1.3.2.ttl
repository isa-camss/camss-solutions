camssa:2e323261-42cc-482c-9de2-1e2120999735 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Schema.org is open to any interested party who has agreed to the W3C Community Contributor License Agreement (CLA) (see Schema.org homepage reference, Community Group and Steering Group section). The W3C Royalty-Free IPR licences granted under the W3C Patent Policy apply to the schema.org specification.\r
\r
Schema.org homepage reference, Community Group and Steering Group section:\r
https://schema.org/docs/about.html\r
\r
W3C Patent Policy reference:\r
https://www.w3.org/TR/patent-practice#ref-AC'"""@en ;
    cav:refersTo camssa:1d2144fa-9c82-4171-8587-22ddeeba737f .

