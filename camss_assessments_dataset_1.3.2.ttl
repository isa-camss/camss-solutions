        dcat:Distribution ;
    dcat:accessURL "None"^^xsd:anyURI .

camssa:c1099164-4c5f-4f21-99ab-eb465864d360 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ETSI TS 119 612 plays a supportive role in securing trust services that public administrations may use, which in turn helps protect personal data by ensuring secure transactions, strong authentication, and data integrity. However, the specification does offer mechanisms for data protection, but without being exhaustive.

ETSI TS 119 612:
https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.02.01_60/ts_119612v020201p.pdf'"""@en ;
    cav:refersTo camssa:3f75be11-8c21-476b-aedc-ca20f4890b90 .

camssa:c110d527-f57c-488a-96b6-8ce206465c8e a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-583a0f52df591048a41be40620830a70260e77855364174d91ba159970d8488e ;
    cav:value "100" .

camssa:c1147443-210b-4b6e-8d5f-048201eb1aa4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The specification was formally defined back in 2012, and version 1.0.0 was released by 2017 with the experience and the expertise of Member States that were closely working together to consolidate the specification. \r
\r
Within ELI home page it can be found different materials that help to visualise and understand how the specification has evolved and how it can be implemented smoothly by Member States increasing the interoperability and ensuring the cost-efficiency. \r
\r
The contribution from Member States helps the evolution of the specification to adapt to users needs. \r
\r
ELI reference:\r
https://eur-lex.europa.eu/eli-register/about.html\r
\r
ELI highlights:\r
https://eur-lex.europa.eu/eli-register/index.html"""@en ;
    cav:refersTo camssa:ef234c40-c768-465a-880a-454281e43bb0 .

camssa:c117f519-6efd-4169-80bb-97ae04f4c519 a cav:Score,
