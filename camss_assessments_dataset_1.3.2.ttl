    cav:assignedTo sc:c-02333ef99fbcb4f101a106bcf97c9559888756b085b1729b7c2ac9626dc4bc63 ;
    cav:value "0" .

camssa:e6b3a284-f808-4f5b-8d0c-54744cef10da a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Section 8.7 of the protocol addresses data integrity but does not mention any specific provision. Furthermore, section 5 mentions that the document does not specify any transport layer protocol. Even so, it is specified that any syslog transport protocol must not deliberately alter the syslog message.

Syslog Protocol Message integrity: https://datatracker.ietf.org/doc/html/rfc5424#section-8.7

Syslog Protocol Transport Layer Protocol: https://datatracker.ietf.org/doc/html/rfc5424#section-5'"""@en ;
    cav:refersTo camssa:881cc80a-4d2f-4b76-bf2c-f20cc52d8fc0 .

camssa:e6b9cecf-a6c5-40e5-9993-df9390461c24 a cav:Score,
