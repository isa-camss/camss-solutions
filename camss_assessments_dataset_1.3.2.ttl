        owl:NamedIndividual ;
    cav:assignedTo sc:c-19598487b8ba278c3438dcfd74b74d9aad51beac08c53dbf40bf108ed09e72b2 ;
    cav:value "1" .

camssa:e84c1b90-b8aa-49cc-8f1e-8e9dbe3a7c7d a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-1624157830122d60825aa5aa88ab70d0b140b2e7e510086699f9a9773efef6bd ;
    cav:value "100" .

camssa:e84e20ef-96f1-4bc1-8606-57dfd95c8b9e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"OAS is designed to ease the process of creating an API. As each API set of requirements may vary, it is necessary for the specification to allow for partial implementations, although, as it is stated in the specification's introduction, there is still a need for a minimal degree of implementation.  \r
\r
OAS specification:\r
https://spec.openapis.org/oas/latest.html#openapi-specification\r
\r
OAS in Github:\r
https://github.com/OAI/OpenAPI-Specification/#participation\""""@en ;
    cav:refersTo camssa:ea168d96-38ea-4fe5-807c-e769dd930550 .

camssa:e8560eda-f308-4460-acb5-697e711477e7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"As the specification follows the law of ECLI, which is a uniform identifier that has the same recognizable format for all Member States and EU courts, it can be significant of the specification's efficiency, if used together with other specifications.\r
There is nothing that indicates anything about the specification inside the nifo factsheets or the lists of standards.\r
\r
NIFO Factsheets:\r
https://joinup.ec.europa.eu/collection/nifo-national-interoperability-framework-observatory/digital-public-administration-factsheets-2022\r
\r
List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards\r
\r
ECLI Webpage:\r
https://e-justice.europa.eu/175/EN/european_case_law_identifier_ecli?init=true\""""@en ;
    cav:refersTo camssa:65b61e5f-7f9e-4fba-98d6-b850a916fa13 .

camssa:e85f37d5-27c2-4c76-bd7f-46e91e8b0ebe a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """EuroVoc offers several services that aim to help e-Government professionals share their experience. Since it is based on European Union  and National Knowledge it can be useful when creating eGovernment innovative solutions. \r
\r
Eurovoc: \r
https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/eurovoc"""@en ;
    cav:refersTo camssa:ee79282a-f908-4b9d-bda9-3f126e458bc4 .

