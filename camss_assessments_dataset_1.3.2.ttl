        owl:NamedIndividual ;
    cav:assignedTo sc:c-ec3f8a897147f530040ab94fb9bbee9fdad56e7256b2ce6fbb63cf1465315d91 ;
    cav:value "100" .

camssa:ab666ae9-fba6-4c6a-9e77-5e426b74fb47 a cav:Score,
