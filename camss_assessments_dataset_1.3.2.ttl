    cav:value "100" .

camssa:dc6673cf-e231-4d1b-b44b-2c7e3fc4a817 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ETSI TS 119 612 can contribute to data portability by ensuring that digital identity information can be used and trusted across different digital services and borders. This ensures that citizens can easily access services, such as online government services, without the need to recreate their identity information each time.

ETSI TS 119 612:
https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.02.01_60/ts_119612v020201p.pdf'"""@en ;
    cav:refersTo camssa:baeb1369-4769-4f32-9e83-070e913e4989 .

