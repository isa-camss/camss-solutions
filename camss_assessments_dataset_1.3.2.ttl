        owl:NamedIndividual ;
    cav:judgement """'The purpose of CSV is not related to the  delivery of multilingual public services. Therefore, this criterion is not applicable to the specification.          \r
\r
CSV reference:\r
https://datatracker.ietf.org/doc/html/rfc4180'"""@en ;
    cav:refersTo camssa:08c79d4b-c1e3-4b9d-8cc1-31443704b2f4 .

camssa:66adaf19-1f80-4efa-bccb-a9da7d8cb5a9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is not related to the publication of public data as open data. Therefore this criterion is not \r
applicable to this specification.\r
\r
ETSI EN 319 422 reference:\r
https://www.etsi.org/deliver/etsi_en/319400_319499/319422/01.01.01_60/en_319422v010101p.pdf'"""@en ;
    cav:refersTo camssa:0c3a8e29-99da-4e9b-91ff-3926d4699183 .

