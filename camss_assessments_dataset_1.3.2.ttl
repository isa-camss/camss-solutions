        owl:NamedIndividual ;
    cav:assignedTo sc:c-245e5eb8db3a19aebfdf9ccc2c2ac0467bebccc76339696f519452e8bbd393ad ;
    cav:value "40" .

camssa:83b2ef61-4a18-461c-82f2-bfe7da368285 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """HTTP is a transfer protocol which has been developed to exchange the information through computer networks. It is supporting the first level of maturity defined by Tim Berners Lee-s 5 star schema for Open data, "Make your data available" \r
\r
See\r
https://5stardata.info/en"""@en ;
    cav:refersTo camssa:05b73081-3eb1-42d1-a17f-f8072c6841cc .

camssa:83b58ae5-9454-42cb-bbea-e2b77dd65172 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Technical Committee (TC) CYBER (Cybersecurity) provides feature requests to open source projects and results of implementation experience to open source communities. ETSI, as an acknowledged European standardisation, offers different channels for the creation of communities and the sharing of data and results in European platforms.\r
\r
TC CYBER reference:\r
https://www.etsi.org/cyber-security/tc-cyber-roadmap'"""@en ;
    cav:refersTo camssa:6b3a8680-ecf5-4deb-b5a5-f1354abd6662 .

camssa:83b85f6f-bcd1-49c2-9462-b479b32549bb a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d2c939f8f97b2a02c254da4add5fcbea1311d465178344adc029d82366a0f642 ;
    cav:value "20" .

camssa:83badd1f-7206-418d-ad9f-7725b4df1858 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-0b122f4f42ca2089ee158a31d932d6a0332aa3a4d04acce1e2e7aa140815a0ec ;
    cav:value "20" .

camssa:83bf74ec-9e00-4ebd-a040-e0d389034846 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The specification can be used on any operating system and hardware platform."@en ;
    cav:refersTo camssa:2ca951af-da9f-45fd-ac40-0dd8ed83c2c2 .

camssa:83bf7551-b237-4a31-a551-64359cb9e672 a cav:Score,
