        owl:NamedIndividual ;
    cav:judgement """'The purpose of ETSI TS 119 614-1 is not related to the secure exchange of data. Therefore this criterion is \r
not applicable to this specification.\r
\r
ETSI TS 119 614-1 reference:\r
https://www.etsi.org/deliver/etsi_ts/119600_119699/11961401/01.01.01_60/ts_11961401v010101p.pdf'"""@en ;
    cav:refersTo camssa:6302ed28-64e7-4b06-a462-be1114b2e2e5 .

