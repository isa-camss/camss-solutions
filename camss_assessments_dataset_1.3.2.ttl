camssa:25a13dea-daf5-4799-b055-5ea8cd82a188 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Genericode can be used on any computing platform or operating system without requiring modifications. As an XML-based standard, it is independent of any specific hardware or software platform. It defines a structured format for representing code lists and controlled values using XML elements and attributes, which can be processed and interpreted by any system that supports XML parsing.

Code List Representation (genericode): https://docs.oasis-open.org/codelist/genericode/v1.0/os/genericode-v1.0-os.html'"""@en ;
    cav:refersTo camssa:b028eb19-2f40-4189-b18d-f72842063b39 .

camssa:25a2e7f2-e24e-4793-a79d-4a2ef955fa8b a cav:Score,
