camssa:28d17527-8184-417c-8e3b-1da839df5163 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'While the OpenAPI Specification tries to accommodate most use cases, additional data can be added to extend the specification at certain points.  The extensions may or may not be supported by the available tooling, but if tools are internal or open-sourced, those may be extended as well to add requested support.\r
\r
OAS Extensions:\r
https://spec.openapis.org/oas/latest.html#specification-extensions\r
\r
OAS specification:\r
https://spec.openapis.org/oas/latest.html#openapi-specification\r
\r
OAS in Github:\r
https://github.com/OAI/OpenAPI-Specification/#participation'"""@en ;
    cav:refersTo camssa:5226e92b-af1f-47ad-93d5-21f32a035d41 .

