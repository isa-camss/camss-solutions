        owl:NamedIndividual ;
    cav:assignedTo sc:c-69e927013383f3944a629c01e930a6663b8304aa5f3137b9a5de3c02d34da401 ;
    cav:value "100" .

camssa:cce5cac5-db4c-4375-b859-8042cbf29646 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of XHTML is to publish administrative data on the web, as one of the main languages used in web development, XHTML helps and fosters the visibility of administration data and services. Moreover, it also eases the decision-making process by ensuring the data exchange and data reuse. \r
\r
XHTML W3C reference:\r
https://www.w3.org/TR/xhtml1/"""@en ;
    cav:refersTo camssa:e659f2ed-c13d-4627-892e-1599a08e760e .

camssa:cceaeb42-6aab-4a22-863d-9257df91cce3 a cav:Score,
