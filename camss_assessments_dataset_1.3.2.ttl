camssa:48b028e5-7405-4efb-b4f1-04aab000346a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The PAdES Baseline Profile is designed to guarantee the authenticity and authentication of the agents involved in data transactions. It achieves this by focusing on the signer's identity and their role, which is a core requirement of the eIDAS regulation._x000D_
_x000D_
eIDAS Regulation:_x000D_
https://digital-strategy.ec.europa.eu/en/policies/eidas- regulation_x000D_
_x000D_
PAdES reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31914201/01.02.01_60/en_31914201v010201p.pdf\""""@en ;
    cav:refersTo camssa:8c4146a4-451a-4a21-90d9-da4b204806ed .

camssa:4cb22de4-d3a2-4727-afac-65877966ce60 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3dd3a1fb1ac7d78d162dab36230e70a34459f38a795e765cc5fdd304c8c04907 ;
    cav:value "100"^^xsd:string .

camssa:502fb51a-7be9-42bc-a754-9fbd6478cdd9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ETSI has provided a conformance testing tool for electronic signatures. The conformity testing tool involves different standards applied in the development of eSignatures, including PAdES, CAdES and XAdES and their respective baseline profiles._x000D_
_x000D_
Conformance Checker reference_x000D_
https://signatures-conformance-checker.etsi.org/_x000D_
_x000D_
PAdES reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31914201/01.02.01_60/en_31914201v010201p.pdf'"""@en ;
    cav:refersTo camssa:007581f7-3c45-47c2-9607-7d11fdfa81d3 .

