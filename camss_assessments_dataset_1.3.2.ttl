        owl:NamedIndividual ;
    cav:assignedTo sc:c-7aa038b5496afb8cb229c692be9a2adc175deb2d5d47e35ad67e027c9eac28ba ;
    cav:value "1" .

camssa:d5a9894e-8bb1-405b-bc11-930dac5b19d4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """This Core Vocabulary offers several services that aim to help e-Government professionals share their experience with each other, so it fosters the creation of innovative solutions.\r
\r
CPSV-AP reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-public-service-vocabulary-application-profile"""@en ;
    cav:refersTo camssa:dd6a6c89-748b-4f21-876a-9fe36b06ba45 .

