        owl:NamedIndividual ;
    cav:judgement """'OAS is developed by the OpenAPI initiative (OAI), an organisation operating under the Linux Foundation.  Therefore, it is not a European standard.\r
\r
OAS specification:\r
https://spec.openapis.org/oas/latest.html#openapi-specification\r
\r
OAS in Github:\r
https://github.com/OAI/OpenAPI-Specification/#participation'"""@en ;
    cav:refersTo camssa:968259d9-1253-4e1d-8334-ceb80ec1246e .

camssa:d61bd5f1-3c95-4472-93bd-e906e9eebe57 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-9b3cb1ef128e2a87386258a5812c05b520024e6e4a404d1f1d6f0e35707e8a7b ;
    cav:value "80" .

camssa:d621b791-2c07-4418-87a1-4ff1d8f56d14 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """CSS is maintained by W3C which is an international community developing open standards. \r
\r
Developer community W3C:\r
https://www.w3.org/Consortium/"""@en ;
    cav:refersTo camssa:94322388-d9a2-44f6-8237-3cce7e051e2e .

