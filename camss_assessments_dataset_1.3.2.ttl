    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
    cav:value "100" .

camssa:7fc24a82-c076-478e-bca5-23c23bee6d43 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """As a lightweight protocol for securing data packets, IPsec allows the scalability of systems. Its use for large amounts of data does not hamper performance. For instance, the TESTA project, which provides a secure cross-border data communication network service for public administrations, uses IPSec for national and European connections. \r
\r
See: \r
https://ec.europa.eu/isa2/solutions/testa_en"""@en ;
    cav:refersTo camssa:97dba39f-37aa-46d1-b29f-2a49b785b3cc .

