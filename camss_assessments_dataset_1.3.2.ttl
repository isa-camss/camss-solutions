    cav:assignedTo sc:c-1cd71a7b6d54631ba58cc8b0655a443d696f49ec74a0f4cccc871de7789d6a60 ;
    cav:value "1" .

camssa:6037c214-c556-4c4c-9b42-57eb4363ceb1 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Based on the information available on the CEN website, the scope of the specification does not explicitly mention the modeling of business processes.\r
\r
CEN reference:\r
https://www.cen.eu/Pages/default.aspx                                                              \r
AKN4EU reference:\r
https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/akn4eu'"""@en ;
    cav:refersTo camssa:28b1a375-7920-444a-86a3-0d8ad9ac9b38 .

