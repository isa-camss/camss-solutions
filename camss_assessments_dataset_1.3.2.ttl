        owl:NamedIndividual ;
    cav:judgement """'There are no Member States recommending OpenTelemetry in their ICT National Catalogues.

CAMSS List of Standards:
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss
/camss-list-standards '"""@en ;
    cav:refersTo camssa:481dd6cb-63a6-43ef-9752-90fbd5715f86 .

