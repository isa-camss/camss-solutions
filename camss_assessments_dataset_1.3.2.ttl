        owl:NamedIndividual ;
    cav:assignedTo sc:c-7aa038b5496afb8cb229c692be9a2adc175deb2d5d47e35ad67e027c9eac28ba ;
    cav:value "1" .

camssa:a95d08b5-57b2-42e1-b233-03e44f35efc8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification does not include any reference related to the possibility of being partially used, so it can be asumed CSV has to be used as a whole.        \r
                                                  \r
CSV reference:\r
https://datatracker.ietf.org/doc/html/rfc4180'"""@en ;
    cav:refersTo camssa:56450828-2317-44c2-8587-0a7ddf40ea56 .

camssa:a95d4871-320a-4573-a719-678240e15da1 a cav:Score,
