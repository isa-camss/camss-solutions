    dcat:accessURL "http://data.europa.eu/w21/72798d22-50e4-46ce-aee6-da5cd4fb136c"^^xsd:anyURI .

camssa:73096671-4c78-40d7-948f-49074ac2d68c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """By defining common vocabulary that can be expressed in a machine-readable format, the specification can foster the exchange of data between administrations and systems supporting its implementation. \r
\r
W3C specification reference: \r
https://www.w3.org/TR/odrl-vocab/#vocab-core"""@en ;
    cav:refersTo camssa:95856cec-b90b-4467-a560-df8738b30dae .

camssa:730cd884-201a-47a5-99fc-bd159d7b598d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification aggregate data from multiple UI components in order to not repeat code or queries to get the desired data.  \r
                                                                                                                                                                                    \r
GraphQL Multiple UI Site: \r
https://graphql.org/learn/queries/#fragments'"""@en ;
    cav:refersTo camssa:86e51d4e-7bf3-4bbd-827d-c4ce9f2b0afb .

camssa:730f2f91-b5b7-43d2-ab6e-e589f7340d2f a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-c2d03f19521389763921ce9c758a3697caa22bed98c2c11c3b10344b11c468bb ;
    cav:value "80" .

camssa:731fdd68-22d9-4077-be6a-16a16592504b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The SHACL specification can be found assessed and discussed in different forums. In example, we can mention the Netherlands Standardisation Forum, where the specification is assessed. In addition, there are many papers discussing SHACL and how it can be implemented. 

Netherlands Standardisation Forum SHACL: 
https://www.forumstandaardisatie.nl/open-standaarden/shacl

SHACL W3C reference:
https://www.w3.org/TR/shacl/'"""@en ;
    cav:refersTo camssa:1fbce84e-f8d5-4faa-9ad8-1096397c8c43 .

camssa:7322904d-09c0-4e99-8a07-06e634df76e5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Domibus is not a European standard in the sense of being an official standardization document or specification issued by a recognized European standardization organization. However, it is treated as such given that it is an important component from the eDelivery building block. regarded as an eIDAS regulation enabler.\r
\r
Digital Europe eDelivery:\r
https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/eDelivery\r
\r
Domibus specification:\r
https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/Domibus'"""@en ;
    cav:refersTo camssa:ec192a0a-ace9-4b58-b206-51c60be27bb7 .

camssa:7329462c-bdff-438b-890c-7f406b1e9d18 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-22c3c5b40201f4ab2cb64a2d34b7665f8d0d1562f2a3e1a493dd3312608c7537 ;
    cav:value "100" .

