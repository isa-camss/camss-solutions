    cav:value "100"^^xsd:string .

camssa:86b520f2-12d8-41cc-b13c-22d07379a135 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-bb5b5da7c1dc98a64c6a6f22f8fc539a8f80702f896697e985dd2c06d4ab68aa ;
    cav:value "80"^^xsd:string .

camssa:87365cd3-5ad8-493c-b226-8b8b0c9af44c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"XAdES is within the European eIDAS regulation which is legally binding for all EU members states._x000D_
Also, XAdES is a core element in some EU countries digital government initiatives, like Belgium's e-procurement system or Poland's financial report signatures._x000D_
_x000D_
Belgium's e-procurement reference:_x000D_
https://bosa.service-now.com/csp?id=kb_article_view&sys_kb_id=fca9cf651ba3b5543ff06421b24bcb98_x000D_
_x000D_
Poland's financial report signatures reference:_x000D_
https://www.podatki.gov.pl/komunikaty-techniczne/sprawozdania-finansowe-osob-fizycznych-w-formacie-xades/_x000D_
_x000D_
eIDAS Regulation:_x000D_
https://digital-strategy.ec.europa.eu/en/policies/eidas-regulation_x000D_
_x000D_
XAdES reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31913201/01.02.01_60/en_31913201v010201p.pdf\""""@en ;
    cav:refersTo camssa:cb014620-967b-49b2-9932-a6aeae38888a .

camssa:8793f257-2656-40ba-af60-de3aef6a3f50 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The efficiency of the XAdES specification has been assessed by the Department of Computer Science at the University of Brasília (UnB). The "A Digital Signature Model Using XAdES Standard as a REST Service" study, addresses XAdES as the essential technological and regulatory foundation for the implementation of digital signatures in university diplomas in Brazil. Although it addresses certain capabilities of XAdES, rather than the XAdES Baseline, a general overview of XAdES, which is the same in both cases, is provided._x000D_
_x000D_
"A Digital Signature Model Using XAdES Standard as a REST Service" study:_x000D_
https://www.mdpi.com/2078-2489/12/8/289_x000D_
_x000D_
XAdES reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31913201/01.02.01_60/en_31913201v010201p.pdf'"""@en ;
    cav:refersTo camssa:9351dc9e-ef51-4338-b837-9242675c81a2 .

