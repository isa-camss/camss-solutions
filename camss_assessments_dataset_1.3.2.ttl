    cav:assignedTo sc:c-e46f1a4a060cc7e143e32e4833c94af9164c37bc0d4c844bd1fa974ffb2ac225 ;
    cav:value "100" .

camssa:9b2401f7-6b0b-48cc-8a5e-dfe96bdcc1ea a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of Xforms is not related to organisational interoperability. Therefore, this criterion is not applicable to the specification. \r
\r
Xforms 2.0 W3C reference:\r
https://www.w3.org/community/xformsusers/wiki/XForms_2.0"""@en ;
    cav:refersTo camssa:d484c580-d8d4-4dd1-82ba-0fb6c3ba2722 .

camssa:9b24ffb2-9b88-49f5-af90-8822926e18b8 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-fb2c0a4ddb03b09ecd5450c5a1d6aeed4e51c2a0387709a95a89cd850a7dd180 ;
    cav:value "100" .

