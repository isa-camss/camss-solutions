    cav:assignedTo sc:c-22c3c5b40201f4ab2cb64a2d34b7665f8d0d1562f2a3e1a493dd3312608c7537 ;
    cav:value "100" .

camssa:9e5dfbf5-8aca-4e97-841b-8a15a1169865 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """IPv4 is maintained and developed by IETF which is an international community developing open standards. \r
Additionally, it has support from the different Regional Internet Registries (RIRs) in order to ensure the proper development beyond borders. \r
See: \r
https://www.arin.net/\r
https://www.ripe.net/\r
https://afrinic.net/\r
https://www.apnic.net/\r
https://www.lacnic.net/"""@en ;
    cav:refersTo camssa:2a09bd9a-8fbf-4578-a670-d37251181e65 .

camssa:9e5ec833-45dc-454a-9bdb-846a38b9a1d9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are many ways on which customisations can be added to RDF such as the custo graph views provided by GraphDB, or also by creating custom datatypes in order to assign a URI in a controlled  namespace.\r
\r
GraphDB Custom  Graph View:\r
https://graphdb.ontotext.com/documentation/9.3/free/devhub/custom-graph-views.html'"""@en ;
    cav:refersTo camssa:c177c6ee-5697-410f-b35e-f45420be7991 .

camssa:9e63a096-4f42-4bb3-b2ef-aa0ab70f86fd a cav:Score,
