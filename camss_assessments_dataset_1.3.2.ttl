        owl:NamedIndividual ;
    cav:assignedTo sc:c-5df7a9f6081c945a22f500aa0ba2c452b8b9cd9497bd643ac76c39d34a18c319 ;
    cav:value "0" .

camssa:72086895-a816-4f6b-98dc-08713d886416 a cav:Score,
