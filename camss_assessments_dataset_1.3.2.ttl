        owl:NamedIndividual ;
    cav:judgement """'NFVI is included in the EUOS European catalogue of standards.\r
\r
EUOS reference:\r
https://www.standict.eu/standards-repository'"""@en ;
    cav:refersTo camssa:46b38a6c-3b35-4514-b908-0391cbb862e7 .

