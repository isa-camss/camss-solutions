    cav:value "20" .

camssa:78a4b2c8-e0bd-4520-8930-ef5ee468ab0b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """There are many documents that evaluate the effectiveness and efficiency of this specification. For example, in the following link there is a study of Xforms called "Efficient evaluation of shared predicates for XForms page access control".\r
\r
Xforms evaluation:\r
https://ieeexplore.ieee.org/document/4766728"""@en ;
    cav:refersTo camssa:1208faba-3634-4a32-8825-b127bdbaca51 .

camssa:78aec75f-389b-4f30-bdfc-961db22949c8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The purpose of JSON is not related  to the modelling of business processes. Therefore, this criterion is not applicable to the specification."@en ;
    cav:refersTo camssa:ce1b7a3f-1bdc-4f2e-a6f7-96a0d2574dcb .

camssa:78af3d5a-bdd7-497d-bceb-7dc092298cff a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There has not been found any article or study assessing the effectivenss of the ISO/IEC 19944-1.  \r
\r
ISO/IEC 19944-1 specification:\r
https://www.iso.org/standard/60545.html'"""@en ;
    cav:refersTo camssa:a9b93f21-11cb-4a3c-812e-a19a9236c097 .

camssa:78af7f3b-da40-4f50-9f31-db1b9c04ba07 a cav:Statement,
        owl:NamedIndividual ;
