    cav:value "100" .

camssa:03fa424b-9f5a-4af3-880a-3c62994d34c3 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"TOSCA is not included in any Member States' catalogues of recommended specifications.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards\""""@en ;
    cav:refersTo camssa:68b05928-1c4e-4b67-8da6-4f824e263f35 .

