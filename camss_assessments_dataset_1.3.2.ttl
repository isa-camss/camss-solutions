camssa:652270d5-b09d-4170-a1af-8e720bd433d7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There has not been found any European cross-border project directly using ISO/IEC 19944-1.  Nonetheless, the EUCS Cloud Service Scheme, is  using the components from ISO/IEC 17788 and ISO/IEC 17789, standards from which ISO19944-1 is derived and extended.\r
\r
ISO/IEC 19944-1 specification:\r
https://www.iso.org/standard/60545.html\r
\r
EUCS project:\r
https://www.enisa.europa.eu/publications/eucs-cloud-service-scheme'"""@en ;
    cav:refersTo camssa:2d67c895-5bb4-4f77-bed1-5d779ad47c42 .

