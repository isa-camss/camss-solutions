camssa:42cea695-4739-4bdc-a3f0-3f4d2867a69d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OpenTelemetry is currently in its 33rd version. Changes to the specification are versioned according to Semantic Versioning 2.0 and described in CHANGELOG.md. Layout changes are not versioned. Specific implementations of the specification should specify which version they implement. Changes to the change process itself are not currently versioned but may be independently versioned in the future. Furthermore, the specification has a section dedicated to past and futures milestones. 

OpenTelemetry Versioning: 
https://github.com/open-telemetry/opentelemetry-specification/#versioning-the-specification

OpenTelemetry Milestones: https://github.com/open-telemetry/opentelemetry-specification/milestones'"""@en ;
    cav:refersTo camssa:22e3f37e-8a48-4911-a442-9d3c2f0bbdbe .

camssa:42cfe6df-6364-4948-a2fe-7f3e68a5d4ee a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-ec3f8a897147f530040ab94fb9bbee9fdad56e7256b2ce6fbb63cf1465315d91 ;
    cav:value "100" .

