    cav:value "100" .

camssa:54ab38f4-6246-4157-83b9-0b72b218c1a2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'At the moment of performing the assessment, no initiative at national or European level has been found to\r
use ISO 19941 to cover privacy aspects.\r
\r
ISO 19941: https://www.iso.org/obp/ui/en/#iso:std:iso-iec:19941:ed-1:v1:en\r
'"""@en ;
    cav:refersTo camssa:38c8124f-f8f5-4147-86ca-a65974fbfc72 .

