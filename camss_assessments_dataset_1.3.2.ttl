camssa:ecd3d82e-2615-4c4e-a4a9-e14ce2d6da8e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'This Core Vocabulary offers several services that aim to help e-Government professionals share their experience with each other, so it fosters the creation of innovative solutions.\r
\r
CPSV-AP Joinup webpage:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/core-public-service-vocabulary-application-profile/release/22'"""@en ;
