    cav:value "60" .

camssa:0926a1d6-b1b4-4d81-bef5-8f62fa599830 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Ogg is one of the most used free media container to publish videos using HTML5. HTML5 is an important mark-up language which is used to develop websites. So Ogg can be considered a specification that fosters the creation of innovative solutions.\r
\r
Ogg XIPH reference:\r
https://xiph.org/ogg/doc/rfc3533.txt\r
\r
Ogg with HTML5:\r
https://designcoral.com/tips/what-formats-are-needed-to-publish-html5-videos/"""@en ;
    cav:refersTo camssa:681bc37e-455b-4d85-bc8b-c60064078dac .

camssa:092d6afc-095b-4784-8afe-87e2bd82c1b7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are existing studies assessing HTTPS in terms of efficiency. Some of the studies found assess HTTPS in comparison with the HTTP specification, or an empirical study of the cost of DNS-over-HTTPS.\r
\r
A COMPARISON OF HTTP AND HTTPS PERFORMANCE:\r
https://citeseerx.ist.psu.edu/documentrepid=rep1&type=pdf&doi=1cd89de5cf0e618924c73ac2b060104b7076f0b7\r
\r
A Survey on HTTPS Implementation by Android Apps: Issues and Countermeasures:\r
https://www.sciencedirect.com/science/article/pii/S2210832716300722\r
\r
An Empirical Study of the Cost of DNS-over-HTTPS:\r
https://dl.acm.org/doi/abs/10.1145/3355369.3355575'"""@en ;
    cav:refersTo camssa:f67f34f4-142c-4266-be24-8e80f53b2c8c .

camssa:0935530c-6acf-4c79-9760-c48146700177 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-0e9bb259b84413d890a0fd548e40f255bb983a3add2eb7a737283f711e23d523 ;
    cav:value "100" .

camssa:0937de0d-3d81-46d7-ae78-1384206f874f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The DCAT specification explicitly mentions a section in its documentation about rights and obligations that can guarantee the protection against unauthorised changes. It can use the properties dcat:rights, dcat:accessRights and dcat:license to ensure this protection.\r
\r
\r
DCAT (v2.0.0) reference (section 8):             \r
https://www.w3.org/TR/vocab-dcat-2/ '"""@en ;
    cav:refersTo camssa:0fe0d146-e942-41a4-84a4-8303d358e102 .

