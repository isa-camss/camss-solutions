    cav:value "1" .

camssa:7d997a94-f718-416e-a0f4-f1d99fb3d836 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'CSV makes sure content is available on the web, structures data and makes it usable in a non-proprietary open format. Consequently the CSV enables the digital service delivery channels as it makes files available for any system.     \r
                         \r
CSV reference:\r
https://datatracker.ietf.org/doc/html/rfc4180'"""@en ;
    cav:refersTo camssa:479f3033-5ec8-4631-8d8f-db46ae1024a8 .

