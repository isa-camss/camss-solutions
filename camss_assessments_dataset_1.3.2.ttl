camssa:1baa0889-feda-49a8-81e2-62532288e9c5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "By allowing the exchange of datasets metadata, DCAT increases the searchability, visibility, discoverability and reuse of existing data, including information on processes and administrative rules. "@en ;
    cav:refersTo camssa:df054fa6-4546-4961-bfcb-e0647b4b39c2 .

