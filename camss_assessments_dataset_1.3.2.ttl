camssa:ecb4932f-030e-49c9-89da-8454babdc9ef a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification can be used as an annex in interoperability agreements. Through the use of XBRL GL Profiles, organisations that wish to interchange data can communicate and agree upon the scope, amount, and restrictions on the data to be interchanged and, where feasible, automate the evaluation of conformation and data quality being exchanged._x000D_
_x000D_
XBRL 2015 reference: _x000D_
https://www.xbrl.org/int/gl/2015-03-25/GLTFTA-REC-2015-03-25.html_x000D_
 _x000D_
XBRL 2017 reference:_x000D_
https://www.xbrl.org/int/gl/2016-12-01/gl-framework-2017-PWD-2016-12-01.html'"""@en ;
    cav:refersTo camssa:5ce91237-998a-42ca-9e56-4ea03d4d0500 .

