    cav:value "100" .

camssa:1678c4d7-80ea-41a9-b828-4241e392f54a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """' There are assessments that evaluate the efficiency by evaluating digital solutions that involve the specification, as it shows in the following link:                                       \r
\r
