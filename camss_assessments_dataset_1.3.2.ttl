camssa:7f451197-bbdc-41ed-a3a8-e850919aa6f2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Acoording to this specification, regardless of the domain special attention has to be given to personal information. For instance, section 5.2.2.5 of the ISO mentions the regulation (EU) 2016/679 about General Data Protection Regulation. \r
\r
ISO 19941: https://www.iso.org/obp/ui/en/#iso:std:iso-iec:19941:ed-1:v1:en\r
\r
EU 2016/679: https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%3A32016R0679'"""@en ;
    cav:refersTo camssa:5d1a4b70-c9ac-4af1-a0a0-ba49e30f6939 .

camssa:7f46f849-b28e-4f97-b454-275e5015ab58 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a60f86e868fe2bdcf0c5c47111455d1d5b59498172688e36f23a77baa347d916 ;
    cav:value "100" .

