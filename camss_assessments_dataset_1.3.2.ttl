    cav:assignedTo sc:c-51782b9aa4b92f4aba322a549b9d3972e304ca68f9353073c29add782502d910 ;
    cav:value "80" .

camssa:c3c98af7-0f91-46a5-b5e6-f87a21709d6e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """ETSI’s Intellectual Property Rights Policy is based on Standard Essential Patents (SEP). The policy implemented by the standardisation organisation seeks to reduce risks and ensure that the standards are available under (F) RAND basis and Royalty-free, it means with no cost or fee to be paid when possible. \r
See: \r
https://www.etsi.org/intellectual-property-rights"""@en ;
    cav:refersTo camssa:8846260c-37f2-4b3c-854e-598451e35de9 .

camssa:c3cc5107-922a-4727-a17a-4a50a4b0e903 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ETSI carries out the NFV Plugtests Programme. This programme offers a seamless and ubiquitous environment for collaborative testing and validation workshops between different organisations. The NFVI specification effectiveness was tested in different-purpose reports by the ETSI Centre for Testing and Interoperability.\r
\r
ETSI Plugtests Programme:\r
https://www.etsi.org/technologies/nfv/nfv-plugtests-programme\r
\r
ETSI Centre for Testing and Interoperability:\r
https://portal.etsi.org/Services/Centre-for-Testing-Interoperability/Downloads/TestReports'"""@en ;
    cav:refersTo camssa:ee2a4de2-e1ad-4501-bf60-5db6da9e2df8 .

camssa:c3cda876-4785-486f-88f4-7ac8180f6cf4 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-26aeec3cf5b3b4879325e85fcd751d0c17f62c6c3113109fb100883a553ec0af ;
    cav:value "80" .

camssa:c3ce991e-331c-425b-846f-dfbf636b259e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Core Vocabularies can be used as the foundation of common export formats for data in base registries like cadastral, business registers or public service portals. The Core Location Vocabulary is a simplified, reusable and extensible data model that captures the fundamental characteristics of a location, represented as an address, a geographic name, or a geometry. By describing locations (addresses, geographical names, etc) in a common way using both human and machine-readable format, it allows the publication of information as open data for its consultation and reuse.\r
\r
Tim Berners-Lee 5-star schema for Open Data:\r
https://5stardata.info/en/\r
\r
CLV Joinup reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-location-vocabulary\r
\r
Use cases and benefits of ISA² specifications:\r
https://ec.europa.eu/isa2/sites/isa/files/docs/publications/isa2_study_use_cases_and_benefits_of_isa2_specifications_january_2019.pdf"""@en ;
    cav:refersTo camssa:3f992e92-6f35-4af0-b783-39eb739d5e85 .

camssa:c3d03432-2eb1-4efc-b03d-17bf365b2a79 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-c8a79448e829e27f47318879de4899c3a6404aa66d7d8954e7a680cf6e5d1ca2 ;
    cav:value "100" .

