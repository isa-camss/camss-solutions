camssa:badf5c8f-e115-4ba9-8acc-e80a073882f5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """OpenPM2 is a Project Management Methodology developed by the European Commission, it is focused on increasing project management capabilities. This is not strictly related to the publication of data as open data. \r
\r
Tim Berners-Lee 5-star schema for Open Data:\r
https://5stardata.info/en/\r
\r
OpenPM2 specification reference:\r
https://op.europa.eu/en/publication-detail/-/publication/ac3e118a-cb6e-11e8-9424-01aa75ed71a1/language-en/format-PDF/source-83307127"""@en ;
    cav:refersTo camssa:35602f1d-69ff-4ce3-9ffb-358f9081260c .

camssa:bae59ba6-de30-45bd-8e37-263038caf58e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of the Core Location Vocabulary is not related to organisational interoperability. Therefore, this criterion is not applicable to the specification. \r
\r
CLV Joinup reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-location-vocabulary"""@en ;
    cav:refersTo camssa:bc44420e-2d67-4744-a474-afee08e59a1d .

