        owl:NamedIndividual ;
    cav:assignedTo sc:c-ec3f8a897147f530040ab94fb9bbee9fdad56e7256b2ce6fbb63cf1465315d91 ;
    cav:value "80" .

camssa:6292387e-44d1-439c-b672-0c2dfaa954fb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "Due to the fact that the purpose of IPSec is to secure communications over the Internet Protocol (IP), IPSec is dependant from IPv4 and IPv6. However, IPSeC is designed for this area of application and IPv4 and IPv6 are widely used standards. Therefore, this dependency with specification for which IPSec has been developed, does not hamper interoperability."@en ;
    cav:refersTo camssa:2c849c1b-7a41-4828-bca5-5a928f6d457f .

camssa:6298f3d5-31e8-4906-8716-77cfa8410851 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """All Outputs packages have been published under the Creative Commons Attribution (CC-BY) licence. RDA’s IPR policy:\r
See: \r
 http://dx.doi.org/10.15497/DA8C2CC2-A7AF-4E3A-A4D6-C100E5C27492"""@en ;
    cav:refersTo camssa:6e05784c-791f-4726-bbe5-b2bcd52a7701 .

