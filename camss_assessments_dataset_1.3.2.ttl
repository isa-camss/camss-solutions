camssa:ecd5653e-4263-4fa7-836b-1969374706fb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The ebXML specification can be found in the UBL 2.1, which is a library of standard electronic business documents in XML (Extensible Markup Language) format that is free from copyright. UBL 2.1 operates within a standardised commercial framework, such as ISO 15000 (ebXML), providing a complete and standardised infrastructure.

ebXML UBL 2.1 eur-lex:
https://eur-lex.europa.eu/legal-content/ES/TXT/?uri=CELEX%3A32014D0771&qid=1743495780482

ebXML RegRep OASIS reference:
https://docs.oasis-open.org/regrep/regrep-core/v4.0/os/regrep-core-overview-v4.0-os.html'"""@en ;
    cav:refersTo camssa:c8b44c5d-0fbc-44d9-a74b-701683f9e411 .

camssa:ecd96de1-6053-4151-b917-2e04ba88fdef a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-ab118934e7af3d561b9036668a1de9f17c020207e8ebb0ed33d9405e12eeef4c ;
    cav:value "1" .

camssa:ecda22d4-0bc9-415d-b6b1-c048538a9abc a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of SVG is not related to the once-only principle. Therefore, this criterion is not applicable to the specification.\r
\r
SVG W3C reference: \r
https://www.w3.org/TR/SVG11/"""@en ;
    cav:refersTo camssa:f63f01b4-e63d-4dd2-91af-0478f70797f1 .

camssa:ecdc3a6b-43da-4ec5-aa29-b17ccea5415b a cav:Score,
        owl:NamedIndividual ;
