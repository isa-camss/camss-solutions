    cav:assignedTo sc:c-d9b9ce1d270550422a8ea6097d2ffa1d923267fd681c56280e3b7810a14a580a ;
    cav:value "20" .

camssa:da2cd78c-b745-4ffa-9c8c-bca768e8de3f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """XML is used to encode all communications between web services. Therefore, it fosters the visibility and comprehensibility of public administrations data and services. \r
\r
See:\r
https://esentool.ted.europa.eu/"""@en ;
    cav:refersTo camssa:9cfd6b23-1aed-4879-96b9-3ad4dd20e0a4 .

