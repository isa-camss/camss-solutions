        owl:NamedIndividual ;
    cav:judgement """SAMM is licensed under CC, which essentially means that the commercial use of the work and possible derivative works is allowed, the distribution of which must be done with a license equal to the one that regulates the original work.\r
\r
SAMM webpage:\r
https://owaspsamm.org/\r
\r
SAMM documentation: \r
https://github.com/OWASP/samm/blob/master/Supporting%20Resources/v2.0/OWASP-SAMM-v2.0.pdf """@en ;
    cav:refersTo camssa:dad48934-c7c9-4a32-8629-75663be5adfb .

