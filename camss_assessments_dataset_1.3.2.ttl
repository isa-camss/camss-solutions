camssa:4ba83aae-403c-4ed8-98dc-617100a63122 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'CPOV is designed to be extensible and customizable. Like the OSLO extension, Core Vocabularies allow you to create customized propertites or classes that are aligned with the unique requirements of organizations. Therefore, it is possible define custom properties or classes to capture the data we want.

OSLO extension for Core Vocabularies:
https://www.w3.org/2013/share-psi/workshop/berlin/EuropeanInteroperabilityTheISACoreVocabularies

CPOV custom:
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/core-public-organisation-vocabulary/distribution/core-public-organisation-vocabulary-version-100-pdf'"""@en ;
    cav:refersTo camssa:b22cdb36-6edb-48c0-8c44-2dc6d9aaf85a .

