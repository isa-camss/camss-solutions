camssa:abb6e09b-6712-4bf7-9cfc-dee9afde04cb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XBRL International has a special working group that maintains and develops the specification further. The\r
working group is open to direct members of XBRL International or its national jurisdictions.\r
\r
Links to the original source of information and/or references to working groups: \r
https://www.xbrl.org/the-consortium/join/ \r
\r
https://www.xbrl.org/the-consortium/members/working-group-enrollment/\r
'"""@en ;
    cav:refersTo camssa:56237449-5369-4a98-815d-9c0697f68823 .

