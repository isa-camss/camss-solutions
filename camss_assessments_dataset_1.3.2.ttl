camssa:3066bae7-d75d-4e5c-bcb9-02a05ca1c9cb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'GraphQL processes all data requests but only extensions (GraphQL-JS) or third APIs could be asked to resolve a response over an access control mechanism that ensures data confidentiality.\r
\r
GraphQL specification:\r
https://graphql.org/learn/schema/'"""@en ;
    cav:refersTo camssa:6867299d-0916-4ad5-ac32-cc37dbec5917 .

