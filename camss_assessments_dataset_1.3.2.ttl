camssa:856fa6ad-0629-4a68-be4f-439cc4f4c3d8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'One of the main advantages of this technique of dynamic attribute provisioning is that attribute revocation does not enforce certificate revocation and re-issuance. This means that information is provided once-only and reused as needed.\r
\r
DAPS: https://github.com/International-Data-Spaces-Association/IDS-G/tree/main/Components/IdentityProvider/DAPS'"""@en ;
    cav:refersTo camssa:61a88cc6-c044-46e6-a313-d7df3ceba694 .

