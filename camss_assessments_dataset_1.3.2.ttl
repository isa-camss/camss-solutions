        owl:NamedIndividual ;
    cav:assignedTo sc:c-d310596912dbc916997008f4aed16a81cf5e708cd907e3c53a2e4207468b468b ;
    cav:value "1" .

camssa:c8ef5245-7dc7-4908-a3b0-d58b2996e4aa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "'The specification does not explicitly address the protection of personal data managed by Public Administrations. Therefore, this criterion is not applicable to the specification.'"@en ;
    cav:refersTo camssa:6518e69c-4c5d-4eb3-8e79-cf5747b0e275 .

camssa:c8f520b9-60d6-4e25-8df6-40c74a385737 a cav:Score,
