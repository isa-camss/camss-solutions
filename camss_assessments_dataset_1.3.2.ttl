        owl:NamedIndividual ;
    cav:assignedTo sc:c-8eb17470327d32b3bb523447fe72ee5c60ddb03e81dae318b485fbe05f48a844 ;
    cav:value "0" .

camssa:08fccad9-d7de-406f-bcf1-f043b77b8806 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """After searching in the different official European websites, there is no evidence of any cross-border project that uses XAdES (ISO 14533-2:2012) nor explicit agreements involving the usage of the specification. However, the specification XAdES from ETSI, is involved in some cross-border projects as "Analysis of standards related to Trust Service Providers" developed by ENISA (European Union Agency for Network and Information Security) which is a centre of network and information security expertise for the EU, its member states, the private sector and Europe’s citizens. \r
\r
ENISA project:\r
https://www.enisa.europa.eu/publications/tsp_standards_2015/at_download/fullReport\r
\r
XAdES ISO reference:\r
https://www.iso.org/standard/56025.html\r
\r
XAdES ETSI reference:\r
https://www.etsi.org/deliver/etsi_ts/101900_101999/101903/01.04.02_60/ts_101903v010402p.pdf"""@en ;
    cav:refersTo camssa:e6f9e45e-72d7-4e04-80a8-56e1e108ee45 .

camssa:08ffc3a2-c961-4ca4-a795-d9d5e0cbaf51 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-e46f1a4a060cc7e143e32e4833c94af9164c37bc0d4c844bd1fa974ffb2ac225 ;
    cav:value "100" .

camssa:0903892c-e14a-4a61-b4f1-716ba2194c83 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "No evidence has been found of the specification being included in a formal interoperability agreement between organisations involved in the European public services provision."@en ;
    cav:refersTo camssa:1fafc528-0702-4c64-86cd-101dfd00bdd0 .

