camssa:1f0dcb24-06c9-44a9-b3ac-c08275a61bff a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"Conformance to ISO/IEC 19944 is only achieved if the clauses and vocabulary definitions are followed.  Nonetheless, there has not been found any tool or guideline with the purpose of conforming to the specification, nor is there a conformance statement within the specification's document.\r
\r
ISO/IEC 19944-1 specification:\r
https://www.iso.org/standard/60545.html\""""@en ;
    cav:refersTo camssa:1b95f2bc-392c-419f-add0-721c321ae654 .

