    cav:assignedTo sc:c-ab64f97c21ac8b84c75d6f52a89765b1c8fd1856d2d2060926d05e94f306a88d ;
    cav:value "1" .

camssa:0764e342-dc82-47a0-be74-2bad9d9495f2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISO/IEC 7498:1 does not explicitly address the authenticity and authentication of roles or agents involved in data transactions. Ensuring the authenticity and authentication is typically addressed at higher layers of the OSI model, such as the presentation layer, session layer, and application layer. 

ISO/IEC 7498:1: 
https://www.iso.org/standard/20269.html'"""@en ;
    cav:refersTo camssa:a49a8342-02f9-4e2f-9d32-dda60c1a88e7 .

