        owl:NamedIndividual ;
    cav:assignedTo sc:c-d2c939f8f97b2a02c254da4add5fcbea1311d465178344adc029d82366a0f642 ;
    cav:value "60" .

camssa:91ece145-39e2-4b2d-97c9-cc5dffeb2f89 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"There is no evidence of any study directly assessing the efficiency of the EN 303 645 specification. However, there are some organisations from the private sector, offering solutions based on the specification's performance with respect to the market, that indirectly assess the specification's efficiency. It is the case of TÜV SÜD, which offers testing against the EN 303 645 specification.\r
\r
TÜV SÜD-EN 303 645 reference:\r
https://www.tuvsud.com/en-us/industries/consumer-products-and-retail/iot-cybersecurity/\""""@en ;
    cav:refersTo camssa:bf55e608-6197-4236-818d-3d2a911f152c .

