    cav:assignedTo sc:c-a2e2820561158593079cf28230b73b9b7f1cb83da49b04d2317790e20c0c706f ;
    cav:value "80" .

camssa:dc2654dc-1e51-4ef3-a378-a758ffdcaf15 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'YAML is supported and developed by the YAML organization, and by the YAML Language Development Team. 
The development team is in charge of the YAML releases and updates, and also sets the terms of the RFC process. Moreover, in github there is published content to understand how the specification works, as well as tools to test YAML, among other things.

YAML Language Development Team:
https://yaml.org/spec/1.2.2/ext/team/'"""@en ;
    cav:refersTo camssa:64e6ce62-ee41-437a-837c-8a29a099a3ab .

