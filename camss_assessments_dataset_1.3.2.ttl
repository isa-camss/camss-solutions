        owl:NamedIndividual ;
    cav:assignedTo sc:c-a60f86e868fe2bdcf0c5c47111455d1d5b59498172688e36f23a77baa347d916 ;
    cav:value "60" .

camssa:69863478-d308-43a3-a0b2-92adbfce694d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISAE 3402 is focused on the preservation of confidential data and its availability. Therefore this criterion is not applicable to this specification.\r
\r
\r
ISAE 3402 handbook reference:\r
https://www.ifac.org/system/files/downloads/b014-2010-iaasb-handbook-isae-3402.pdf'"""@en ;
    cav:refersTo camssa:d0dcb220-5c7b-435e-a311-4105fee0d25b .

