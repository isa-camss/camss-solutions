camssa:ad6210ae-5143-4dbf-8329-9189900e0761 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The EIF is a set of recommendations and provides guidance to European public administrations. This\r
specification does not rely on any specific technology, and therefore is technology agnostic.\r
\r
EIF reference, 'EIF brochure' document:\r
https://ec.europa.eu/isa2/eif_en\""""@en ;
    cav:refersTo camssa:2eb9f50c-bc84-43fd-907d-d24b0b24e845 .

