        owl:NamedIndividual ;
    cav:assignedTo sc:c-3b3b2febe9a7e3ad44bdefc47b0bbcafc7a2e677e9570d6ad822efbe1f7d41e2 ;
    cav:value "100" .

camssa:34fa86e5-94d3-4aa4-800f-6f5092f50364 a cav:Score,
