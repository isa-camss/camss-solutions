        owl:NamedIndividual ;
    cav:judgement """'OAIS is recommended by the France Natioanl Catalogue of IT standards.\r
\r
France national catalogue of IT standards:\r
https://www.numerique.gouv.fr/uploads/Referentiel_General_Interoperabilite_V2.pdf\r
\r
OAIS specification:\r
https://public.ccsds.org/Pubs/650x0m2.pdf'"""@en ;
    cav:refersTo camssa:a176bc10-61fb-4441-9e1f-ce6c6e19dae9 .

