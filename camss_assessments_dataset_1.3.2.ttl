camssa:86b73d4e-6427-4494-8300-cf72d6f9d927 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Domibus Adherence to AS4 standard guarantees that messages exchanged through Domibus can be digitally signed, providing a mechanism to verify the authenticity and integrity of the data being transmitted. This helps ensure that messages originate from legitimate sources and have not been altered during transmission. Digital signatures contribute to data authenticity and help prevent tampering or unauthorized modifications.\r
\r
Domibus specification:\r
https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/Domibus\r
\r
AS4 specification:\r
http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/profiles/AS4-profile/v1.0/AS4-profile-v1.0.html'"""@en ;
    cav:refersTo camssa:483c2d1b-4620-4adf-bddc-dd7271f133da .

camssa:86bee0b3-908c-4fd5-80a5-9c54fa564616 a cav:Score,
