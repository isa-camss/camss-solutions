    cav:assignedTo sc:c-5879b43fc249f0098f3ed687235f432f71bf0c11bd3aa95e063dfdacd64606c8 ;
    cav:value "1" .

camssa:964973bb-2076-468b-8a55-89d8809343ab a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'GraphQL supports data manipulation using the mutation functionality, but cannot ensure its protection against unauthorised changes. Any mutation implying changes can be only prevented by the owner of the credential authenticating the API request.\r
\r
GraphQL specification:\r
https://graphql.org/learn/schema/'"""@en ;
    cav:refersTo camssa:05a73c73-4d8f-4457-a259-7c67929282eb .

