    cav:assignedTo sc:c-7d28663fdb5deb361d5ad773d7b7ece3c6acf8d2eb7a1222a60cb08df4c93aac ;
    cav:value "1" .

camssa:d148c3eb-67ed-438f-8b93-436dd7c625ec a cav:Score,
        owl:NamedIndividual ;
