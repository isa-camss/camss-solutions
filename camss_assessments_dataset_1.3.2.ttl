    cav:value "60" .

camssa:8d0ba369-53c2-4eb1-bac1-402d7114b9e2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """IPsec is used by the TESTA project, which provides a secure cross-border data communication network service for public administrations. EuroDomain, the  TESTA building block that allows data transfer and services between TESTA stakeholders, implements IPsec to enhance security settings in order to prevent eavesdropping and to enable encryption mechanisms. \r
\r
See: \r
https://ec.europa.eu/idabc/en/document/2097.html """@en ;
    cav:refersTo camssa:c5123792-ecb3-4c95-a0f3-485acfdc400d .

camssa:8d0ba409-b811-4e44-8c32-0b88806dbdad a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-cf1de0bf03a8ee372af0deddf9ef5c4609f5a7bb9c7e001c89d887c6789eaf56 ;
    cav:value "1" .

camssa:8d0c81b3-6d25-4684-885a-0083f2a0c2d5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"XSD 1.1 is supporting the second level of maturity of Tim Berners-Lee's 5-stars schema for open data. It eases the availability of the data and structures XML files. Additionally, XSD 1.1 is implied within the RDF 1.1 XML Syntax, used for the serialisation of RDF documents as XML. Therefore, XSD fosters the publication of data as Linked Open Data. \r
\r
Moreover, although XSD is not related directly with Open Vocabularies, it can be found included within the Linked Open Vocabularies. It is possible because datatypes defined by XSD are commonly used as rdfs:range by properties. \r
\r
Tim Berners-Lee 5-star schema for Open Data:\r
https://5stardata.info/en\r
\r
RDF Syntax Grammar Reference:\r
https://www.w3.org/TR/rdf-syntax-grammar/\r
\r
XSD Reference:\r
https://www.w3.org/TR/2012/REC-xmlschema11-1-20120405/\""""@en ;
    cav:refersTo camssa:0d99f471-61a4-4459-9a45-c56477d4c4bd .

camssa:8d129b55-89e8-4430-9cca-cb8d695157d3 a cav:Score,
