camssa:74e7466d-48f1-4e9a-b63c-273013d97364 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "HTML5 foster e-accessibility through improving accessibility of web and mobile web applications, digital signs, ebooks and devices not yet known for people with disabilities."@en ;
    cav:refersTo camssa:1788e821-439e-4b84-a7c6-06e6235ab000 .

