    cav:value "100" .

camssa:72099e0a-be68-45f8-baac-7c6c3118aec2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Like all the IETF standards, this specification is a free and open technical specification, built on IETF standards and licenses from the Open Web Foundation. Therefore it is licensed on a royalty-free basis.
No IPR disclosures have been submitted directly on this RFC.

Intellectual Property Rights in IETF:
https://tools.ietf.org/doc/html/rfc8179'"""@en ;
    cav:refersTo camssa:36b42833-de9c-4ecf-a83b-210aee56da65 .

camssa:7216a7f0-1d73-4be6-9064-6053d669c04c a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-8c09094de9d71f12686896827a205db683b6df58fa363bc5be2a7d99989e7dd0 ;
    cav:value "1" .

camssa:721814f8-df63-4021-9ec8-180254f863c1 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Open telemetry is an open source project where anyone interested can participate and get involved in its development. There is a mailing list communicating updates, and community meetings are held regularly. Moreover, there are special interest groups (SIGs) for specific contributions to the project.

OpenTelemetry Community Content: https://github.com/open-telemetry/community'"""@en ;
    cav:refersTo camssa:831864fc-814d-42d4-aff9-7fd6f2c8ae2d .

camssa:721912b6-4787-470c-be13-14293d0a53b4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'TSP is mentioned at "Commision decision of 25 February 2011 establishing minimum requirements for the cross-border processing of documents signed electronically by competent authorities under Directive 2006/123/EC of the European Parliament and of the Council on services in the internal market". In this document it is metioned that States should implement technical means which support signed documents in BES or EPES format. One of the technical means mentioned is TSP.

Commision decision referene: 
https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32011D0130&qid=1714025936203#ntc6-L_2011053ES.01006801-E0006 '"""@en ;
    cav:refersTo camssa:077dc960-0198-4551-b36e-80d91c592324 .

camssa:721acc2b-ef34-4835-ac6e-8646718cbb9e a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-450e8a1f4cffbbf3de202e37bd642f098174559028df90ccc657473a6086bc0b ;
    cav:value "2" .

camssa:7224dafa-2501-4743-92f6-b3c24e4c29da a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d2c939f8f97b2a02c254da4add5fcbea1311d465178344adc029d82366a0f642 ;
    cav:value "100" .

camssa:72273e6a-0cfb-4c37-84cc-c9815be9150d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Domibus is primarily an open-source software solution for secure electronic message exchange, and it adheres to messaging standards such as the AS4 (Applicability Statement 4) profile of the ebMS (ebXML Messaging Service) standard. While it may not be listed in an official national catalogue or standards repository, it is widely recognized and used within the context of eGovernment initiatives and secure data exchange in Europe.\r
\r
Domibus specification:\r
https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/Domibus\r
\r
AS4 Profile of ebMS 3.0:\r
http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/profiles/AS4-profile/v1.0/AS4-profile-v1.0.html'"""@en ;
    cav:refersTo camssa:987d3f3a-9e61-4a78-a6e1-cddac2158159 .

camssa:7228d590-14d1-4f76-9ad7-adec12ab224a a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-7d12b846c487e7201dbcf395866b5abc0bb5fa040b1f519127b6a5f56d447257 ;
    cav:value "80" .

