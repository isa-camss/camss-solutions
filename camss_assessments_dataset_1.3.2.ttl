camssa:0c0d96c3-a1fb-4785-b153-689671747df4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ETSI TS 119 512 does not rely on any specific platform.  \r
\r
ETSI TS 119 512 specification:\r
https://www.etsi.org/deliver/etsi_ts/119500_119599/119512/01.01.02_60/ts_119512v010102p.pdf'"""@en ;
    cav:refersTo camssa:5ca9df21-1168-4209-a1fa-ec4ba70dab50 .

camssa:0c11e6c0-31a1-4504-ae53-db4f6ce57ae2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of the specification is to facilitate the exchange of structured data. By allowing to make the data available to other persons or organisations, this Core Vocabulary reduces the administrative burden.\r
\r
CCCEV reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-criterion-and-core-evidence-vocabulary"""@en ;
    cav:refersTo camssa:75231df5-fea5-4b66-a45b-d202405606a4 .

camssa:0c252495-f2c1-415d-ac07-9d8c61c0d57d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'UTF-8 encoding can enable data processing accuracy by ensuring that characters from a wide range of scripts are correctly represented and processed.\r
\r
UTF-8 specification:\r
https://datatracker.ietf.org/doc/html/rfc3629\r
'"""@en ;
    cav:refersTo camssa:0fa6d6d6-e302-4719-ae1d-fe44ec3cd9e7 .

