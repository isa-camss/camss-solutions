camssa:ea1d24e3-795f-43c2-bf74-15dc4f386dfd a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Data protection encompasses data confidentiality, integrity and access control. TOSCA does not impose the use of any specific mechanism or technology for security considerations; security aspects should be obtainable by the user infrastructure.\r
\r
TOSCA reference, TOSCA normative type definitions section:\r
https://docs.oasis-open.org/tosca/TOSCA-Simple-Profile-YAML/v1.3/os/TOSCA-Simple-Profile-YAML-v1.3-os.html#_Toc26969462'"""@en ;
    cav:refersTo camssa:261d01ee-971f-4c7b-88ea-c19cc78dc526 .

