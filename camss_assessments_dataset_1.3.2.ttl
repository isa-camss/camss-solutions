    cav:value "1" .

camssa:b9c359e8-eda9-49ea-8651-a3a85e4a9916 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'DNS over HTTPS (DoH) is maintained by the Internet Engineering Task Force (IETF). The development and maintenance of DoH is carried out within the Internet Engineering Steering Group (IESG), who is responsible for technical management of IETF activities and the Internet standards process. Furthermore, there is a section in the RFC Editor where any user can report doubts or comments regarding RFC 8484.
 
IESG IETF: https://www.ietf.org/about/groups/iesg/

RFC 8484 Editor Errata: https://www.rfc-editor.org/errata/rfc8484'"""@en ;
    cav:refersTo camssa:fbefae44-05f1-451d-969a-a0430b73b4d1 .

camssa:b9c7e51b-95fa-47ab-872a-2f172a93d4c0 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The W3C Royalty-Free IPR licenses granted under the W3C Patent Policy apply to all W3C specifications, including ODRL.\r
\r
W3C patent practice: \r
https://www.w3.org/TR/patent-practice#ref-AC """@en ;
    cav:refersTo camssa:c02d6dd5-48d0-4888-9abf-b74eed2fc355 .

camssa:b9cc594f-db21-4d76-9f43-a80fd7a416b7 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-21276471c1781fa2c7e78c8e03851e076b840beddbf5cf64f53b54b8855a01b8 ;
    cav:value "1" .

camssa:b9d2aee6-7c83-4d5d-a283-74d83c7d4bb7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The specification is not recommended by any Member State within their national catalogues for ICT. Despite this, eDelivery SMP 1.10 is a European profile recommended by the European public bodies in order to establish a common interoperability framework."@en ;
    cav:refersTo camssa:7dcc63a4-9e47-4499-8e96-f1b9ca07d651 .

camssa:b9d7027e-ff56-44c0-9357-ba2f3554f377 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "'The XML specification itself does not provide explicit means for the restriction of access to information or data. XML is primarily focused on defining the structure and syntax of markup language documents.Therefore this criterion is not applicable to the specification.'"@en ;
    cav:refersTo camssa:c777fc59-965f-4f31-bfcf-ea6a5bd275c3 .

camssa:b9d7f3dd-ec47-4621-9c29-f283ac7737f5 a cav:Score,
