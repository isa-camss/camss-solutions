    cav:assignedTo sc:c-9420538a5a92af199b492414dd056ab7134e456f005895261b1a5b15a3f2814e ;
    cav:value "100" .

camssa:aefbafd2-3faf-45e8-9d07-e6dbb0e62752 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Whenever the user intends to use or reuse the CSV specification, information needs to be provided every time.                                         \r
\r
CSV reference:\r
https://datatracker.ietf.org/doc/html/rfc4180'"""@en ;
    cav:refersTo camssa:eddc033f-8692-4e0f-962f-b90a93d890bb .

camssa:af01b519-4e19-4fd6-b119-145a758eae96 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3beae22dd24b0dbc955ce74a9fe755390983d8436a45b401461ceaaa7a5d1609 ;
    cav:value "100" .

camssa:af059a77-c311-4516-be3e-c696446d2b45 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """By helping administrations to access and reuse information across borders, the implementation of HTML4 and other standards from HTML family can help to foster and ease the Once-Only Principle.\r
\r
HTML W3C reference:\r
https://www.w3.org/TR/html401/"""@en ;
    cav:refersTo camssa:8792ab46-de79-4063-8dd2-488760ee4d08 .

camssa:af099020-24d0-4411-acf5-f301d7d4aacf a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3b3b2febe9a7e3ad44bdefc47b0bbcafc7a2e677e9570d6ad822efbe1f7d41e2 ;
    cav:value "20" .

camssa:af12fd79-5eed-4985-a290-138b05f0dbd6 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-5b29a4581c52656a3bcf08224b259c29610cb540c56af4512ebe0ded3adeeac1 ;
    cav:value "1" .

camssa:af13bff4-9f01-4e7e-9923-3678505b630f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The INSPIRE (Infrastructure for Spatial Information in the European Community) project partly relies on the ISO 3166-1 specification (see INSPIRE Data Specification on Administrative Units reference). INSPIRE is a key delivery agent of European public services which addresses the exchange, sharing, access and use of interoperable spatial data and spatial data services at different levels of public authority and in different sectors. Therefore, the specification may contribute to simplify the delivery of European public services.\r
\r
ISO 3166-1 reference:\r
https://www.iso.org/standard/72482.html\r
\r
INSPIRE Data Specification on Administrative Units reference:\r
https://inspire.ec.europa.eu/id/document/tg/au\r
\r
INSPIRE reference, Directive 2007/2/EC document, Article 1:\r
https://inspire.ec.europa.eu/inspire-legislation/26'"""@en ;
    cav:refersTo camssa:c06f6f47-b2ae-45f9-84e4-4fd039d7395d .

camssa:af15761d-798f-43ad-88e7-c10a93a94074 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'As REST is an architectural style, it is designed to be implemented in any platform, and does not rely on any other standard or specification.\r
\r
REST reference:\r
https://restfulapi.net/rest-architectural-constraints/'"""@en ;
    cav:refersTo camssa:79555264-4eb8-4f24-8fd7-7da143eadc4a .

camssa:af201d35-9c3b-4421-858a-79bc3e087934 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a16c678a586cf542d2ae1d6cd8a987bd6ed0b2af52ba0e04d8872fe616a9b7bd ;
    cav:value "100" .

camssa:af270b14-284e-4f81-badc-530cd37f6d78 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The W3C Royalty-Free IPR licenses granted under the W3C Patent Policy apply to all W3C specifications, including this specification.\r
\r
W3C Patent practice:\r
https://www.w3.org/TR/patent-practice#ref-AC'"""@en ;
    cav:refersTo camssa:c3689721-a5a7-4a3c-a987-72b7d03e7493 .

camssa:af2b18e8-8548-4117-918d-edb6a8e327b4 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-39e7870e79b2999a8b61c97f0c356312b88174320d6464fce5639e57ec0de011 ;
    cav:value "1" .

camssa:af2d2392-b33d-4855-a8be-0e78eb244523 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The NFVI specification is composed of different virtualised resources that activates depending on the task (see NFVI Deliver, section 6.4.2.1). Therefore, the NFVI specification can be implemented partially. \r
\r
NFVI Deliver, Infrastructure Overview: \r
https://www.etsi.org/deliver/etsi_gs/NFV-INF/001_099/001/01.01.01_60/'"""@en ;
    cav:refersTo camssa:c180ff2c-66db-47c6-8d11-a123d3b115b7 .

