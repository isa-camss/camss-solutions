camssa:f67d2bd5-0bcf-4f49-8e5e-8371c007dd7c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'EN 303 645 is a set of security best practices for Internet-connected consumer devices and is intended to support all parties involved in the development and manufacture of consumer IoT devices. The specification is not intended to depend on any particular specification, and therefore is platform-agnostic.\r
\r
EN 303 645 reference:\r
https://www.etsi.org/deliver/etsi_en/303600_303699/303645/02.01.01_60/en_303645v020101p.pdf'"""@en ;
    cav:refersTo camssa:daa65e7d-766c-436c-a431-bbbd5732c478 .

