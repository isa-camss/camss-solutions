        owl:NamedIndividual ;
    cav:assignedTo sc:c-ec3f8a897147f530040ab94fb9bbee9fdad56e7256b2ce6fbb63cf1465315d91 ;
    cav:value "100"^^xsd:string .

camssa:3c6c1f8a-f4da-4f32-96a7-a8678c57cb02 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-5a7323988b5d96da801e2abd4d95248af758fe9adbbafd09dd76114629567ff4 ;
    cav:value "80"^^xsd:string .

