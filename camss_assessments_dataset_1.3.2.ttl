camssa:02f38f85-5155-4638-8dee-9ee74e9b2864 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification can use extension as it is explained in the specification reference. As an example it can use DCAT-AP which is an aplication profile that works as an extension of the own specification.                                                                        \r
\r
DCAT (v2.0.0) reference:             \r
https://www.w3.org/TR/vocab-dcat-2/             \r
\r
DCAT-AP & European Data Portals reference:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe     '"""@en ;
    cav:refersTo camssa:4b5fa582-ffff-44ed-abce-3aa3264fa67a .

camssa:02f56637-8829-4e8c-8209-6cc9f736469a a cav:Score,
