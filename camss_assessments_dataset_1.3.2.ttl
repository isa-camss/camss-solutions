    cav:assignedTo sc:c-a6184fb705cfed44856c7b9594b492926f7a63a128a5a2be7b896294d8c79838 ;
    cav:value "100" .

camssa:d921be6c-aa62-45fd-ad8e-fe43d304902c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of ETSI EN 319 422 is not related to multilingualism. Therefore this criterion is not \r
applicable to this specification.\r
\r
ETSI EN 319 422 reference:\r
https://www.etsi.org/deliver/etsi_en/319400_319499/319422/01.01.01_60/en_319422v010101p.pdf'"""@en ;
    cav:refersTo camssa:96291ce9-c25f-44f8-996e-2e9179d29366 .

camssa:d921feb8-3f32-4c21-8bab-b87d3e1fcf0a a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-549e39fc635763b9466e09688714b2908fcf7a349d4f4f0fe2a761bd6f502733 ;
    cav:value "100" .

camssa:d92317cd-fc9b-40e4-8aa8-4d15487454aa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "'The purpose of XML is not related to the  delivery of multilingual public services. Therefore, this criterion is not applicable to the specification.'"@en ;
    cav:refersTo camssa:1b4e59f4-d3f5-452f-951a-bf292a0afc49 .

camssa:d9264280-744b-46ca-8925-abe62261362e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of UTF-8 is not related to long-term preservation of electronic records. Therefore this criterion is considered not applicable to this specification.\r
\r
UTF-8 specification:\r
https://datatracker.ietf.org/doc/html/rfc3629'"""@en ;
    cav:refersTo camssa:9cec07bc-febf-4b0e-a413-878ec527da19 .

camssa:d928cc6e-c848-4c5f-acca-c2baa0b8fca2 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-cd828c0ec9887027bdb6b981560bde593cda27c080298ab36323ba5441ba4c31 ;
    cav:value "100" .

camssa:d9381022-8ea5-47b3-b251-6b6644a3961c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The specification can be used on any operating system and hardware platform."@en ;
    cav:refersTo camssa:259b9990-0a0a-4eb4-8a86-0d0545dbd0cc .

camssa:d93954df-9858-4b82-b396-54a9b5b01bca a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
    cav:value "100" .

camssa:d93d1c7e-f3ed-45c7-8568-6fb85feb11c9 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-39ffef052c31580b50b418f3991e9de7db4dc182fcf96f5a447d7f8e09560612 ;
    cav:value "1" .

camssa:d9406423-4f52-4e6f-a3c4-de3fd27f446a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"ebXML provides a set of components enabling users (data users) to store and work with any type of electronic content, fostering the visibility of administrations. As well as providing an electronic data interchange model (that is, the ebRIM and the ebRS core components), the specification contributes and promotes to some degree to the visibility of public services' implementations (see ebXML reference, Conformance section). For instance, there is the ESPD-EDM on EU procurement, which relies on the Universal Business Language (UBL) mark-up language and facilitates the promotion and support of the ESPD service.\r
\r
ebXML reference, Conformance section:\r
http://docs.oasis-open.org/regrep/regrep-core/v4.0/os/regrep-core-overview-v4.0-os.\r
html#__RefHeading__53396_365468741\r
\r
ESPD-EDM ebXML reference:\r
https://docs.ted.europa.eu/ESPD-EDM/3.0.1/xml_technical_handbook.html#_adoption_of_ubl_2_3\""""@en ;
    cav:refersTo camssa:44e75505-a470-4ccf-8270-1f7d7d3cfb2f .

camssa:d94289e5-9ac0-4714-9fb3-2cf42a835444 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """ODRL is a specification that provides a core vocabulary that allows the description and representation of information in a standardised and machine-readable format fostering the data exchange and the interoperability of organisations and resources using it. \r
\r
An example of its potential use on the publication and exchange of open data is the inclusion within SPECIAL, an H2020 European Project that stands for "Scalable Policy-awarE Linked Data arChitecture for prIvacy, trAnsparency and compLiance". This project aims to provide solutions for data protection and its reuse using standards to allow maximum applicability and interoperability across borders. \r
\r
Moreover, the specification offers serialisation in common formats for open data publication and shareability such as RDF or JASON-LD. \r
\r
W3C specification reference: \r
https://www.w3.org/TR/odrl-vocab/#vocab-core \r
\r
SPECIAL Deliverable: \r
https://www.specialprivacy.eu/images/documents/SPECIAL_D17_M17_V10.pdf"""@en ;
    cav:refersTo camssa:9b80e130-ea0c-4046-ae25-9573d6221970 .

camssa:d944ef0e-826d-494f-9988-f3331ed92308 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'At the moment of performing the assessment, the specification is not included in a catalogue of standards at EU level. \r
\r
XSD Reference: \r
https://www.w3.org/TR/2012/REC-xmlschema11-1-20120405/'"""@en ;
    cav:refersTo camssa:0ea190ef-bff4-45a7-854a-690ce4c95ea8 .

camssa:d9459d39-cbe4-4fd9-9061-d3d3c52c00d9 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-9c03a344765a6b8da57c4a7d40647791b737e3e1feecc14e3d59f2c69bdb246b ;
    cav:value "100" .

camssa:d9475b4f-efac-4d4c-92b1-5326e53246f9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The purpose of IPv6 is not related to  e-accessibility. Therefore this criterion is considered not applicable specification."@en ;
    cav:refersTo camssa:8954df19-41c1-423d-88d8-817bef9766ba .

camssa:d94b7606-ec72-4e4a-9ca3-ab2618184b5e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Data Privacy Vocabularies and Controls Community Group (DPVCG) is in charge of mantaining and developing the DPV, it is a fairly open group that welcomes participation regarding extensions and refinement of terms.\r
\r
DPV specification: \r
https://w3c.github.io/dpv/dpv/\r
\r
DPV primer document:\r
https://w3c.github.io/dpv/primer/#introduction'"""@en ;
    cav:refersTo camssa:5a97e237-47c2-443c-9b13-815fb3343003 .

camssa:d95a0710-7b15-4e51-9bf8-16719b260b4b a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
    cav:value "100" .

camssa:d9612430-b0bd-4c80-9bd3-f8a0220cef6a a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-cc272cd8a2e3e9c5e4edaa5ac7d59735c377a9db89d6958335a2cf0538761ab3 ;
    cav:value "100" .

camssa:d9659057-df50-4494-8763-55f69e72bb64 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'NUTS provides a statistical specification to address the needs for data harmonisation in terms of conducting surveys, applying policies and comparing data across the European Union. The specification should not be confused with the Administrative Territorial Unit (ATU) which is another specification representing the subdivisions of a country, mainly focuses on administrative purposes.\r
\r
EC reference, Regulation (EC) No 1059/2003 document:\r
https://eur-lex.europa.eu/legal-content/EN/TXT/?qid=1405939838475&uri=CELEX:32003R1059\r
\r
ATU-Joinup reference, About Administrative territorial unit type:\r
https://joinup.ec.europa.eu/collection/eu-semantic-interoperability-catalogue/solution/administrative-territorialunit-type/about'"""@en ;
    cav:refersTo camssa:ba7e335a-148a-49d2-a2ce-124d514c3a9c .

