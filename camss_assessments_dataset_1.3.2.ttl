    cav:value "2" .

camssa:64bc370a-9ef7-410b-921e-8a488b6c08e7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are several existing documents and studies assessing SAML 2.0 features and capabilities and efficiency. Broadly speaking, the studies are focused on the capability to enable Single Sign-on and its benefits. \r
\r
Researchgate analysis on SAML2.0 Reference:\r
https://www.researchgate.net/publication/221609828_Formal_analysis_of_SAML_20_web_browser_single_sign-on\r
\r
Researchgate on Single Sign-on Auth Reference:\r
https://www.researchgate.net/publication/45872317_Web_single_sign-on_authentication_using_SAML'"""@en ;
    cav:refersTo camssa:fb87d227-3c21-400d-95df-d6958fdc396f .

