    cav:value "100" .

camssa:5e806eb7-2b7b-4322-ad9f-217db312e1db a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "TLS 1.3 provides secure internet connections, with the aim of secure data exchange between internet systems (such as websites or mail servers). The Enterprise Transport Security (ETS) technical specification from ETSI also works in that area, but does not cover the same level of security, it does not have the exact same application area."@en ;
    cav:refersTo camssa:2808676c-da0a-4467-a6a3-25c47ae3a181 .

