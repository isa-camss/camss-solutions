        owl:NamedIndividual ;
    cav:assignedTo sc:c-a2e2820561158593079cf28230b73b9b7f1cb83da49b04d2317790e20c0c706f ;
    cav:value "100" .

camssa:ecc0ef6e-2de3-447b-aaea-e8300d5a5472 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-31bf959b6c4a983ec70eb87e0177f2739575ebce42c7c3b95b9012ef3bfe673e ;
    cav:value "1" .

camssa:ecc2a478-7d05-4778-98df-d0e14a3753b1 a cav:Statement,
        owl:NamedIndividual ;
