        owl:NamedIndividual ;
    cav:judgement "The purpose of IPv6 is not related  to the modelling of business processes. Therefore, this criterion is not applicable to the specification."@en ;
    cav:refersTo camssa:cfd494fd-2d68-4b5a-a320-d65edfc24bc3 .

