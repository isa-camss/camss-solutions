    cav:refersTo camssa:36441853-8a94-4ca6-b344-bb21b4c0843f .

camssa:8ec956ff-82dd-4ffb-8cbc-e482b693ef71 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """" LDES can be interpreted as a publishing strategy by which a data provider allows multiple third parties to stay in sync with the latest version of the data source in a resource and cost-effective manner. Thanks to this specification, the exposure of interfaces to access the public administration's services would improve.

LDES specification: 
https://joinup.ec.europa.eu/collection/semic-support-centre/linked-data-event-streams-ldes\""""@en ;
    cav:refersTo camssa:d694c730-201b-4181-8135-66e6a7199575 .

camssa:8eca5826-d288-499f-93e4-519824aba33a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISO 19941 is not included in any national catalogue of recommended specifications whose Member State NIF has a high performance on interoperability according to NIFO factsheets.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss\r
/camss-list-standards'"""@en ;
    cav:refersTo camssa:a13cf768-3e09-463e-9e86-787937f105a3 .

