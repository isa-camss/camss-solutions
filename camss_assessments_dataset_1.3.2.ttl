    cav:assignedTo sc:c-53abe85b1365f86aa58a25566e54e082ea2d70ee8d9fbaf09ccab20af30f3332 ;
    cav:value "1" .

camssa:4540c885-5747-4b38-8b9a-9cac7b09e0d7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """XAdES (ISO 14533-2:2012) is an ISO standard and as all ISO standards, they have to be paid to access its content. However, it can be checked out in ETSI website where the content is aligned with the ISO standard.  \r
\r
XAdES ISO reference:\r
https://www.iso.org/standard/56025.html\r
\r
XAdES ETSI reference:\r
https://www.etsi.org/deliver/etsi_ts/101900_101999/101903/01.04.02_60/ts_101903v010402p.pdf"""@en ;
    cav:refersTo camssa:0b67bc28-b942-4ba6-92af-763e50f72dac .

camssa:454728f0-c73e-4783-be14-43bd4b8117eb a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-497a81dae06c1d53b4cfe96c1f998f6f65d46354d68a83d29a2950c984fc1166 ;
    cav:value "100" .

camssa:45479c63-b8cb-43d5-9698-ac95ce84a2ec a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"Section 5 of the specification about confidentiality, security and integrity expresses that the SCASC shall guarantee the integrity and confidentiality of the received information. For instance, in remote signing services with SCAL1 (Section 5.3), the signing key's confidentiality and integrity are ensured by the SCDev that can be activated by the SSASC. Such activation can remain for a given period and/or for a given number of signatures.

ETSI TS 119 432: https://www.etsi.org/deliver/etsi_ts/119400_119499/119432/01.02.01_60/ts_119432v010201p.pdf\""""@en ;
    cav:refersTo camssa:c29d3689-d557-41fe-accd-cbe25975de1b .

camssa:45484305-405d-4296-b4c7-6c0cdd0b5446 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-5a7323988b5d96da801e2abd4d95248af758fe9adbbafd09dd76114629567ff4 ;
    cav:value "60" .

camssa:454ea308-4e0c-4c76-9533-2f007b64750b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are extensions avilable for RFC3161. One of the extensions is ANSI X9.95, which specifies the minimum security requirements for the effective use of time stamps in a financial services environment. 

ANSI X9.95 reference:
https://webstore.ansi.org/standards/ascx9/ansix9952022'"""@en ;
    cav:refersTo camssa:afd83515-500a-4e48-9fc5-ebfe476c7cf6 .

