    cav:assignedTo sc:c-497a81dae06c1d53b4cfe96c1f998f6f65d46354d68a83d29a2950c984fc1166 ;
    cav:value "100" .

camssa:6b983e73-70e1-4cd4-ab83-08d7ea04a96d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The purpose of Core Location Vocabulary is not related to enabling the exposure of interfaces to access the public administration's services. Therefore this criterion is not applicable to the specification.

Core Location Vocabulary:
https://interoperable-europe.ec.europa.eu/collection/semic-support-centre/solution/core-location-vocabulary/release/100\""""@en ;
    cav:refersTo camssa:21f72d43-34bd-42bd-a1a1-9f4ae6820aaf .

