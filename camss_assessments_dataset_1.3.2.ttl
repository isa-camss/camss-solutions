        owl:NamedIndividual ;
    cav:assignedTo sc:c-549e39fc635763b9466e09688714b2908fcf7a349d4f4f0fe2a761bd6f502733 ;
    cav:value "20" .

camssa:e529afad-cea4-4fd2-a25a-adfeb076464e a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-17a2b7a0ca372f407c300b69049faf9d92cbf274964290ba278b18cf10bf5dbf ;
    cav:value "20" .

camssa:e52ba5bf-b62d-40aa-9698-b2a447905c50 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'While ISO/IEC 19944-1 does not specifically address data processing accuracy, it provides a foundation for organizations to establish data governance practices and security controls that indirectly contribute to accurate data processing. Organizations should complement ISO/IEC 19944-1 with additional best practices and standards to ensure data processing accuracy according to their specific requirements.\r
\r
ISO/IEC 19944-1 specification:\r
https://www.iso.org/standard/60545.html'"""@en ;
    cav:refersTo camssa:7dd34705-9a20-4590-9aa0-55097c6efe81 .

camssa:e52e03b7-c6ae-4aa0-81f8-21b0ca21104c a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-8c09094de9d71f12686896827a205db683b6df58fa363bc5be2a7d99989e7dd0 ;
    cav:value "1" .

