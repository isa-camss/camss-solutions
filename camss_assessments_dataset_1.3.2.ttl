    cav:assignedTo sc:c-7a18abe4842e04b608025fd70e54c3db5c2a10130c0dab0495479e7d5effb55d ;
    cav:value "0" .

camssa:356ad75f-c40c-42a3-ada9-2757eee89216 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Being a software architectural style based on http methods, REST principles can be applied in any case, and therefore, is a resource not subject to royalties or any kind of propietary restrictions.\r
\r
REST reference:\r
https://restfulapi.net/\r
'"""@en ;
    cav:refersTo camssa:7cab2d45-7b29-439f-b916-45da8b424fc7 .

