camssa:b1f08565-86fa-49c8-a5f0-fc7ddb8e6596 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are several CSV conformance validators available. An example is CSV Lint, which provides a conformance validation for its readability. Another example is CSV Validator from The National Archive of United Kingdom, or the TestBed validator. This validator provides tools for validating CSV by using CSV Schema. \r
\r
CSV Lint and CSV Validator References:\r
https://csvlint.io/\r
https://github.com/digital-preservation/csv-validator\r
\r
TestBed CSV validator Reference:\r
https://joinup.ec.europa.eu/collection/interoperability-test-bed-repository/solution/csvvalidator/about\r
\r
CSV reference:\r
https://datatracker.ietf.org/doc/html/rfc4180'"""@en ;
    cav:refersTo camssa:d7623927-0f67-4c28-82f9-49ac256115ca .

camssa:b1f6ecbe-a64e-4bc9-b78a-2ce79af24b6f a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-73a8058bec757a2fdb0f8513c2f11841e982cbef76c3be82af67707c294da8b8 ;
    cav:value "2" .

