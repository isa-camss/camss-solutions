        owl:NamedIndividual ;
    cav:value "100%StrengthOfAssessmentScoreAverage"^^xsd:string,
        "94.59%AssessmentScoreAverage"^^xsd:string .

camssa:729d19d2-fd39-4acd-9a41-cc96c21ffa74 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3beae22dd24b0dbc955ce74a9fe755390983d8436a45b401461ceaaa7a5d1609 ;
    cav:value "100"^^xsd:string .

camssa:76b55f93-a150-424b-948e-8487397f40a9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OIDC consists of a core specification and a set of optional features, allowing implementers to adopt the core components first and selectively add additional modules to meet their specific system requirements. For example, optional features include support for dynamic client registration, session management, single logout, token introspection, and advanced security profiles, which can be adopted as needed depending on the desired level of functionality and assurance._x000D_
_x000D_
OpenID Connect specification reference:_x000D_
https://openid.net/specs/openid-connect-core-1_0.html_x000D_
_x000D_
OpenID Connect specifications reference:_x000D_
https://openid.net/developers/specs/'"""@en ;
    cav:refersTo camssa:84257923-5f91-40fd-ba3e-ac62506e3874 .

camssa:78d8d0af-9e26-42a6-ad6a-aa45e83d3da8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OIDC enables identity portability but is not a mechanism for data portability, as it does not handle the export or transfer of a user’s full personal data between services. _x000D_
_x000D_
OpenID Connect specification reference:_x000D_
https://openid.net/specs/openid-connect-core-1_0.html'"""@en ;
    cav:refersTo camssa:44fac218-c120-422c-80b2-a11f34cadd63 .

camssa:7af9f340-3385-4f51-803a-738b7d90e29c a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-fb2c0a4ddb03b09ecd5450c5a1d6aeed4e51c2a0387709a95a89cd850a7dd180 ;
    cav:value "100"^^xsd:string .

camssa:7cb391d4-ce8b-4f81-93cf-33cf2a867b5d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OIDC provides an access control mechanism for identity data during authentication by leveraging OAuth 2.0 tokens, scopes, and user consent. These mechanisms allow relying parties to request only the information necessary for a given transaction, while giving users control over what data is shared. However, OIDC’s access control is limited to authentication and authorisation flows and does not govern how applications handle, store, or further process the data once it has been received._x000D_
_x000D_
OpenID Connect specification reference:_x000D_
https://openid.net/specs/openid-connect-core-1_0.html'"""@en ;
    cav:refersTo camssa:f3b8693f-0d96-4fb5-9b06-8b49ad99e13c .

