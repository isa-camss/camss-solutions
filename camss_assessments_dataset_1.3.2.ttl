    cav:value "100" .

camssa:74dbda7c-e6e7-409f-a3f6-10a83a04f035 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of this specification is not related to providing an access control mechanism. Therefore, this criterion is not applicable to this specification.

LDES specification: 
https://joinup.ec.europa.eu/collection/semic-support-centre/linked-data-event-streams-ldes'"""@en ;
    cav:refersTo camssa:cb51ee97-6244-43ae-84a1-c096d19f02c6 .

camssa:74ddf695-141d-4237-bb43-6b6f6ed3e08f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "Consensus is a foundation upon which the Alliance is built and all processes and procedures, particularly in connection to the focus, work plans, deliverables, milestones and tangible specifications / recommendations are consensus based."@en ;
    cav:refersTo camssa:e272ea59-67d5-4824-9d6d-b8d6da269e5b .

