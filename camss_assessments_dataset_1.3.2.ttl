    cav:assignedTo sc:c-a2e2820561158593079cf28230b73b9b7f1cb83da49b04d2317790e20c0c706f ;
    cav:value "100" .

camssa:7a6e4fce-7ef9-437a-a031-d2c51e288249 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"Schema.org was founded by big tech companies and its use is widespread in the major search engines like Google or Yahoo! (see Schema.org homepage reference, 'About Schema.org' section). Schema.org started in 2011 and went through 14 major releases in the last nine years, the last one in 2022. Besides, the schema.org project publishes documentation on all the specification's supporting processes on its Releases section.\r
\r
Schema.org homepage reference, 'About Schema.org' section:\r
https://schema.org/docs/about.html\r
\r
Schema.org reference, Releases section:\r
https://schema.org/docs/releases.html\""""@en ;
    cav:refersTo camssa:e030c3cf-b23f-4dbc-81e5-db5250e9cf42 .

camssa:7a732643-d3b2-4dc2-8d83-415dfac216e2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Basic Formal Ontology (BFO) is a small, upper level ontology that is designed for use in supporting information retrieval, analysis and integration in scientific and other domains. Thus the specification is conceived as a tool to facilitate organisational interoperability agreements.

BFO reference:
https://www.iso.org/standard/74572.html'"""@en ;
    cav:refersTo camssa:3327fd55-e866-447d-9fb7-338ba262f6e7 .

camssa:7a787574-4a5c-4b42-b3e8-7a6d839be72b a cav:Score,
