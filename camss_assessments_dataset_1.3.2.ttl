https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss\r
/camss-list-standards\r
\r
NIFO Factsheets:\r
https://joinup.ec.europa.eu/collection/nifo-national-interoperability-framework-observatory/digital-public\\x02administration-factsheets-2023\""""@en ;
    cav:refersTo camssa:ebc74d5f-0ad6-4c88-a097-0f0e330f6a48 .

