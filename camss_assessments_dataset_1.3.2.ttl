        owl:NamedIndividual ;
    cav:judgement """'The purpose of BFO is not related to the reuse of information. Therefore, this criterion is not applicable to 
the specification.

BFO reference:
https://www.iso.org/standard/74572.html'"""@en ;
    cav:refersTo camssa:0d893b28-20f6-48f7-af5a-38302ef5b054 .

