camssa:fb5230b1-a1cd-44bc-93a2-65ae64f05a54 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of IPv4 is not related to the modelling of business processes. IPv4 is primarily a network protocol designed to facilitate communication over the internet, and it does not inherently focus on modelling business processes. 

IPv4 IETF:
https://www.rfc-editor.org/rfc/rfc791'"""@en ;
    cav:refersTo camssa:0aeb82b5-a376-4174-b3c6-6043d743c77f .

camssa:fb529384-9d3a-4674-aed6-e7aa6ff69ebd a cav:Score,
        owl:NamedIndividual ;
