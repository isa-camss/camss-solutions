        owl:NamedIndividual ;
    cav:assignedTo sc:c-0b00b9b74de866ed2278d14d1b9d7ecf2c06950d296bb2f17013c7b710d6de41 ;
    cav:value "100"^^xsd:string .

camssa:70f228cf-eb3d-4634-bf8c-38ab342fb122 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
    cav:value "100"^^xsd:string .

camssa:72c30ffd-d0dd-4a92-a7a8-64f0db392e3b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'REST is a core technology for major European cross-border projects. For instance, the Once-Only Technical System (OOTS) uses RESTful APIs as the primary method for Member States to exchange evidence securely and efficiently. The main goal is to simplify administrative procedures for citizens and businesses by ensuring they only have to provide their information once._x000D_
_x000D_
European Commission - Once-Only Technical System (OOTS) - REST reference:_x000D_
https://oots.pages.code.europa.eu/tdd/apidoc/_x000D_
_x000D_
REST reference:_x000D_
https://restfulapi.net/'"""@en ;
    cav:refersTo camssa:51513334-4da4-440f-a975-f9eb6d6d1a62 .

camssa:73f5e3d2-a0f5-496d-a501-ecde9dea15b0 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d2c939f8f97b2a02c254da4add5fcbea1311d465178344adc029d82366a0f642 ;
    cav:value "100"^^xsd:string .

camssa:770a4ef0-d906-43d1-9dec-0ed0ff1369aa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of REST is not related to the development of business processes. Therefore this criterion is not applicable to this specification._x000D_
_x000D_
REST reference:_x000D_
https://restfulapi.net/'"""@en ;
    cav:refersTo camssa:facb955b-c4de-427d-b922-5d9bde90005c .

camssa:79dbb0cd-56fd-4b28-9f2d-4821327dfd3b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'REST is supported by an incredibly active global community. It is extensively discussed on general platforms like Stack Overflow and GitHub, where developers share implementations and solve technical challenges. Within the European context, it is a central technology on the Interoperable Europe Portal, where public administrations share RESTful digital solutions and best practices to improve cross-border interoperability and the sharing of data._x000D_
_x000D_
Stack Overflow - REST Community Discussions:_x000D_
https://stackoverflow.com/questions/tagged/rest_x000D_
_x000D_
GitHub - REST API Topic:_x000D_
https://github.com/topics/rest-api_x000D_
_x000D_
Interoperable Europe Portal - REST reference:_x000D_
https://interoperable-europe.ec.europa.eu/collection/eurostat/solution/rest-api-web-services_x000D_
_x000D_
REST reference:_x000D_
https://restfulapi.net/'"""@en ;
    cav:refersTo camssa:4f98b4d4-34f2-490a-89ff-017a17f1e94b .

camssa:7e4e2368-5277-426e-9e93-5c34b8595707 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of REST is not related to the reuse of information. Therefore, this criterion is not applicable to this specification._x000D_
_x000D_
REST reference:_x000D_
https://restfulapi.net/'"""@en ;
    cav:refersTo camssa:fdbf6579-f8fd-4401-bd84-e5f654058cc4 .

camssa:830f6e9e-5252-4c60-8a11-c4a682613eac a cav:Score,
