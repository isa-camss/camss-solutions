    cav:refersTo camssa:ef4bf423-5fd6-4f96-b6ec-ecc674585df8 .

camssa:98a73814-6050-416e-a5a4-927177f7ca20 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Registered Organization Vocabulary is not included in any initiative at European or National level covering privacy aspects, since its main function is to describe organisations that have gained legal entity status through a formal registration process, typically in a national or regional register. Therefore, this criterion is considered not applicable to this specification.

Registered Organization Vocabulary reference:
https://www.w3.org/TR/vocab-regorg/'"""@en ;
    cav:refersTo camssa:e40bead2-5c39-4503-8903-54331904a45d .

camssa:98a898ba-d6b2-4fbb-a8b5-014562532d10 a cav:Score,
