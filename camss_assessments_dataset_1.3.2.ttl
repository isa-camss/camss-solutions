camssa:9d927367-d07c-45a4-8169-ca3147894e0e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Better Regulation Guidelines and Toolbox does not contemplate data accuracy measures as an element to define regulatory elements. Therefore the criterion is not applicable.

Better Regulation Guidelines and Toolbox reference:
https://commission.europa.eu/law/law-making-process/better-regulation/better-regulation-guidelines-and-toolbox_en

Better Regulation Toolbox reference:
https://commission.europa.eu/document/download/9c8d2189-8abd-4f29-84e9-abc843cc68e0_en?filename=BR%20toolbox%20-%20Jul%202023%20-%20FINAL.pdf'"""@en ;
    cav:refersTo camssa:0ac9f901-b4f4-4dd0-a260-6e7434513ac0 .

camssa:9d98d4fa-7786-4e72-8cbe-330c0f51472d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "Information shared by an IPv4 packet, which is the smallest message entity exchanged via the Internet Protocol, contains structured information which can be considered a cross-border reusable data model. That structure is relevant for proper consumption and data exchange. "@en ;
    cav:refersTo camssa:82419438-ccf2-4b2a-a2f2-3506f62ddbd3 .

camssa:9d98e045-47fd-4263-8779-c4544bdbb535 a cav:Score,
