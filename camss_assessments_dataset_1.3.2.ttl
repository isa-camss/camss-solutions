camssa:be8554d2-e0a9-4f50-9935-03d4bb3e22d0 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There is no Member State that includes SFIA in their national catalogue with its National Interoperability Framework (NIF) in alignment with the three categories: 1. Conceptual model for integrated public services provision, 2. interoperability layers, and 3. interoperability principles.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards'"""@en ;
    cav:refersTo camssa:ec19504d-8c0d-4a82-9cc2-2667ec04c64d .

