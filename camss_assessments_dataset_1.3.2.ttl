    cav:assignedTo sc:c-b37687b8bb3dbd4c6f96969358cf5d70900d1ccd01402cea7668da6303bec4b4 ;
    cav:value "100" .

camssa:5dd37f5d-35c4-46c4-b0ff-cbbad50244ef a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The CPSV-AP allows describing public services in a standardised human and machine-readable format. This fact fosters the discoverability of the datasets containing information about public services. Therefore, it enhances its reuse and visibility.\r
\r
CPSV-AP Joinup webpage:\r
https://joinup.ec.europa.eu/solution/core-public-service-vocabulary-application-profile/release/22\r
\r
\r
Tim Berners-Lee 5-star schema for Open Data:\r
https://5stardata.info/en/\r
\r
On using the core public sector vocabulary (CPSV) to publish a "citizen's guide" as linked data:\r
https://www.researchgate.net/publication/325495548_On_using_the_core_public_sector_vocabulary_CPSV_to_publish_a_citizen's_guide_as_linked_data"""@en ;
    cav:refersTo camssa:ec8d307a-4967-47eb-9e1e-5d83e6dcc491 .

camssa:5dda9045-d6a1-42a1-a9f3-482fe55e175d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OData.org provides a OData Service Validation Tool for free to validate OData implementations.\r
\r
OData Service Validation Tool:\r
https://www.odata.org/blog/odata-service-validation-tool/'"""@en ;
    cav:refersTo camssa:73ea8b61-f73d-480e-ba09-9dbceec2013f .

camssa:5ddfa74a-4d38-4124-a2a5-ce78d32ac554 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The ISO 639-2 code suite was developed to be used by libraries, information services and publishers to indicate language in the exchange of information, especially in computerised systems. The specification may contribute to the promotion of administration services by easing the automatic translation of the website content from one official European language to another (by using a the EU Official Language codelist) when using a European public service interface or solution, such as eForms. \r
\r
ISO 369-2 FAQs:\r
https://www.loc.gov/standards/iso639-2/faq.html#5\r
\r
eForms reference:\r
https://docs.ted.europa.eu/eforms/0.5.0/translations/index.html\r
\r
eForms Language reference:\r
https://docs.ted.europa.eu/eforms/0.5.0/codelists/index.html#_tailored_codelists'"""@en ;
    cav:refersTo camssa:32d4168b-1b7e-4025-81e4-fb2827f543b2 .

camssa:5ddfc94f-510c-4303-9de9-39709db2b4a3 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "HTTP is a sector agnostic specification. "@en ;
    cav:refersTo camssa:31cf05e3-2c9d-4c84-92c9-fe2fcbb9064a .

camssa:5de203ee-d091-4182-ad07-48b2d560ae6d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'LDES is a European Standard as it was developed and recognized by the European standards organisations; it is also maintained by the EU community.

LDES specification: 
https://joinup.ec.europa.eu/collection/semic-support-centre/linked-data-event-streams-ldes'"""@en ;
    cav:refersTo camssa:cc2f3047-8b25-445b-8795-1f40f82ebae2 .

