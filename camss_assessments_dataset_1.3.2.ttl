camssa:34f15821-7ed6-420a-9a0d-885e0902e3d7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The CAdES Baseline Signature function is to facilitate the electronic signature in compliance with eIDAS regulation. The signature of a document can provide the involved stakeholders with the possibility to use the extensions on the signature in order to define specific legal or policy references relevant to the context of the signed document like confidentiality._x000D_
_x000D_
CAdES reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31912201/01.03.01_60/en_31912201v010301p.pdf'"""@en ;
    cav:refersTo camssa:b9c25e5d-e1b3-4e96-a64c-284de65319b9 .

