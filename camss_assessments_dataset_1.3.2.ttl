    cav:assignedTo sc:c-a81c4b8658f57e819297eb0b7977407f8d814c6fe749c74a8ac497277ca7d9d8 ;
    cav:value "0" .

camssa:81c054c8-4504-4fc9-9281-9ece2089305d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """FTPS is a business domain agnostic specification that can be reused in a cross-domain way.\r
\r
FTPS IETF reference:\r
https://tools.ietf.org/html/rfc4217"""@en ;
    cav:refersTo camssa:927cfa40-3ec7-40fd-9f49-a338df6db8ac .

