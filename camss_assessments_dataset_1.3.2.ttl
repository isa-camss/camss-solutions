        owl:NamedIndividual ;
    cav:assignedTo sc:c-8c09094de9d71f12686896827a205db683b6df58fa363bc5be2a7d99989e7dd0 ;
    cav:value "1" .

camssa:5e2733cd-8239-4ee0-b132-8529e013179a a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-0b122f4f42ca2089ee158a31d932d6a0332aa3a4d04acce1e2e7aa140815a0ec ;
    cav:value "100" .

camssa:5e2e531a-9d5b-4c4d-9a9b-a1b70df8790b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Although MIME itself does not foresee secure exchange of data mechanisms, its security extension (S/MIME) can enable it through a combination of encryption, digital signatures, authentication and data integrity checks.\r
\r
MIME specification:\r
https://tools.ietf.org/html/rfc2045\r
\r
S/MIME specification:\r
https://www.rfc-editor.org/rfc/rfc5751.html\r
'"""@en ;
    cav:refersTo camssa:5d4a6692-b3a1-4746-91da-3a607741b497 .

camssa:5e31ffab-1274-4f63-ad99-2b8175f0ebfa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'TGF is an OASIS standard, therefore it is not considered to be European.\r
\r
TGF Specification:\r
http://docs.oasis-open.org/tgf/TGF/v2.0/cs01/TGF-v2.0-cs01.html'"""@en ;
    cav:refersTo camssa:c9df1369-104f-46e2-9030-c6559385a142 .

camssa:5e467085-531b-4806-a3cc-84b5190f8216 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'UDDI does not help the availability of interfaces with internal information. In fact, the purpose of the specification is not related to this action. Despite this, UDDI supports the availability of technical interfaces that may be used to access web services, given that it specifies the methods and protocols through which the services can be accessed and used, making it easier for developers and other systems to integrate with public administration services.

UDDI techtarget reference:
https://www.techtarget.com/whatis/definition/UDDI-Universal-Description-Discovery-and-Integration

UDDI OASIS reference: 
https://www.oasis-open.org/committees/uddi-spec/doc/spec/v3/uddi-v3.0.2-20041019.htm#_Toc85907967'"""@en ;
    cav:refersTo camssa:2e5e906b-91f9-437a-9e43-019bd8a9dec3 .

camssa:5e4a6733-632f-4e6f-a70f-58888c7d7360 a cav:Score,
        owl:NamedIndividual ;
    cav:value "81%StrengthOfAssessmentScoreAverage",
        "87%AssessmentScoreAverage" .

camssa:5e4beac4-38c5-4903-996e-8c2de198d068 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-e8c3529a6146f0b0d269112be717ba4e9c5979ea4f43f57d217c0f998d26ce17 ;
    cav:value "0" .

camssa:5e5645b1-5b00-4146-ae3f-0985f8d700b0 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The OAIS reference model does provide a framework for organizing and managing digital information in a way that can support a wide range of administrative procedures, rules, and services. By defining a set of functions and interfaces that are necessary for the long-term preservation and access of digital objects, the OAIS reference model provides a foundation for the development of systems and services that can be used to manage and provide access to digital information in a wide range of contexts.\r
\r
OAIS specification:\r
https://public.ccsds.org/Pubs/650x0m2.pdf'"""@en ;
    cav:refersTo camssa:cd03461c-1651-4fc4-b3a4-88b1481d102a .

camssa:5e599fe8-7881-4731-8500-8d240eebfd80 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of OpenPM2 seems not to be related to long term preservation of electronic records. Moreover, no information has been found to answer positively or negatively to this criterion. \r
\r
OpenPM2 specification reference:\r
https://op.europa.eu/en/publication-detail/-/publication/ac3e118a-cb6e-11e8-9424-01aa75ed71a1/language-en/format-PDF/source-83307127"""@en ;
    cav:refersTo camssa:80952551-20b4-4a86-a346-8cc6144fe266 .

camssa:5e5a921c-269f-4596-996c-5de8b75fc442 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """UDDI is developed and maintained by OASIS, which is an International Organisation developing Standards. After finishing UDDI's last version (v3, which is being assessed) the Technical Committee was closed. \r
See:\r
https://www.oasis-open.org/committees/uddi-spec/doc/spec/v3/uddi-v3.0.2-20041019.htm#_Toc85907967"""@en ;
    cav:refersTo camssa:b6c9807a-6271-4c68-b776-4373a6a3f083 .

camssa:5e5ce812-b301-4db9-8393-22b2257d879b a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-69dbbbfc4ff4c79244a3bd99f7c3f883f2a7114ec515cb4d576f0d807c94b9fd ;
    cav:value "20" .

