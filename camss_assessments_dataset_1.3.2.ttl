        owl:NamedIndividual ;
    cav:judgement """There are no Member States recommending CPOV in their ICT National Catalogues.\r
 \r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards """@en ;
    cav:refersTo camssa:8b1597ce-471d-47fd-84df-4f901f92429d .

camssa:fd0e6cef-7a63-40c7-b380-b71bae87ef8d a cav:Score,
        owl:NamedIndividual ;
