camssa:aba66cec-06ca-4b58-89d4-aa8200bd8a5f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Core Public Organisation Vocabulary facilitates the information sharing. It enables G2G (Government-to-Government), G2B (Government-to-Business) and G2C (Government-to-Citizen) information sharing.\r
\r
CPOV Joinup reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-public-organisation-vocabulary"""@en ;
    cav:refersTo camssa:72c4fb99-abaa-4d55-bd81-ebc97984933b .

