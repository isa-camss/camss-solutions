    cav:value "100" .

camssa:3e90b8ab-400d-422b-88b1-b78dd008197d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'DNS is included in 9 national catalogues of recommended specifications. They belong to Coratia, Cyprus, France, Germany, Greece, Malta, the Netherlands, Spain and Sweden.  The National Interoperability Framework of France, Germany and Spain is fully aligned with the 3 sections of the European Interoperability Framework (EIF) according to the National Interoperability Framework Observatory (NIFO) factsheets.\r
\r
NIFO Factsheets France:\r
https://joinup.ec.europa.eu/sites/default/files/inline-files/DPA_Factsheets_2021_France_vFinal.pdf\r
\r
NIFO Factsheets Germany:\r
https://joinup.ec.europa.eu/sites/default/files/inline-files/DPA_Factsheets_2021_Germany_vFinal.pdf\r
\r
NIFO Factsheets Spain:\r
https://joinup.ec.europa.eu/sites/default/files/inline-files/DPA_Factsheets_2021_Spain_vFINAL_0.pdf\r
\r
CAMSS list of standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards'"""@en ;
    cav:refersTo camssa:e760e3de-e825-4ef7-b8d8-36c3709af96c .

camssa:3e9ce5cb-377f-4fe5-ab42-81012a0f8f99 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-0c9dd43038136296b52f50e05f9d6eef39f7b8018517224007990b15be2eb19e ;
    cav:value "1" .

camssa:3ea65cda-efef-404b-aff7-04f31b87ac13 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """After checking the different standard catalogues at supra-national level, there is no evidence of the inclusion of FTPS within any European catalogue of standards.\r
\r
ICT technical specifications:\r
https://ec.europa.eu/growth/industry/policy/ict-standardisation/ict-technical-specifications_en \r
\r
CEN search tool catalogue:\r
https://standards.cen.eu/dyn/www/f?p=CENWEB:105::RESET::::\r
\r
CENELEC search tool catalogue:\r
https://www.cenelec.eu/dyn/www/f?p=104:107:0::::FSP_LANG_ID:25"""@en ;
    cav:refersTo camssa:f32007ee-bae0-412c-b678-f10ad67dd0b1 .

camssa:3ea67c4e-b374-4b78-9c58-f1bd0d30a452 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of the EN 303 645 specification is not related to the visibility of administrative procedures, rules data, and services. \r
\r
