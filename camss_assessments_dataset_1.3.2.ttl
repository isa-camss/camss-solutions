        owl:NamedIndividual ;
    cav:judgement """'The Joinup platform holds several discussion forums about the implementation and usage of UTF-8.  \r
\r
UTF-8 discussion forums in Joinup:\r
https://joinup.ec.europa.eu/search?keys=utf-8&sort_by=relevance&f%5B0%5D=type%3Adiscussion'"""@en ;
    cav:refersTo camssa:692373e3-da2b-4365-a863-9b9d5c9be1fe .

