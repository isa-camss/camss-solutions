camssa:88133cf7-e931-43bb-8b4d-85aa514ff9a3 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Although the Core Public Organisation Vocabulary is sufficiently mature for its use in the development of products and services, it does not have a good market acceptance because it has not been integrated with any official solution, it has only been tested on pilots.\r
\r
CPOV Joinup reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-public-organisation-vocabulary"""@en ;
    cav:refersTo camssa:830bd5c1-cfd2-464b-b178-7c625e7bf496 .

