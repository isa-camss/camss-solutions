    cav:value "100" .

camssa:1d4daebd-0993-47e1-8f4a-0f5f81473796 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are clear guidelines for customisation and extensions for the specification.\r
\r
http://www.xbrl.org/int/gl/2015-03-25/GLTFTA-REC-2015-03-25.html#section-how-to-create-extensions-within-the-gl-taxonomy-framework'"""@en ;
    cav:refersTo camssa:8597c9bb-9983-419e-835f-6603d35baffe .

camssa:1d58898c-11a8-43a8-9b1b-b6c52618733a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'According to the 5 star Open Data model suggested by Tim Berners-Lee about how to publish linked data, \r
the second star corresponds to the availability of data as structured data. ebXML is an XML family standard \r
and therefore incorporates XML, allowing the publication of public data as open data. \r
\r
ebXML reference, section 1:\r
http://docs.oasis-open.org/regrep/regrep-core/v4.0/os/regrep-core-overview-v4.0-os.html#__RefHeading__8798_474791649\r
\r
Tim Berners-Lee 5-star schema for Open Data:   \r
https://5stardata.info/en/'"""@en ;
    cav:refersTo camssa:69e5dbec-b595-40a4-bcb4-343334d2b632 .

camssa:1d6de322-ebfa-477b-9115-2905bbb55fb2 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a6184fb705cfed44856c7b9594b492926f7a63a128a5a2be7b896294d8c79838 ;
    cav:value "100" .

