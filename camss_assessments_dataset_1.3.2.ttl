    cav:assignedTo sc:c-26c3fa9eb08207b2dfbd8d7c3852f0c9db3fdc50491d24db5b2f2eb1acf68732 ;
    cav:value "100" .

camssa:ec0f843c-1d91-493b-bbc4-8794b9b03d14 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"DNS does not relate to data integrity, but its DNS Security Extensions (DNSSEC) contributes in this area by ensuring that DNS responses haven't been tampered with during transmission, which enhances data integrity.

DNS IETF reference:
https://datatracker.ietf.org/doc/html/rfc8499\""""@en ;
    cav:refersTo camssa:4d2b1f38-ba4e-471a-b521-d8de47a888f3 .

