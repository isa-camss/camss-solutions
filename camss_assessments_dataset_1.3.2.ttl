    cav:refersTo camssa:9bf75e2a-d544-477c-96e0-cd9993e13efd .

camssa:0050bea4-06e7-448a-8834-896228bc740f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'JSON is a data-interchange format is used by APIs, which are involved in the delivery of information between platforms, and in consequence service delivery. This fact makes JSON an element that fosters the delivery of European Public services, including multilingual ones.\r
ecma\r
JSON specification:\r
https://www.-international.org/wp-content/uploads/ECMA-404_2nd_edition_december_2017.pdf'"""@en ;
    cav:refersTo camssa:5bb6b516-e154-48f7-983f-0fc85796aa71 .

