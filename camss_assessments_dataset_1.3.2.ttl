    cav:assignedTo sc:c-17a2b7a0ca372f407c300b69049faf9d92cbf274964290ba278b18cf10bf5dbf ;
    cav:value "20" .

camssa:d1316e60-0e5c-41cc-874b-af89227d93dc a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """IPv6 is publicly available for implementation and use, and therefore for everyone to study, for free on IETF webpage. \r
See:\r
https://tools.ietf.org/html/rfc2460"""@en ;
    cav:refersTo camssa:959f7b94-71c2-469f-b085-2b91c83936d5 .

camssa:d136aa14-ccd3-4959-8a2c-d495630d6464 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'DNS over HTTPS (DoH) allows for customisation but the extent of customisation may vary depending on the DNS resolver or client software being used. For instance, ssers and administrators can choose the specific DNS resolver that supports DoH. In addition, users can also specify the URLs of the DoH servers they want to use, allowing flexibility in choosing service providers.

DoH specification: https://datatracker.ietf.org/doc/html/rfc8484'"""@en ;
    cav:refersTo camssa:a5036486-2a0e-4d97-b8a5-7bd4deea0b60 .

camssa:d13bd8b7-3469-4f36-b2bd-4048eec3c0bb a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d7be9f0dd52944e6c25f5469c86355a42ae446838bd9759b4986d21f7db4814b ;
    cav:value "1" .

