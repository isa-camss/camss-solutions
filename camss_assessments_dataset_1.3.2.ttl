camssa:91c725d4-2501-4f50-9777-e60c32044c3f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XBRL international supports the above by national and international communities to further develop and\r
support the implementation of the specification.\r
e.g. https://fi.xbrl.org/, https://www.xbrl.org/tag/spain/\r
\r
XBRL GL provides a standardized toolset for the broad adoption of relevant data standardization, but the\r
developers recognized that local extensions and variations will be necessary. Under the auspices of local\r
XBRL jurisdictions or other organizations, further standardization leveraging XBRL GL are expected,\r
encouraged and facilitated.\r
\r
http://www.xbrl.org/int/gl/2015-03-25/GLTFTA-REC-2015-03-25.html#section-how-to-create-extensions-within-the-gl-taxonomy-framework\r
'"""@en ;
    cav:refersTo camssa:7f898d49-b7b6-42dd-bbdb-4a432f4536c0 .

