        owl:NamedIndividual ;
    cav:assignedTo sc:c-a81c4b8658f57e819297eb0b7977407f8d814c6fe749c74a8ac497277ca7d9d8 ;
    cav:value "1" .

camssa:d8e89c5e-f66f-4c36-be4c-5fb9aa743843 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "nan"@en ;
    cav:refersTo camssa:0ac13513-07a2-44e6-a63d-7b1f5bc4d919 .

camssa:d8ed3e4b-9313-4bf3-8bc5-0a35fc964542 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'REST architectural constraints are designed to ensure interoperability between different internet computer systems, thus rendering the communications between systems that  conform to REST more efficient and easy. Consequently,\r
REST can impact positivey in the creation of organisational interoperability agreements.\r
\r
REST reference:\r
https://restfulapi.net/\r
\r
R. Fielding dissertation: chapter 5.\r
https://www.ics.uci.edu/~fielding/pubs/dissertation/rest_arch_style.htm'"""@en ;
    cav:refersTo camssa:d54e996d-5bf2-4af7-8873-d1b457df21ba .

camssa:d8f2c73d-04e7-4d4a-9940-2cbf7374f889 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-483e8900c47b40bc67a6bd1cbfce07884b9ac5f2c85e0214f334cc37e4e65c35 ;
    cav:value "1" .

camssa:d8f326b4-7b84-484c-9d73-d60bd542cae2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """ETSI’s standards-making process has been clearly defined after years of experience. The organisation has adopted the open approach which means direct participation and consensus as a basis to develop standards. All the stakeholders have the opportunity to participate directly in the process of standardisation through the technical committees created to develop ETSI’s technical specifications and standards. The decision-making process includes a public review, where stakeholders involved can provide technical feedback in order to enhance and maximize the quality and accuracy of the standards. \r
See: \r
https://www.etsi.org/standards/standards-making"""@en ;
    cav:refersTo camssa:37936c4f-dfa1-490c-ab10-ad4951c9920d .

camssa:d8f69ee0-e95d-45b4-912f-02979d8856f1 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-8eb17470327d32b3bb523447fe72ee5c60ddb03e81dae318b485fbe05f48a844 ;
    cav:value "0" .

