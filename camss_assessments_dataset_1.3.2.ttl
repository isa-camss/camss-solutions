camssa:ed99a455-7ef9-499e-9aba-b79dde9400e8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The SMP 2.0 specification aims to simplify the delivery of European public services. By providing a standardized approach to service metadata publishing and discovery, the specification enables easier access to and integration of public services across different systems and organizations.\r
\r
SMP OASIS reference:\r
https://docs.oasis-open.org/bdxr/bdx-smp/v2.0/cs02/bdx-smp-v2.0-cs02.html#_Toc30505009'"""@en ;
    cav:refersTo camssa:c297d8bc-8982-49f0-aeb4-afe01153c01b .

camssa:ed9d7fd2-514a-460b-abd8-26b02793e689 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3dd3a1fb1ac7d78d162dab36230e70a34459f38a795e765cc5fdd304c8c04907 ;
    cav:value "100" .

