    cav:assignedTo sc:c-ffdbd22af1ff3c1ebb100043d062a3df160007af761caf0a8c9f50f02e609c9e ;
    cav:value "1" .

camssa:9d9cadbb-5419-4a5b-ab12-e23072743d6b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement " After checking the assessments performed by CAMSS and the list of specifications identified by the MSP Multi-stakeholder-platform, no assessment verifying the compliance of the specification with the European standardisation regulation has been found."@en ;
    cav:refersTo camssa:4b5154d9-4370-4ee0-a35f-21f199fd3a9c .

camssa:9da342d1-3849-425b-96db-5b884c43d09d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'YAML is not included in any initiative at European or National level covering privacy aspects. Therefore, this criterion is considered not applicable to this specification.

YAML specification: 
https://yaml.org/spec/1.2.2/'"""@en ;
    cav:refersTo camssa:fcecd764-46de-49a0-8fff-9cdce261a028 .

