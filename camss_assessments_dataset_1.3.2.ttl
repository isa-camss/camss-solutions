        owl:NamedIndividual ;
    cav:judgement """'The purpose of ISO ISO/IEC 7498:1 is not related to e-accessibility. Therefore, this criterion is considered not 
applicable to this specification.

ISO/IEC 7498:1: 
https://www.iso.org/standard/20269.html'"""@en ;
    cav:refersTo camssa:eba60206-7f9a-4754-97e6-991ca9c0d1d7 .

