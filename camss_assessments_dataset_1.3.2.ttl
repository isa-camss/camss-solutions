    cav:assignedTo sc:c-583a0f52df591048a41be40620830a70260e77855364174d91ba159970d8488e ;
    cav:value "100" .

camssa:606cec1e-252a-4da4-8e15-56e0a6674983 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XBRL is used in many MS in external reporting to government, but XBRL GL taxonomy not yet included.\r
However there has been developments to use the specification in Estonia and among the Nordic Countries.\r
These are under development. It is also worth mentioning the specification is used in \r
Turkey.\r
\r
Estonia: https://itl.ee/en/news/data-driven-reporting-is-the-next-step-in-real-time-economy-sector/ \r
Turkey (https://www.edefter.gov.tr/edeftermevzuat.html)\r
'"""@en ;
    cav:refersTo camssa:240e718f-6538-4a5e-80d9-e3dcfa91e0f0 .

