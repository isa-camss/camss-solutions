    cav:assignedTo sc:c-b433a6dd6682476829a60de6a4fb771395c4baf637aa496ba6bca9bd6766d933 ;
    cav:value "100" .

camssa:b071bec2-c0c2-4048-a33a-2f2bf3f59cd9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is supporting the implementation of eIDAS regulation. Therefore, European organisations in charge of public services are prone to share and improve shared public services and the results of applying them.\r
\r
ETSI TS 119 614-1 reference:\r
https://www.etsi.org/deliver/etsi_ts/119600_119699/11961401/01.01.01_60/ts_11961401v010101p.pdf'"""@en ;
    cav:refersTo camssa:a6b439cd-39da-44cd-bfba-51339f6f2fcb .

camssa:b0734c42-9071-4113-957e-ffc0ca086415 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Advanced Encryption Standard is included in 4 Member States catalogues of recommended specifications. These Member States are Cyprus, Germany, Malta and The Netherlands.

CAMSS List of Standards:
https://interoperable-europe.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards

AES Standard Reference:
https://csrc.nist.gov/pubs/fips/197/final'"""@en ;
    cav:refersTo camssa:1883f799-6870-4ab6-9884-77e38273dfbc .

