        owl:NamedIndividual ;
    cav:assignedTo sc:c-f53dee88cf8529a93a68be781005e903c270057da1a72e2f89e8cb154be0c51b ;
    cav:value "100" .

camssa:698ecdab-9126-489d-b012-8f75e0360602 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'While DQV itself does not directly enable the visibility of administrative procedures, rules data, and services, it plays a crucial role in promoting transparency, interoperability, and quality assessment by providing an standardised metadata about data quality, which can indirectly contribute to their visibility and usability in the context of data publishing and sharing.

Data Quality Vocabulary: 
https://www.w3.org/TR/vocab-dqv/'"""@en ;
    cav:refersTo camssa:08bc6814-8e31-4066-a0e5-9a048e18a90f .

