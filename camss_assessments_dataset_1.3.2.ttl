    cav:value "100" .

camssa:16e4e36c-f8dc-406f-9cff-118418cf3083 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There is only one Member State recommending NUTS in its ICT National Catalogue. This Member State is Ireland.\r
\r
National catalogue Ireland: \r
https://data.gov.ie/pages/opendatatechnicalframework#recommended-standards-for-open-data'"""@en ;
    cav:refersTo camssa:2b172f2c-4617-4f19-b7d8-cb045c769385 .

camssa:16e54ff1-af07-45fc-8a67-1f49baa20632 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The purpose of IPsec is not related  to the modelling of business processes. Therefore, this criterion is not applicable to the specification."@en ;
    cav:refersTo camssa:62270207-955a-49d6-96a3-442b48fbb540 .

