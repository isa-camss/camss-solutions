        owl:NamedIndividual ;
    cav:assignedTo sc:c-a2e2820561158593079cf28230b73b9b7f1cb83da49b04d2317790e20c0c706f ;
    cav:value "100"^^xsd:string .

camssa:d1a6f6a3-b00c-447a-946e-ab924f27dfb5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'CAdES Baseline Signatures is a business sector agnostic specification which is reusable beyond the domain for_x000D_
which it was developed. Specifically, implemented to facilitate the electronic signature in compliance with_x000D_
eIDAS. _x000D_
_x000D_
eIDAS regulation: _x000D_
https://digital-strategy.ec.europa.eu/en/policies/eidas-regulation_x000D_
_x000D_
CAdES reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31912201/01.03.01_60/en_31912201v010301p.pdf'"""@en ;
    cav:refersTo camssa:3ab78909-2cb2-493e-bf3e-91759a8a3ca7 .

camssa:d4f16a4f-b4be-4550-b938-2af0b74762d6 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-b433a6dd6682476829a60de6a4fb771395c4baf637aa496ba6bca9bd6766d933 ;
    cav:value "100"^^xsd:string .

camssa:d52ca5a5-eea9-4600-9dcd-ab4c77288812 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The CAdES Baseline signatures function is to facilitate the electronic signature  documents in compliance with eIDAS regulation. In this sense, the specification, in conjuction with other specifications such as PAdES, ASiC and XAdES can enable the visibility of administrative procedures, as shown with the CEF Digital Signature Service (DSS). _x000D_
_x000D_
eIDAS regulation: https://digital-strategy.ec.europa.eu/en/policies/eidas-regulation_x000D_
_x000D_
DSS reference: https://ec.europa.eu/cefdigital/DSS/webapp-demo/doc/dss-documentation.html _x000D_
_x000D_
CAdES reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31912201/01.03.01_60/en_31912201v010301p.pdf'"""@en ;
    cav:refersTo camssa:1af40ffe-33b6-4ec7-95b7-b9b852088851 .

