    cav:value "100" .

camssa:9da7e522-3256-47e8-a6bb-24e752cc43ac a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is focused on ensuring risk management regarding the security of information, therefore, this criterion does not apply due to the scope of the specification.\r
\r
ISO/IEC 27001 reference website:\r
https://www.iso.org/standard/54534.html'"""@en ;
    cav:refersTo camssa:94a897be-1545-46f6-98a1-b960e0228bbf .

camssa:9dac3338-3b93-4ded-97a8-42acdb55a414 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The purpose of SAML 2.0 is not related to the publication of data as Open Data. Therefore, this criterion is not applicable to this specification."@en ;
    cav:refersTo camssa:8dea1ff2-d009-4572-b4f3-884346e8a5c3 .

camssa:9dac5be8-063b-491d-a2a7-5b68881a119c a cav:Score,
