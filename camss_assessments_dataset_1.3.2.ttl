    cav:value "2" .

camssa:1bb758c3-aa04-4a73-a6dc-05910314e3c8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """FTP is known to negatively impact the scalability of systems using it. The protocol faces problems when transferring high volumes of data.\r
\r
See: \r
https://sapinsider.wispubs.com/Assets/Articles/2012/January/Using-FTP-Know-The-Risks"""@en ;
    cav:refersTo camssa:621bb4e4-fd00-4650-b869-fd0239929237 .

camssa:1bbb65c6-0bd3-4ab3-898d-799a7bb4949d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of CSV is not related to e-accessibility. Therefore, this criterion is not applicable to the specification.     \r
                                        \r
CSV reference:\r
https://datatracker.ietf.org/doc/html/rfc4180'"""@en ;
    cav:refersTo camssa:bf982e36-c64d-4278-9ff1-6a135c934b84 .

camssa:1bbc5e6e-06d4-4fca-af41-cbda221690a2 a cav:Score,
