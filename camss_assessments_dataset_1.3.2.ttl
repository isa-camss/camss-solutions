camssa:37cae460-e82d-4e6b-b09d-fa686d96ba73 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The AKN4EU specification is designed to be modular, which means that it allows for partial implementations as it is explained in section 1.1.2.1 (structural mode). This modularity allows implementers to adopt and use only those components of the specification that are relevant to their specific use case or application.                                                                                                                                                                                                                                                                                    \r
\r
AKN4EU reference: https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/akn4eu'"""@en ;
    cav:refersTo camssa:6aa32fb4-83ca-49b5-ad2e-a128f38c813e .

