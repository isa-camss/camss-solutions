camssa:11124918-8937-4bed-92ff-68b57ec519ba a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "eDelivery provide guidelines for the implementations of OASIS SMP 1.0, which has the goal to define the protocol and binding to a REST interface. Therefore, a conformant implementation of the eDelivery fosters the availability of interfaces with internal information systems."@en ;
    cav:refersTo camssa:ff564a50-fa4d-4c7a-83fe-d6d2f30d4425 .

camssa:11127ac1-6d16-4781-9856-b13c0bd70b12 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The DCAT specification explicitly mentions a section in its documentation about rights and obligations that can guarantee the authenticity and authentication of the roles agents involved in data transactions. It can use the properties dcat:rights, dcat:accessRights and dcat:license to ensure this authenticity.\r
\r
\r
DCAT (v2.0.0) reference (section 8):             \r
https://www.w3.org/TR/vocab-dcat-2/ '"""@en ;
    cav:refersTo camssa:7bf3ef89-f3cb-4ff6-8278-6a77a0dd37ff .

camssa:111bb5e2-9416-49c2-9569-7ded8de367cb a owl:NamedIndividual,
        dcat:Distribution ;
    dcat:accessURL "None"^^xsd:anyURI .

