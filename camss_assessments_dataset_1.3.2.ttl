        owl:NamedIndividual ;
    cav:assignedTo sc:c-7a64b01ca9e737c550b205ba3a8a46b3fcfc9447b648ba8ef15d62d3ada26141 ;
    cav:value "2" .

camssa:f5578f47-cab3-4b9f-bbdb-2b226b506497 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of FTPS is not related to long term preservation of electronic records. Therefore, this criterion is considered not applicable to this specification. \r
\r
FTPS IETF reference:\r
https://tools.ietf.org/html/rfc4217"""@en ;
    cav:refersTo camssa:b8d03049-cb7d-47db-8ad7-25e3ae87c017 .

camssa:f55f9312-8611-42e0-aef6-f5663c8a3500 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'REM is a type of electronic registered delivery, which increases usability and ensures integrity, confidentiality \r
and non-repudiation and protects against the risk of loss, theft, damage and any illegitimate modification.\r
\r
ETSI EN 319 532-3 reference:\r
https://www.etsi.org/deliver/etsi_en/319500_319599/31953203/01.02.01_60/en_31953203v010201p.pdf'"""@en ;
    cav:refersTo camssa:c697161d-1630-4407-8508-a21938ab6d05 .

