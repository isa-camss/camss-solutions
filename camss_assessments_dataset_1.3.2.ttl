camssa:63726c0d-894e-4d9b-87ab-1cede5a31ee4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'iCalendar defines an access classification as the only component of the overall security system within a calendar application. However, this access classification mechanism must be complemented by other security components of a calendar system in line with the platform or system where the specification is being used.\r
\r
iCalendar Classification:\r
https://www.rfc-editor.org/rfc/rfc5545#section-3.8.1.3'"""@en ;
    cav:refersTo camssa:ef50d7df-2fdf-446f-a880-c3148aae8505 .

