    cav:assignedTo sc:c-c2d03f19521389763921ce9c758a3697caa22bed98c2c11c3b10344b11c468bb ;
    cav:value "100"^^xsd:string .

camssa:bc70ded8-f350-4cc9-9fde-cf0fa67da2af a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-497a81dae06c1d53b4cfe96c1f998f6f65d46354d68a83d29a2950c984fc1166 ;
    cav:value "100"^^xsd:string .

camssa:be4ef813-a521-42f4-a773-e33ed8d8601b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'JWS is not recommended by any European Member State._x000D_
_x000D_
JWS Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc7515.html_x000D_
_x000D_
CAMSS List of Standards:_x000D_
https://interoperable-europe.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards'"""@en ;
    cav:refersTo camssa:d4627c25-22d0-4374-a482-dc9c22990991 .

camssa:c0e9a4a6-7471-4054-96da-dafaf5fcd381 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3beae22dd24b0dbc955ce74a9fe755390983d8436a45b401461ceaaa7a5d1609 ;
    cav:value "60"^^xsd:string .

camssa:c6b88bcc-fcd6-44c5-880e-21abb5719eb0 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-847f0d7b5b56f9491b75fadd87efa1d6bdb112bcbb660d2ec7b6d786d403360f ;
    cav:value "100"^^xsd:string .

camssa:c79f9f45-8aae-4c28-bc25-906dda3ca6d5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'JWS helps protect personal data by ensuring the authenticity and integrity of the exchanged information. It does this by attaching a cryptographic signature to a JSON payload. The signature does not hide or encrypt the data, in that case, JWE can be used alongside JWS to encrypt the content so that only authorised recipients can access it._x000D_
_x000D_
JWS Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc7515.html_x000D_
_x000D_
JWE Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc7516.html'"""@en ;
    cav:refersTo camssa:faf1edc4-de1d-4c79-97fd-c4e8486f6cf5 .

camssa:cd6bcad5-1665-4be8-8bf5-b8dcd425e7c2 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-26aeec3cf5b3b4879325e85fcd751d0c17f62c6c3113109fb100883a553ec0af ;
    cav:value "100"^^xsd:string .

camssa:d25eb534-0d2d-461a-ad49-9790fa265cd1 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-22c3c5b40201f4ab2cb64a2d34b7665f8d0d1562f2a3e1a493dd3312608c7537 ;
    cav:value "100"^^xsd:string .

