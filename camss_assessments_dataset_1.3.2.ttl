    cav:assignedTo sc:c-450e8a1f4cffbbf3de202e37bd642f098174559028df90ccc657473a6086bc0b ;
    cav:value "2" .

camssa:1e2bbcbc-c20a-4d22-990e-c6de6c01a562 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Better Regulation Guidelines and Toolbox only refers to the authentication protocols on certain elements (tool 28) and only recommended as best practice. In this sense the specification sets the legal framework for the provision of authenticity features but does not set a definitive guide.

Better Regulation Guidelines and Toolbox reference:
https://commission.europa.eu/law/law-making-process/better-regulation/better-regulation-guidelines-and-toolbox_en

Better Regulation Toolbox reference:
https://commission.europa.eu/document/download/9c8d2189-8abd-4f29-84e9-abc843cc68e0_en?filename=BR%20toolbox%20-%20Jul%202023%20-%20FINAL.pdf'"""@en ;
    cav:refersTo camssa:46ee13a9-8caa-4ef3-bc60-a30a599429c1 .

camssa:1e2f367f-aac0-49e7-9100-ea5588d2126f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are some general implementation guidelines that a user must follow in order to implement the specification, explained in the following link.\r
\r
DCMI Point 3, General Implementation Guidelines:\r
https://www.dublincore.org/specifications/dublin-core/dc-xml-guidelines/\r
\r
DCMI About:\r
https://www.dublincore.org/about/ '"""@en ;
    cav:refersTo camssa:c8992ab4-695b-4f41-96a8-d1746857eeb5 .

