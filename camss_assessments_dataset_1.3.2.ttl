camssa:df8aaf4c-a2b6-42c1-bde5-185f5bd4e93a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'CPSV-AP is a reusable and extensible data model for harmonising the way public services are described in a machine-readable format. So it describes the public administrations and eases their visualisation and comprehensibility.\r
\r
CPSV-AP Joinup webpage:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/core-public-service-vocabulary-application-profile/release/22'"""@en ;
    cav:refersTo camssa:2a852ddc-49c2-40d3-98c5-85d6637bed79 .

camssa:df8ef792-3c8e-4e67-a251-283b6e3efe4d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'EuroVoc is a public asset developed by a European Institution and can be accessed and reused without any \r
payment conditions. Therefore, it can be considered that the specification is licensed under royalty-free basis \r
and (F)RAND basis. \r
\r
EuroVoc:\r
https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource\r
/dataset/eurovoc'"""@en ;
    cav:refersTo camssa:5665db63-b516-485d-b8ae-4f4515d6a101 .

