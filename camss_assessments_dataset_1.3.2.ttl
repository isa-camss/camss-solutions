camssa:e67efbe2-2bcb-4dce-80ef-97c72cb7c290 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The main purpose of CPOV is to provide a reusable data model for describing public organisations in the European Union. It manages a public portfolio that facilitates the discovery of which public authorities and departments are responsible for given areas of the public task. So, it facilitates the visibility of administrative rules.\r
\r
CPOV Joinup reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-public-organisation-vocabulary"""@en ;
    cav:refersTo camssa:e84bbae1-1f2c-4833-a0f8-3f56b4da0a84 .

camssa:e68043e5-0a4e-4628-ae00-a3e183722d18 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-7d12b846c487e7201dbcf395866b5abc0bb5fa040b1f519127b6a5f56d447257 ;
    cav:value "60" .

