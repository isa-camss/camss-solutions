camssa:191d95fe-946f-4ae2-9eb4-0140d3461747 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISO/IEC 27001 is structured to be compatible with other management system standards, such as ISO 9001 and is technology and vendor neutral, meaning that it is completely independent of the IT platform.\r
\r
ISO 27001 reference:\r
https://www.iso.org/obp/ui/#iso:std:iso-iec:27001:ed-2:v1:en'"""@en ;
    cav:refersTo camssa:157574b5-cc43-487a-9236-56d81310cff4 .

camssa:1923f44c-1224-4ada-acd6-a1a48231f6eb a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-73a8058bec757a2fdb0f8513c2f11841e982cbef76c3be82af67707c294da8b8 ;
    cav:value "2" .

camssa:1925e9e4-4d20-48b4-ad9d-5bfab265323e a cav:Score,
