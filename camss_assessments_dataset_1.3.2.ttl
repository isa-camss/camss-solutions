    cav:assignedTo sc:c-ceebc7042ff4b3525981f67e306167d9711ac0bce6ea07a067cdb4881854db97 ;
    cav:value "60" .

camssa:dfcaa561-bba6-42e3-830a-daa161df643f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Like all the IETF standards, this specification is a free and open technical specification, built on IETF standards and licenses from the Open Web Foundation. Therefore it is licensed on a royalty-free basis.
No IPR disclosures have been submitted directly on this RFC.

Intellectual Property Rights in IETF:
https://tools.ietf.org/doc/html/rfc8179'"""@en ;
    cav:refersTo camssa:28150d3c-5c2f-4955-bced-30c6edd2cc1a .

camssa:dfcf4e7f-a1e1-4386-ae74-249281bb271e a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-9420538a5a92af199b492414dd056ab7134e456f005895261b1a5b15a3f2814e ;
    cav:value "100" .

camssa:dfe5e9b5-9929-43e4-9efc-c066bc6bdab4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification clearly encourages the creation of communities along with the sharing of their data and results as its purpose is to improve cloud computing portability and interoperability, thus improving communication between different actors. Furthermore, ISO 19941 has been included in different catalogues of ICT standards in a European level therefore, it is an important stard to consider.\r
\r
ISO 19941:2017: https://www.iso.org/standard/66639.html\r
'"""@en ;
    cav:refersTo camssa:1ed3caec-47db-44df-bece-c24a78337e7c .

