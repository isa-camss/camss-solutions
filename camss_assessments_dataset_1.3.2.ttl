    cav:value "100" .

camssa:fdeaca3d-6188-42c8-b12a-0808a60866a8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of DPV is not related to the long-term preservation of information; therefore, this criterion is not applicable to the specification.\r
\r
DPV specification: \r
https://w3c.github.io/dpv/dpv/\r
\r
DPV primer document:\r
https://w3c.github.io/dpv/primer/#introduction'"""@en ;
