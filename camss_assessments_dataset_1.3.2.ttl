        owl:NamedIndividual ;
    cav:assignedTo sc:c-583a0f52df591048a41be40620830a70260e77855364174d91ba159970d8488e ;
    cav:value "100"^^xsd:string .

camssa:1787021a-8bf1-4dac-b0c2-72ce3d6f3ca5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SAMM is already associated to EIRA ABBs in the EIRA Library of Interoperability Specifications (ELIS). More specifically, SAMM can define the interoperability aspects of the "Privacy Framework", "Security Framework" and "Conformance Test Scenario" ABBs of the EIRA Technical Application View and Organisational View._x000D_
_x000D_
EIRA Library of Interoperability Specifications (ELIS) v6.1.1:_x000D_
https://interoperable-europe.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/solution/elis/release/611_x000D_
_x000D_
SAMM reference:_x000D_
https://owaspsamm.org/about/'"""@en ;
    cav:refersTo camssa:17013d92-3a4c-4b24-b687-b689145dc887 .

camssa:1821bc96-0bb1-47da-bcf8-b43fec437bfe a cav:Score,
