        owl:NamedIndividual ;
    cav:judgement """'The specification has been developed specifically to support the interoperability and standardization of legal documents across European borders. Therefore, it may be suitable for use in European cross-border projects or initiatives.\r
\r
AKN4EU reference: https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/akn4eu'"""@en ;
    cav:refersTo camssa:3d35ae80-3884-455b-a902-5b1902e75166 .

