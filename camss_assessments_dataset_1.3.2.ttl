camssa:3259f9e7-e59d-467a-ac48-feced470a1c5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'HTTP primary role is to provide a standardized framework for web communication by using a request response functions between servers and clients facilitating the access to websites .However, it does not specify how to scope comprehensibly administrative procedures, rules data, and services. Therefore, this criterion is not applicable to the specification.

HTTP /1.1 RFC 2616 Reference:
https://www.rfc-editor.org/rfc/rfc2616.html'"""@en ;
    cav:refersTo camssa:a8fd8d35-5ec2-4a1b-955e-2b2c4deb55ef .

camssa:3260e37a-3a07-453f-ad91-85abc29ca016 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-9420538a5a92af199b492414dd056ab7134e456f005895261b1a5b15a3f2814e ;
    cav:value "100" .

camssa:326463eb-d327-459a-8dd9-27c0d2c35579 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """OpenPM2 is a public asset designed and developed by the European Commission and can be accessed and reused without any payment conditions. Therefore, it can be considered that the specifications is licensed under royalty-free basis and (F)RAND basis. \r
\r
OpenPM2 specification reference:\r
https://op.europa.eu/en/publication-detail/-/publication/ac3e118a-cb6e-11e8-9424-01aa75ed71a1/language-en/format-PDF/source-83307127 """@en ;
    cav:refersTo camssa:96514475-4c5c-45a1-9967-e71abf0cda37 .

camssa:32681678-b512-481a-832e-7af206c74acf a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-50ab6a29689585b917f7b2972d2c41e8c8c52723c2d58eb9b92109c938d4e825 ;
    cav:value "100" .

