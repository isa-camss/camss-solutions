    cav:value "100"^^xsd:string .

camssa:de650950-c17c-4a7e-b858-31d54ef9d425 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-0b00b9b74de866ed2278d14d1b9d7ecf2c06950d296bb2f17013c7b710d6de41 ;
    cav:value "100"^^xsd:string .

camssa:e530a698-88c8-4d72-96db-d229b006e6d0 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'JWS is included in European initiatives covering privacy aspects through the eSignature Building Block. This building block helps public administrations and businesses accelerate the creation and verification of electronic signatures, while supporting mutual recognition and cross-border interoperability of e-signatures across Member States._x000D_
_x000D_
More specifically, JWS is included within the DSS framework. DSS is an open-source library provided by the European Commission for the creation and validation of electronic signatures. It supports interoperable and secure electronic signatures in line with the eIDAS Regulation and related ETSI standards._x000D_
_x000D_
DSS helps ensure the integrity, authenticity, and non-repudiation of personal data exchanged between organisations and public administrations. Within DSS, JWS is used as the main signature mechanism for JSON-based electronic signatures through JAdES. JAdES extends JWS by enabling signed data to be linked to the signatory, ensuring that any later modification of the data can be detected, and supporting additional privacy-related features such as trusted timestamps, signature policies, and long-term validation._x000D_
_x000D_
eSignature Building Block Reference:_x000D_
https://ec.europa.eu/digital-building-blocks/sites/spaces/DIGITAL/pages/467109036/eSignature_x000D_
_x000D_
DSS (Digital Signature Services) Reference:_x000D_
https://ec.europa.eu/digital-building-blocks/sites/spaces/DIGITAL/pages/467109107/Digital+Signature+Service+-+DSS_x000D_
_x000D_
JAdES Reference:_x000D_
https://ec.europa.eu/digital-building-blocks/DSS/webapp-demo/doc/dss-documentation.html#_jades_signature_jws_x000D_
_x000D_
eIDAS Regulation Reference:_x000D_
https://eur-lex.europa.eu/eli/reg/2014/910/oj/eng_x000D_
_x000D_
JWS Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc7515.html'"""@en ;
    cav:refersTo camssa:bc70ded8-f350-4cc9-9fde-cf0fa67da2af .

camssa:e765d361-9afb-4b7f-8511-598259539761 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a6fa642bc8eceff2b1d333dc1123748399264c028fde2fd78308f0a0209ae21b ;
    cav:value "100"^^xsd:string .

camssa:e7cab9a6-83eb-4a19-bbc3-7202fdc31da2 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d2c939f8f97b2a02c254da4add5fcbea1311d465178344adc029d82366a0f642 ;
    cav:value "100"^^xsd:string .

camssa:eac3f38b-2830-46f2-9551-b4cd9fc320e1 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'JWS allows partial implementations. An example of partial implementation would be a system that supports only one signing algorithm and ignores optional header parameters. As long as the mandatory elements defined by the specification are included, the implementation remains conformant, even if optional features and additional algorithms are not implemented._x000D_
_x000D_
JWS Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc7515.html'"""@en ;
    cav:refersTo camssa:9f34cc6a-794d-42d5-b956-19c6a9cf7aa2 .

