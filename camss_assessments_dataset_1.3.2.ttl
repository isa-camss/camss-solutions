    cav:assignedTo sc:c-3dd3a1fb1ac7d78d162dab36230e70a34459f38a795e765cc5fdd304c8c04907 ;
    cav:value "40" .

camssa:676eeeca-38a6-4438-942f-6563e98e0416 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "Consensus is a foundation upon which the Alliance is built and all processes and procedures, particularly in connection to the focus, work plans, deliverables, milestones and tangible specifications / recommendations are consensus based."@en ;
    cav:refersTo camssa:d997ae76-2972-478e-ac30-89e44c3bf0aa .

camssa:676f62c2-714d-45ba-a260-6a38099e58b6 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The XACML specification significantly enhances the secure processing of data through its comprehensive access control framework. By enabling context-aware policies, XACML ensures that data processing operations are conducted securely.

XACML OASIS reference:
https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html'"""@en ;
    cav:refersTo camssa:dcf0ae8e-cc46-4da0-8bec-4c033bab4a06 .

camssa:67715286-2c53-437f-bdbe-e43ad94afb0e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The ETSI and any of its committees, in charge of the development of ETSI TS 119 614-1, operate under the \r
ETSI Intellectual Property Rights (IPRs) and IPR Policy. The specification is licensed on a (F)RAND basis.\r
\r
Intellectual Property Rights Policy, ETSI ownership of IPRs section:\r
https://www.etsi.org/intellectual-property-rights'"""@en ;
    cav:refersTo camssa:c0b8f618-53de-4a56-829d-93a499407f15 .

camssa:6777014c-2255-42b2-9b3f-eb76a0610134 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification can be found, for instance, in one site at national level in Poland. It is present at different levels, the site includes information related to the new releases, access to them, new courses, etc. In general terms, EIRA is present at national level in Poland. 

Portal Gov: 
https://www.gov.pl/web/ia/czym-jest-eira-nowy-kurs-online-w-akademii-interoperacyjnosci

EIRA reference:
https://interoperable-europe.ec.europa.eu/collection/european-interoperability-reference-architecture-eira
/solution/eira/release/610

EIRA Github Repository: 
https://github.com/CarTool-EC/EIRA'"""@en ;
    cav:refersTo camssa:a8f9a9dc-89e2-40f5-9ed5-f5023986fa01 .

camssa:67772e66-e8f1-462b-b201-b40aa567061f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The purpose of LDAP is not related to the exposure of interfaces to access the public administration's services. Therefore, this criterion is not applicable to this specification.

LDAP IETF reference:
https://tools.ietf.org/html/rfc4511
\""""@en ;
    cav:refersTo camssa:156e0ccf-7853-4a92-9317-669f0f12e8bd .

camssa:677d5ed5-810a-448a-9127-3853e142daca a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-e225f44a0b0939b1b30a1ab03b2f38baeca8699c0cd44b4e39adbe19ffbb3542 ;
    cav:value "100" .

camssa:6781a00e-de10-4dd1-9cdb-bd500153ebe3 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-b37687b8bb3dbd4c6f96969358cf5d70900d1ccd01402cea7668da6303bec4b4 ;
    cav:value "100" .

camssa:678eb397-cf7f-4204-a48b-5757f9deddb6 a cav:Score,
        owl:NamedIndividual ;
