camssa:5f26e7b1-fefe-44fb-9e44-0f67d036efcc a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'CSV makes sure content is available on the web, structures data and makes it usable in a non-proprietary open format. Consequently, CSV fosters data portability as the specification makes files available for any system.\r
\r
CSV reference:\r
https://datatracker.ietf.org/doc/html/rfc4180'"""@en ;
    cav:refersTo camssa:ad2cdb4e-6d66-498d-adfc-c7c347c1b889 .

