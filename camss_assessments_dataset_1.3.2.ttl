camssa:ffe9d891-43f8-4edf-a160-1e05825b8b19 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is intended to serve as a device to identify a language name. In addition, there might exist other specifications designed to support multilingualism (e.g., the DCAT Application profile for data portals in Europe, DCAT-AP).\r
\r
ISO 369-2 FAQs:\r
https://www.loc.gov/standards/iso639-2/faq.html#7'"""@en ;
    cav:refersTo camssa:36376382-8a9b-4dce-b636-f6865a200fdf .

