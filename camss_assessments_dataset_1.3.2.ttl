    cav:value "100" .

camssa:948dce75-7e59-422e-a00e-92a4b38de9d8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There is no evidence of the inclusion of SFIA in an open repository/catalogue of standards at European level.\r
\r
EUOS repository of standards:\r
https://www.standict.eu/standards-repository\r
\r
CENELEC and CEN search tool catalogue:\r
https://standards.cencenelec.eu/dyn/www/f?p=CEN:105::RESET::::'"""@en ;
    cav:refersTo camssa:c8a714d8-d4cf-4d8e-a2c0-99949b643bda .

camssa:948ed727-085c-43f8-b71e-f1ddc2cb7380 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of UDDI is not related to long term preservation of electronic records. Therefore this criterion is considered not applicable to this specification.

UDDI OASIS reference:
https://www.oasis-open.org/standard/uddi/'"""@en ;
    cav:refersTo camssa:703b8166-ebaf-4474-8288-a58ae13ddd7c .

