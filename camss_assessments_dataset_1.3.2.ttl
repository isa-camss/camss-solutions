camssa:281a7e60-40aa-4e96-adc0-29697d1f69dc a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The specification ODF 1.2 from ISO is not available for free as all the ISO standards have to be paid. However, it can be checked out the OASIS documentation referring to the ODF, as the content is aligned.\r
\r
ODF ISO reference:\r
https://www.iso.org/standard/66363.html\r
\r
ODF OASIS reference:\r
https://www.oasis-open.org/committees/tc_home.php?wg_abbrev=office"""@en ;
    cav:refersTo camssa:40e02e71-82f6-47f4-b921-b85134ff6c9e .

