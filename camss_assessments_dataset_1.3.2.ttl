        owl:NamedIndividual ;
    cav:assignedTo sc:c-83d21357ecad07668ab7f2010aefed3cebb92dab384eeae6eb7aa77def06cfc3 ;
    cav:value "2" .

camssa:e53846a3-5e8e-4d56-b0a8-557e282058be a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Indexed Database API allows for extension. In this context, there are some available extensions that allow for the improvement of certain features of the specification. One of these extensions is the IndexedDB exporter, which allows for exporting Indexed Database API data to a JSON file.

IndexedDB exporter extension:
https://chromewebstore.google.com/detail/indexeddb-exporter/kngligbmoipnmljnpphhocajldjplgcj'"""@en ;
    cav:refersTo camssa:94cc07b0-e785-41ce-9db1-0673e0c79704 .

