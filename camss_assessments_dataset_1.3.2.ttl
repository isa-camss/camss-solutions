camssa:f80f788c-8373-4964-8761-329dbc910d61 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ebXML is originally associated to the electronic business domain, specially ebXML v1.0. Since the ebXML v2.0 release, the specification started to be indistinctly used in any domain, although its implementation is usually associated to the business domain (see ebXML Business Process Specification reference). \r
\r
OASIS ebXML Registry TC reference, Announcements section:\r
https://www.oasis-open.org/committees/tc_home.php?wg_abbrev=regrep#announcements\r
\r
ebxml.xml.org reference:\r
http://ebxml.xml.org/milestones\r
 \r
ebXML Business Process Specification reference:\r
https://docs.oasis-open.org/ebxml-bp/2.0.4/HTML/ebxmlbp-v2.0.4-Spec-cs-en.htm#_Toc148506924'"""@en ;
    cav:refersTo camssa:d202f775-955b-4d69-8732-9ce88aab5bfd .

