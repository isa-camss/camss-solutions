    cav:assignedTo sc:c-7aa038b5496afb8cb229c692be9a2adc175deb2d5d47e35ad67e027c9eac28ba ;
    cav:value "1" .

camssa:7e495143-3fb5-4799-98ec-7adf30a9bf76 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The use of the shared standard of CIM NGSI-LD API can significantly reduce complexities and barriers in establishing interoperable systems across organisational boundaries. The specification can be used to maintain a single consistent API for Context Information Management, particularly for Smart City applications and government services, which can help when drafting agreements related to that.

GS CIM 009: https://www.etsi.org/deliver/etsi_gs/CIM/001_099/009/01.07.01_60/gs_CIM009v010701p.pdf'"""@en ;
    cav:refersTo camssa:5595780f-5c92-497e-b912-7c2b6c45dbcb .

