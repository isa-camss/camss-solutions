    cav:value "1" .

camssa:36d5cb92-08a7-4b14-ab22-6c7f1dcee2ad a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """FTP is included in the ICT national catalogues of the Netherlands and Spain. These Member States comply with at least 4 out of 5 sections of the EIF according to the NIFO factsheets.\r
\r
See:                                                                                                                                               https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards """@en ;
    cav:refersTo camssa:55b1559d-1773-4074-8130-24f09914b3a5 .

