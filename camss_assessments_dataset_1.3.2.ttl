    cav:value "100" .

camssa:155d00a3-23f1-44e3-9aac-f0d237f9d24f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Since EuroVoc has been developed and published by the Publications Office of the European Union, it can be assumed that the specification is a European Standard.\r
\r
EuroVoc: \r
https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource\r
/dataset/eurovoc'"""@en ;
    cav:refersTo camssa:377b359b-2c88-494a-89b3-f03103c00c58 .

camssa:1560e1b2-51ae-4e19-9899-4b39307bb92d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The GITB TDL major releases are public for anyone to use and review in GITHUB. There is also published documentation on its supporting processes and change management on its website. Being the first release on 2017, GITB TDL has undergone several improvements and overcome possible issues until the last version 1.15, which has been released on 2022.\r
\r
GITB TDL reference:\r
https://www.itb.ec.europa.eu/docs/tdl/latest/changelog/index.html'"""@en ;
    cav:refersTo camssa:1c5b219e-2653-4e6a-af2f-8a444cde5147 .

camssa:15621a29-2365-46ad-9330-ea40be2ca4d8 a cav:Score,
