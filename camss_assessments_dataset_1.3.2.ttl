    cav:assignedTo sc:c-ec3f8a897147f530040ab94fb9bbee9fdad56e7256b2ce6fbb63cf1465315d91 ;
    cav:value "100" .

camssa:7015ba50-8ecb-4860-90a2-ee220e97554a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The iCalendar specification allows for extension through the use of custom properties, parameters, and non-standard components. This extensibility enables developers to add new features or attributes beyond the core standard to meet specific needs or to support additional functionalities.\r
\r
iCalendar specification:\r
https://www.rfc-editor.org/rfc/rfc5545'"""@en ;
    cav:refersTo camssa:bfe82ca6-b3fd-4fb3-a594-3a8cf8f4498b .

camssa:7015e166-4990-4f3a-a1cf-3bbc61304de1 a cav:Score,
