    cav:value "0" .

camssa:24a7676e-fb94-467a-ad2a-124682e66988 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'While DCAT-AP is not specifically designed to facilitate organizational interoperability agreements, the specification can contribute to this goal by providing a standardized way to describe and share data, making it easier for organisations to discover and use data that is published by others. \r
\r
DCAT-AP Specificatio:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/200'"""@en ;
    cav:refersTo camssa:bda4e2d8-a03c-4047-be16-c83b330b658d .

camssa:24adae51-c5a9-448d-aea8-59cfba02586d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The GITB TDL is used in the GITB test bed software, nonetheless it is not tied to it.  It can also be processed by any test bed implementation that conforms to the GITB specifications.  Therefore, the GITB TDL can be platform-agnostic as long as the platform is TDL compliant.\r
\r
GITB TDL reference:\r
https://www.itb.ec.europa.eu/docs/tdl/latest/introduction/index.html#where-is-it-used'"""@en ;
    cav:refersTo camssa:b11934a5-6491-419d-a4f5-9ae2a236383d .

