        owl:NamedIndividual ;
    cav:assignedTo sc:c-f41cca0d171e6f64dbc2bdeae9fbc87f2ea51ac00185b22114d59ab8a06e78d0 ;
    cav:value "1" .

camssa:e93a7bf3-fd8e-43f0-80a8-3dc2ab44a002 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'EN 16234-1 e-CF can be well adapted to new digital service channels and is intended to help new digital service channels to be deployed as describred in the Shaping Europe's digital future approach (see CEN/TC 428 "ICT Professionalism and Digital Competences" Business Plan 2022 reference, section 1.4).\r
\r
CEN reference, CEN/TC 428 - ICT Professionalism and Digital Competences (Published standards), EN 16234-1 e-CF:\r
https://standards.cencenelec.eu/dyn/www/f?p=205:110:0::::FSP_PROJECT:67073&cs=15E62ED24D608A5F10D6BEE8E6D50FA10\r
\r
CEN/TC 428 "ICT Professionalism and Digital Competences" Business Plan 2022 reference, section 1.4:\r
https://standards.cencenelec.eu/BPCEN/1218399.pdf'"""@en ;
    cav:refersTo camssa:98edc4a2-09c3-437e-aada-35589049e5e4 .

camssa:e93def4f-0e7e-4190-ae05-c2a71f107f6f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'At the time of elaborating this assessment, DCAT is extensively used to create innovative linked open data solutions. Especially by public administration looking forward to foster cross-border interoperability and transparency.\r
The specification is widely used by public administrations profiling or extending it to fit domain-specific or national requirements\r
- DCAT-AP: Application Profile for Public Sector Datasets.\r
- DCAT-AP-BE: Extension of DCAT-AP for Belgium specific requirements.\r
- StatDCAT-AP: Extension of DCAT-AP for the publication of statistical data.\r
\r
DCAT (v2.0.0) reference:             \r
https://www.w3.org/TR/vocab-dcat-2/\r
\r
DCAT-AP & European Data Portals reference:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe\r
\r
DCAT-AP-BE reference:\r
http://dcat.be/\r
\r
StatDCAT-AP Reference:                           \r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/statdcat-application-profile-data-portals-europe/release/100'"""@en ;
    cav:refersTo camssa:f0672016-d754-4143-8f72-595a58cfe7ea .

camssa:e93f269d-c3e9-4c6a-b0a6-d43474a83c84 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-1435ad894742693c2b99e329ef12399cd411ed6900f49b9658fd2231de3f201a ;
    cav:value "1" .

