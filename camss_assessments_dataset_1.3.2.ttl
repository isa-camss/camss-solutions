    cav:assignedTo sc:c-1624157830122d60825aa5aa88ab70d0b140b2e7e510086699f9a9773efef6bd ;
    cav:value "20" .

camssa:9f1c9c35-53c4-4525-8b82-acb9a25d385a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SFIA is a framework that is not aligned to any specific platform, provider or industry. Therefore, the specification is platform agnostic.\r
\r
SFIA reference:\r
https://sfia-online.org/en/sfia-8'"""@en ;
    cav:refersTo camssa:a803461d-3c00-4eaf-81d9-047b8fe4dd59 .

camssa:9f2994b5-baf7-4913-96e3-c6598ccab7e4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The CPSV-AP allows describing public services in a standard human and machine-readable format. This fact fosters the discoverability of the datasets containing the information of public services. Moreover, enhances its reuse and visibility. \r
\r
CPSV-AP Joinup webpage:\r
https://joinup.ec.europa.eu/solution/core-public-service-vocabulary-application-profile/release/22\r
\r
5-star linked open data:\r
https://www.w3.org/DesignIssues/LinkedData.html\r
\r
On using the core public sector vocabulary (CPSV) to publish a "citizen's guide" as linked data:\r
https://www.researchgate.net/publication/325495548_On_using_the_core_public_sector_vocabulary_CPSV_to_publish_a_citizen's_guide_as_linked_data"""@en ;
    cav:refersTo camssa:f46196b7-d890-429d-98b9-34a5883c88d7 .

camssa:9f325c9b-2af5-4a5a-add5-9061783c723b a cav:Score,
        owl:NamedIndividual ;
    cav:value "78%StrengthOfAssessmentScoreAverage",
        "87%AssessmentScoreAverage" .

camssa:9f32f280-c926-4eac-9ff1-0cbfa15b8482 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'HTTPS is an internet protocol for the data exchange over an Internet network. It supports the first level of maturity defined in the Tim Berners-Lee´s  5 stars Open Data deployment scheme, ""Make your data accessible on the web". Moreover, When a website uses HTTPS, it allows the secure transmission of data between the server hosting the website and the users accessing it. This secure transmission ensures that the data being published, such as web pages, images, videos, documents, and other resources, can be safely transmitted to the users.\r
\r
Tim Berners-Lee 5 star Open Data:\r
https://5stardata.info/en/ \r
'"""@en ;
    cav:refersTo camssa:d35f8efa-71fd-4ffe-9db5-f040384c2b5b .

camssa:9f38c7d0-cbfb-472c-a8ad-f3ec61eb2c15 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-17bea234285e6e633e4e21105358610ad5f5f0eaaf82f4bd50cb64ec11538984 ;
    cav:value "0" .

