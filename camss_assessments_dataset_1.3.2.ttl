camssa:bfd8a957-cc41-4efb-9bbc-3d60a6ea982c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of XHTML is to publish administrative data on the web. By allowing to publish custom data in an understandable format, it fosters the comprehensibility of administrative data. Moreover, it also eases the decision-making process by ensuring the data exchange and data reuse.\r
\r
XHTML W3C reference:\r
https://www.w3.org/TR/xhtml1/"""@en ;
    cav:refersTo camssa:cc12abbd-35be-4910-82d6-6fc313129688 .

camssa:bfe82ca6-b3fd-4fb3-a594-3a8cf8f4498b a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
    cav:value "100" .

camssa:bfeaab8c-56ff-432d-b638-c8b5e21b00f9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "XSLT is a language for transforming XML documents. Therefore, it fosters the visibility and comprehensibility of public administrations data and services as it facilitates the visibility of the documents. "@en ;
    cav:refersTo camssa:cc172f17-ebe5-4def-90c9-15ef29ef412f .

