camssa:8b6a3e55-7f91-43ef-978e-8a1fe9dffeaa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"There are assessment evaluating the specification's efficiency, such as the LEOS tool, which uses AKN4EU proving that the specification can be efficient.\r
\r
LEOS Tool Reference:                                                                  \r
https://joinup.ec.europa.eu/collection/nifo-national-interoperability-framework-observatory/solution/eif-toolbox/solution-leos-software-components-under-eupl\""""@en ;
    cav:refersTo camssa:18d68a34-c0b5-4e76-9dec-07623db43bf6 .

camssa:8b6c47fc-551d-45d5-9918-61bfccad64ab a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Better Regulation Guidelines and Toolbox fosters the secure and trustworthy data exchange between citizens, businesses and public administrations by proposing methods to ensure that ICT systems and solutions developed under the scope of public services in the EU include security regarding personal data exchanged between parties. In particular this can be seen on the tool 55 (horizontal matters) on the toolbox.

Better Regulation Guidelines and Toolbox reference:
https://commission.europa.eu/law/law-making-process/better-regulation/better-regulation-guidelines-and-toolbox_en

Better Regulation Toolbox reference:
https://commission.europa.eu/document/download/9c8d2189-8abd-4f29-84e9-abc843cc68e0_en?filename=BR%20toolbox%20-%20Jul%202023%20-%20FINAL.pdf'"""@en ;
    cav:refersTo camssa:de1a70f0-a238-4012-8024-7d776e94847a .

camssa:8b704e04-08fa-45f1-b60b-4a90c127b778 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-17a2b7a0ca372f407c300b69049faf9d92cbf274964290ba278b18cf10bf5dbf ;
    cav:value "100" .

