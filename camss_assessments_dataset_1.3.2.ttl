camssa:5f7370ff-7685-428a-9c3f-a2dcce8d1b56 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There is no Member State that includes the EIF in their national catalogue with The National Interoperability\r
Framework (NIF) in alignment with the three categories 1. Conceptual model for integrated public services\r
provision, 2. interoperability layers, and 3. interoperability principles.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss\r
/camss-list-standards'"""@en ;
    cav:refersTo camssa:ac199272-ea05-40d2-852f-fcb3a1d5585b .

