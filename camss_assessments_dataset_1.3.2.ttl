    cav:value "100" .

camssa:ffeae7cf-8687-4aa4-b796-7f2c77e1edb8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of the DNS Queries over HTTPS (DoH) is not related to e-accessibility. Therefore, this criterion is considered not applicable to this specification.

DoH specification: https://datatracker.ietf.org/doc/html/rfc8484'"""@en ;
    cav:refersTo camssa:90af566b-fe3c-4f39-b44d-39c1608c6ffd .

