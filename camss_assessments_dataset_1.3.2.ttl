    cav:assignedTo sc:c-245e5eb8db3a19aebfdf9ccc2c2ac0467bebccc76339696f519452e8bbd393ad ;
    cav:value "100" .

camssa:de6b78ca-59e8-4424-be58-bdb7fd8cb1f6 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are no requirements for compliance and conformance analysis testing defined by the SFIA specification.\r
\r
SFIA reference:\r
https://sfia-online.org/en/sfia-8'"""@en ;
    cav:refersTo camssa:ddef5809-d7d9-4ce7-ad39-83957fb3a576 .

camssa:de70ddea-114c-448c-815a-1080b18bf4de a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Xforms 2.0 is a business domain agnostic specification that can be reused in a cross-domain way.\r
\r
Xforms 2.0 W3C reference:\r
https://www.w3.org/community/xformsusers/wiki/XForms_2.0"""@en ;
    cav:refersTo camssa:bc44157c-98e2-4110-91c2-19bd97b0151a .

camssa:de7803a4-558d-4541-90b8-a880cb42c084 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The specification does not foster the publication of data as linked open data since it is dedicated to the standardisation of processes within a project from a management perspective and not related to data publication. \r
\r
Nonetheless, the methodology can help to establish priorities and enhance how services or products are oriented to the linked open data.  \r
\r
OpenPM2 specification reference:\r
https://op.europa.eu/en/publication-detail/-/publication/ac3e118a-cb6e-11e8-9424-01aa75ed71a1/language-en/format-PDF/source-83307127 \r
\r
5-star linked open data:\r
https://www.w3.org/DesignIssues/LinkedData.html"""@en ;
    cav:refersTo camssa:ba6ff2c7-7f94-4ff2-98b7-0eb31330c118 .

