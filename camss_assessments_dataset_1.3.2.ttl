camssa:e87a974a-d4f8-4f2b-938a-575a4f390479 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The XFDL specification is based on an XML structure. This format supports clearer, more transparent administrative procedures by improving how data is structured, processed, and shared, making the overall process more accessible and understandable.

Extensible Forms Description Language reference:
https://www.w3.org/TR/NOTE-XFDL'"""@en ;
    cav:refersTo camssa:7bc4caff-7434-4540-ad4d-80c682e83442 .

camssa:e87b275e-3d9c-4511-a694-96ba9fcc7506 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-83d21357ecad07668ab7f2010aefed3cebb92dab384eeae6eb7aa77def06cfc3 ;
    cav:value "2" .

