        owl:NamedIndividual ;
    cav:judgement """'Schema.org provides a data model that allows modeling business processes within and beyond an organisation.\r
\r
Schema.org reference, Data model section:\r
https://schema.org/docs/datamodel.html'"""@en ;
    cav:refersTo camssa:09ff1240-b1d6-428e-b8c7-39756894f8a3 .

camssa:71aae928-3928-4bff-bb5d-8ae2de363e75 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification supports data exchange and business processes among partners. The specification is\r
easy to implement into standard business processes.\r
\r
https://www.xbrl.org/int/gl/2016-12-01/gl-framework-2017-PWD-2016-12-01.html\r
\r
https://www.dropbox.com/sh/b5i8ehpnzzymowl/AACpTH-mWRwOFGIQkUYDbWoWa/29.10.2021%20Presentations?dl=0&preview=005_TietoEVRY_Symposium_29.10.2021.pdf&subfolder_nav_tracking=1\r
\r
'"""@en ;
    cav:refersTo camssa:971f8d9c-e608-47ea-b688-bbae89ae1a33 .

