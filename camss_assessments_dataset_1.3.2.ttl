    cav:value "100" .

camssa:0eb8d42a-21f8-4cd4-9fb7-d12dd1a10481 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is focused on testing implementation of Trusted List according to ETSI TS 119 612.\r
\r
ETSI TS 119 614-1 reference:\r
https://www.etsi.org/deliver/etsi_ts/119600_119699/11961401/01.01.01_60/ts_11961401v010101p.pdf'"""@en ;
    cav:refersTo camssa:571e514a-5c06-4025-9004-5018a6fcc21b .

