        owl:NamedIndividual ;
    cav:assignedTo sc:c-b37687b8bb3dbd4c6f96969358cf5d70900d1ccd01402cea7668da6303bec4b4 ;
    cav:value "100" .

camssa:eba96c08-b2c6-4e16-ac7d-3167bd1045b8 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-5df7a9f6081c945a22f500aa0ba2c452b8b9cd9497bd643ac76c39d34a18c319 ;
    cav:value "0" .

