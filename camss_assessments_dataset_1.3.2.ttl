    cav:value "1" .

camssa:b1fcb2e9-48ac-4737-9ace-e7aa01fc4ecf a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-26aeec3cf5b3b4879325e85fcd751d0c17f62c6c3113109fb100883a553ec0af ;
    cav:value "100" .

camssa:b20e9951-ce98-4899-819d-13b7af39b7cf a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-4ac14cafe608f1dbe7e48f96edd7574c55f0aac2c2e99ede0418dae7225977af ;
    cav:value "2" .

camssa:b2129b0d-288a-467a-8d67-f69328d83de3 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Developers can use WSDL to create interoperable web services that can be consumed by a variety of clients, regardless of the platforms or technologies they are built upon.This allows for the decoupling of the service description from the specific technologies or platforms used in the implementation. WSDL can achieve platform agnosticism by providing a high-level, abstract description of web service interfaces and operations.\r
\r
W3C WSDL specification:\r
https://www.w3.org/TR/wsdl20/ '"""@en ;
    cav:refersTo camssa:fafef251-52f6-43a9-9a59-165e5025d6d6 .

camssa:b212ffa9-a4cf-4801-a15c-be1992bcfe6a a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-51782b9aa4b92f4aba322a549b9d3972e304ca68f9353073c29add782502d910 ;
    cav:value "100" .

camssa:b2147666-4bd7-441e-9a84-5db3590ea4cf a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Assistive technologies convey suitable information to people with disabilities by introducing web widgets and structuring web content. In this sense, personal data protection is not addressed by this specification.\r
\r
WAI-ARIA reference, Abstract section:\r
https://www.w3.org/TR/wai-aria/'"""@en ;
    cav:refersTo camssa:17e3a9ef-abd1-47b9-a5af-f0bd5fd47572 .

camssa:b21525ce-fea7-4084-8f86-912ce15d07cb a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-7a18abe4842e04b608025fd70e54c3db5c2a10130c0dab0495479e7d5effb55d ;
    cav:value "1" .

camssa:b2179d96-0a39-4da5-a281-03dfc502c247 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of FTP is not related to e-accessibility. Therefore this criterion is considered not applicable to this specification.\r
\r
FTP Specification Reference:\r
https://datatracker.ietf.org/doc/html/rfc959'"""@en ;
    cav:refersTo camssa:afb530c6-4047-4103-886f-6b4af1a84a4b .

camssa:b22003a8-89f3-49fb-ae9a-99b368b6f863 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The specification is not related to the publication of public data as open data. Therefore this criterion is not applicable to this specification."@en ;
    cav:refersTo camssa:3295026c-627d-41ce-9bd5-dfe37a1d1504 .

camssa:b2226bd7-2a1a-4808-abf3-c5d2ba1c2c50 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XHTML has some features to prevent possible security vulnerabilities. Moreover, by allowing to exchange
data via online websites, XHTML fosters the secure and trustworthy data exchange between administrations
and stakeholders.

XHTML W3C reference:
https://www.w3.org/TR/xhtml1/'"""@en ;
    cav:refersTo camssa:0d48420c-188e-4894-ae73-c4f8013b2a77 .

camssa:b2256775-17e6-411b-9a3f-0ae2832627a9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'DNS over HTTPS (DoH) is designed to be extensible, enabling the addition of new features, options, or improvements over time. This extensibility is crucial for accommodating evolving requirements, addressing new challenges, and incorporating feedback from the user community. DoH uses option codes to enable the inclusion of additional parameters or features in DNS queries and responses and provides a flexible structure that allows for the inclusion of extensions while maintaining compatibility with existing implementations.

DoH specification: https://datatracker.ietf.org/doc/html/rfc8484'"""@en ;
    cav:refersTo camssa:8bb2e5e5-5b43-4610-868a-4e128b2d4483 .

