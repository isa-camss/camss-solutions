    cav:value "0" .

camssa:f8ca5e7c-e7ce-4e26-8b76-022380b8be11 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The PROV family of documents can facilitate the modeling of business processes to some extent by providing concepts such as activities, agents, and dependency relationships. It supports the documentation and traceability of data and activities, aiding in the understanding, analysis, and improvement of business processes.\r
\r
PROV Primer document:\r
https://www.w3.org/TR/prov-primer/\r
\r
PROV Ontology:\r
https://www.w3.org/TR/2013/REC-prov-o-20130430/\r
\r
PROV Data Model:\r
https://www.w3.org/TR/2013/REC-prov-dm-20130430/'"""@en ;
    cav:refersTo camssa:9e700e7d-bb61-4159-989b-c0d9098be3c1 .

camssa:f8cda138-0c60-4202-8e1b-501efa4e1ec1 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Schema.org is open to any interested party who has agreed to the W3C Community Contributor License Agreement (CLA) (see Schema.org homepage reference, Community Group and Steering Group section). The CLA provisions refer to the W3C Patent Policy, which covers the availability of schema.org with any restrictions related to fair, reasonable and non-discriminatory ((F)RAND) rights.\r
\r
Schema.org homepage reference, Community Group and Steering Group section:\r
https://schema.org/docs/about.html\r
\r
W3C Patent Policy reference:\r
https://www.w3.org/TR/patent-practice#ref-AC\r
'"""@en ;
    cav:refersTo camssa:6b36bc8e-4694-4c50-a088-22ee0950c85c .

