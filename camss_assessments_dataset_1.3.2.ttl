camssa:aaea9898-9159-47cc-ab1d-9f5cb384f1e7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'One of the main purpose of the DPV is to model the legal aspects of data portability, in order to link them with more technical aspects of electronic data echange.  DPV suggests mechanisms for the data to be protected, and data transfers in contexts where cross-border exchange is needed. DPV data model is flexible and can be modified according to the laws applying in each particular time, therefore, supporting the evolution of European public services.\r
\r
DPV specification: \r
https://w3c.github.io/dpv/dpv/\r
\r
DPV primer document:\r
https://w3c.github.io/dpv/primer/#introduction'"""@en ;
    cav:refersTo camssa:0074f124-2018-4ef6-a44d-c0826f42cf8c .

camssa:aaed233e-dad0-4e31-863f-43f2b42f3ae9 a cav:Score,
