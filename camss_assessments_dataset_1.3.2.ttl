    cav:assignedTo sc:c-624bc49501d58649e27cae4fb89fb5a56844685e54c5ce1625633894f8f752e1 ;
    cav:value "1" .

camssa:1942dde6-6f9d-4f5f-aa2d-9dcec4636648 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "After carrying out an exhaustive research, no evidence has been found of an established agreement between organisations involved in European public services provision. "@en ;
    cav:refersTo camssa:0041c1c4-5545-44b3-a3b2-dfa38e28fd27 .

