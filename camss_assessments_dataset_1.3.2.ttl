camssa:e0b0435d-f297-4346-a18c-d9031a32c8aa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SAML 2.0 itself is primarily focused on authentication and expressing attributes and entitlements about subjects, rather than enforcing access controls on resources. Therefore, the specification neither addresses confidentiality nor prevents it.\r
\r
SAML 2.0 Reference:\r
http://docs.oasis-open.org/security/saml/Post2.0/sstc-saml-tech-overview-2.0.html'"""@en ;
    cav:refersTo camssa:97793420-8246-453b-92ec-bec8e6da46b2 .

