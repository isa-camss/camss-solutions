camssa:adf1d1b0-9c2d-49cf-a06a-c4a526b0db68 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The ISO 19005-1:2005 and ISO 19005-2:2011 which refer to PDF/A-1 and PDF/A-2 are not available for free for everyone to study. Payment is needed to reach access to the standard.\r
\r
PDF/A reference:\r
https://www.iso.org/standard/38920.html\r
https://www.iso.org/standard/50655.html"""@en ;
    cav:refersTo camssa:f0e3ff82-8a50-4d3b-bd48-e5550cd63b79 .

