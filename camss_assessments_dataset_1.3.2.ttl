    cav:assignedTo sc:c-cc5bd9a7d0b2acc7f246522414fd5f5d579b977180bb04fa60a545cb35dae90f ;
    cav:value "1" .

camssa:663f5378-317e-4baa-8ba4-1a1baa2f98c9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """FTPS was first published as a draft RFC in 1996, but the RFC was not finished until 2005. Since then, many implementations using FTPS have been done to secure FTP, which it proves that it is mature enough for the development of products and services.\r
\r
FTPS IETF reference:\r
https://tools.ietf.org/html/rfc4217"""@en ;
    cav:refersTo camssa:6ae16497-80d7-48d8-90f2-194a817cf832 .

camssa:66405c0d-5963-4da8-a26f-4e3865b00ea2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """XAdES (ISO 14533-2:2012) is not included in any Member States' catalogues of recommended specifications.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards"""@en ;
    cav:refersTo camssa:77ecec05-3b82-45f4-bd08-e201fa1d5964 .

camssa:66409ee8-7c8e-404a-976c-6259b3bce0f7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The specification's community is an active and growing community of individuals and organizations who are interested in the use and development of the Akoma Ntoso standard. It also has the support of the XML community as the AKN4EU specification is based on the XML.\r
                                                                                                                                                                                                                                                                                          AKN4EU reference:\r
https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/akn4eu\""""@en ;
    cav:refersTo camssa:2f9a24fe-d97f-4cf2-9a95-bec97cacc8e4 .

