camssa:f953544f-6012-41eb-80e2-0032ea47ef22 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The available information does not specifically mention any means for restriction of access to information
/data. Therefore, this criterion is considered not applicable to this specification.

OGC TrainingDML-AI Standard:
https://docs.ogc.org/is/23-008r3/23-008r3.html'"""@en ;
    cav:refersTo camssa:48708765-4e5c-4f2e-9791-31e535c7db46 .

