        owl:NamedIndividual ;
    cav:judgement """"There are some assessment evaluating the specification's digital solution effectiveness and efficiency which involve SMP2.0.\r
\r
OOTS eDelivery Access Point Reference:\r
https://ec.europa.eu/digital-building-blocks/wikis/pages/viewpage.action?pageId=647955048\""""@en ;
    cav:refersTo camssa:4ebf34a3-1df8-42b8-8303-ddf343bc9646 .

