    cav:value "20" .

camssa:44175ec4-f505-417f-a080-79ae64ec6cde a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of ebXML is not related to te-accessiblity. Therefore, this criterion is not applicable to this specification.\r
\r
ebXML reference:\r
http://docs.oasis-open.org/regrep/regrep-core/v4.0/os/regrep-core-overview-v4.0-os.html'"""@en ;
