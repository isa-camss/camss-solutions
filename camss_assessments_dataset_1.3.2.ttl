camssa:0fcc26ea-9a88-41b0-afed-e39ad558f1fc a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Although the Advanced Encryption Standard is designed to encrypt and securely store data, it is not related to the long-term preservation of electronic resources.

AES Standard Reference:
https://csrc.nist.gov/pubs/fips/197/final'"""@en ;
    cav:refersTo camssa:7b66c1d9-9418-449c-b131-b9eff248a375 .

camssa:0fcd27a4-35ae-48c9-b06e-dc712ed6843f a cav:Score,
        owl:NamedIndividual ;
