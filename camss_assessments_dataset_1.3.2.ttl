    cav:value "100" .

camssa:1bc92c74-add5-42c6-8626-4a4cc3ce2f40 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "'The specification is not included in any national catalogue of recommended specifications. '"@en ;
    cav:refersTo camssa:ace6f214-31f7-4493-9445-b6accc138245 .

camssa:1bcb9148-a35b-495e-b452-d00b06eed7c0 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """There are not many studies assessing the specification in terms of effectiveness and efficiency. The document provided is an empirical study on the testing of WS-BPEL web services in the current environment of web services based on the cloud. \r
\r
Study about WS-BPEL:\r
https://ieeexplore.ieee.org/document/8204552"""@en ;
    cav:refersTo camssa:40d813a5-c230-41a6-a890-75cd33680771 .

camssa:1bcd1835-8fa0-4676-9a8f-e7e18fd14c60 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'DNS Queries over HTTPS (DoH) is associated with EIRA ABB's in the EIRA Library of Interoperability Specifications (ELIS). More specifically, DoH is associated with the "Integrity Verification” ABB from the Technical Application view,  and the “Domain Name Service” ABB from the Technical-Infrastructure View.

EIRA Library of Interoperability Specifications (ELIS):
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss
/solution/elis/release/600rf'"""@en ;
    cav:refersTo camssa:6642727c-acd1-4464-a63f-55e05561cc08 .

