        owl:NamedIndividual ;
    cav:assignedTo sc:c-17bea234285e6e633e4e21105358610ad5f5f0eaaf82f4bd50cb64ec11538984 ;
    cav:value "1" .

camssa:c6d89c54-4a6c-455a-8fbe-2b4e303d0d19 a cav:Score,
