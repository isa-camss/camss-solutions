camssa:23e3d64f-b4bc-4691-aefa-0aeab5127b85 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The PROV family of documents allows for the reuse of relevant information by capturing and representing provenance information in a standardized and structured manner. It facilitates the capture of context, traceability, decision-making processes, and enables discovery and retrieval, supporting the reuse of data, processes, and decisions when needed.\r
\r
PROV Primer document:\r
https://www.w3.org/TR/prov-primer/\r
\r
PROV Ontology:\r
https://www.w3.org/TR/2013/REC-prov-o-20130430/\r
\r
PROV Data Model:\r
https://www.w3.org/TR/2013/REC-prov-dm-20130430/'"""@en ;
    cav:refersTo camssa:64e1cf48-ccd4-4c05-b32e-b4d0e9ec62c2 .

camssa:23e3e770-c790-4817-819c-16b42985330c a cav:Score,
