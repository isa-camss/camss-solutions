    cav:value "2" .

camssa:9ef61653-b0f6-47a3-aea8-e4d04ebf74b9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XSLT include facilities for adapting the output of a transformation to meet local expectations: examples include the formatting of numbers and dates, and the choice of collations for sorted output.

XSLT Reference:
https://www.w3.org/TR/xslt-30/#imp-def-feature'"""@en ;
    cav:refersTo camssa:61591a78-3f07-40cb-a954-e54cfe4143a8 .

camssa:9ef8ef68-b877-4250-9ed4-ba5886a2c880 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'E-ARK CSIP can be found at the webpage of its own development organisation, the European based DILCIS Board. Moreover, the board publishes all the necessary documentation in the github repository.\r
\r
DILCIS Board Github:\r
https://github.com/DILCISBoard/'"""@en ;
    cav:refersTo camssa:13172c94-7472-47c0-b7ff-cca5603dce7a .

camssa:9efc9eb8-55a9-4308-861e-8c8bfe58bd6d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ebXML RegRep is used within the EU TOOP project, which is an enabler of the Once-Only Principle and has currently three pilot studies in progress. A pilot is the Peppol Tool Directory, which stores and indexes data from different providers for searcheability purposes.\r
\r
Once-Only Principle reference:\r
https://ec.europa.eu/isa2/isa2conf18/once-only-principle-project-toop_en\r
\r
Peppol Tool Directory reference:\r
https://directory.acc.exchange.toop.eu/public/locale-en_US/menuitem-about'"""@en ;
    cav:refersTo camssa:84191e60-350e-497f-8af8-aa36c95d726f .

camssa:9f0494f3-734e-4a9c-9ddc-e0924950f9d1 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-ec3f8a897147f530040ab94fb9bbee9fdad56e7256b2ce6fbb63cf1465315d91 ;
    cav:value "100" .

