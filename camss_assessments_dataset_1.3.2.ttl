        owl:NamedIndividual ;
    cav:judgement "The purpose of SAML 2.0 is not related to the delivery of multilingual public services. Therefore, this criterion is not applicable to the specification."@en ;
    cav:refersTo camssa:dd1d0e66-b12f-4a34-bcda-ba7b50599391 .

