camssa:7062af12-8338-4df4-b04d-24e33e566a5f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SD-JWT is discussed across both specialised forums and general developer platforms such as Swift Forums or Github repositories._x000D_
_x000D_
Github Repositories:_x000D_
https://github.com/search?q=SD+jwt&type=repositories_x000D_
_x000D_
Swift Forums SD-JWT:_x000D_
https://forums.swift.org/t/sd-jwt-support-in-jwsetkit-privacy-preserving-credentials-for-swift/83748_x000D_
_x000D_
SD-JWT Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc9901.html'"""@en ;
    cav:refersTo camssa:35c59517-c08e-4d6e-b515-4c28ca1ad627 .

camssa:75c2840d-e293-4aff-a3e8-87afa158129f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SD-JWT specification is not included in any national catalogue of recommended specifications. However, it is used by many European countries and has also been adopted in different European projects. Therefore, this criterion is not applicable to this specification._x000D_
_x000D_
CAMSS List of Standards: _x000D_
https://interoperable-europe.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards_x000D_
_x000D_
SD-JWT Github References:_x000D_
https://github.com/search?q=SD+jwt&type=repositories_x000D_
_x000D_
SD-JWT Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc9901.html'"""@en ;
    cav:refersTo camssa:c5aa3eb0-19ab-4138-a1a9-bf5da55e270d .

camssa:7fe53706-709b-458b-8e51-d6ca3bfa7544 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-22c3c5b40201f4ab2cb64a2d34b7665f8d0d1562f2a3e1a493dd3312608c7537 ;
    cav:value "100"^^xsd:string .

camssa:801b47b4-f5c1-4e77-afed-775eb318ce25 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-9694ffda6be83e507b6d3395cb411581d91419db0107726873a0a9018eab6a54 ;
    cav:value "100"^^xsd:string .

camssa:851166d3-c1a9-49cc-9000-fc7b07398d67 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SD-JWT guarantees the authenticity and integrity of claims through the issuer’s digital signature (based on JWS), ensuring that the credential originates from a trusted issuer and has not been altered. When Key Binding (SD-JWT+KB) is used, the disclosed claims are cryptographically bound to the holder’s key, preventing replay or misuse and strengthening holder verification._x000D_
_x000D_
Integration of SD-JWT Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc9901.html#name-integrity-of-sd-jwts-and-sd_x000D_
_x000D_
SD-JWT Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc9901.html'"""@en ;
    cav:refersTo camssa:37a54ceb-5c3b-4761-92d3-d055af83e1b8 .

