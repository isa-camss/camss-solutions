camssa:8fd026e1-27bd-4ce3-9cb2-ca4d03121f3c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'TGF is designed to simplify the delivery of public services by promoting the use of digital technologies and best practices in government service delivery. The TGF emphasises the importance of creating user-centred digital solutions and services that are accessible, inclusive, and easy to use.\r
\r
TGF specification:\r
http://docs.oasis-open.org/tgf/TGF/v2.0/cs01/TGF-v2.0-cs01.html'"""@en ;
    cav:refersTo camssa:10ac91c5-f489-44ae-af85-171776f95ebf .

