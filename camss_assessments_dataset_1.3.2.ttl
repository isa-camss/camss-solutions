    cav:value "80" .

camssa:f23b605a-8f7e-4a17-bcba-34aacc0d9858 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Section 7.3.3 of the specification addresses language. It is mentioned that the "language" parameter may be 
specified by the originator to convey information about the natural language used inside the message. If it is 
specified, it must contain a language identifier as defined in BCP 47 [RFC4646].

Syslog Protocol Language: https://datatracker.ietf.org/doc/html/rfc5424#section-7.3.3
IETF RFC4646: https://datatracker.ietf.org/doc/html/rfc4646'"""@en ;
    cav:refersTo camssa:d47af1cd-29f0-45d0-a653-9a171dfc8117 .

camssa:f2414c48-29d9-4d69-9b4b-3afc11960156 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """SMP is maintained by OASIS which is an international community developing open standards. \r
\r
The specification:\r
https://docs.oasis-open.org/bdxr/bdx-smp/v2.0/cs02/bdx-smp-v2.0-cs02.html#_Toc30505000"""@en ;
    cav:refersTo camssa:b2277a16-31c4-4262-9111-aaa6b3fc67fe .

