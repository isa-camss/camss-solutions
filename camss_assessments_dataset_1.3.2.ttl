camssa:47a37f06-5490-4dcc-a640-192487f79fe8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "After carrying out information retrieval, no document or study has been found assessing the PAdES in terms of efficiency or effectiveness."@en ;
