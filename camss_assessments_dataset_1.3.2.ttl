    cav:value "100" .

camssa:12e0bf21-2d5c-402f-bd71-bc0c31f97b1b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of SHACL is not related to the reuse of information when needed. Therefore this criterion is considered not applicable to the specification.

