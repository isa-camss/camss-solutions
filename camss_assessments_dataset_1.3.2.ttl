camssa:f8edd2d8-63d9-470e-9286-c165335e1c12 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'JWS is not related to enable the visibility of administrative procedures, rules data, and services. Therefore, the criterion is not applicable to this specification._x000D_
_x000D_
JWS Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc7515.html'"""@en ;
    cav:refersTo camssa:cd6bcad5-1665-4be8-8bf5-b8dcd425e7c2 .

camssa:faf1edc4-de1d-4c79-97fd-c4e8486f6cf5 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3dd3a1fb1ac7d78d162dab36230e70a34459f38a795e765cc5fdd304c8c04907 ;
    cav:value "100"^^xsd:string .

camssa:ffdd2d89-7c43-453c-83c7-f7d3373f4635 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is not related to enable the e-accessibility. Therefore, this criterion is not applicable to this specification._x000D_
_x000D_
JWS Reference:_x000D_
https://www.rfc-editor.org/rfc/rfc7515.html'"""@en ;
