    cav:value "100" .

camssa:8b3d9781-48fe-4620-a5dd-10979f88ea9f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'By allowing the authentication for using services SAML 2.0 can contribute and promote the visibility of administrations by simplifying access to administrations’ services. Moreover, it can be used internally by public officers which enhances the decision-making process, but it is not its main purpose.   \r
\r
SAML 2.0 Reference:\r
http://docs.oasis-open.org/security/saml/Post2.0/sstc-saml-tech-overview-2.0.html'"""@en ;
    cav:refersTo camssa:7f64ed9a-873a-45ac-a0f5-701080d74416 .

