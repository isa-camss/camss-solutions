camssa:9403b3e4-752c-4527-bc6b-55b61b049c2b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are several existing mechanisms to assess JSON conformity. Different types of validators depending on users’ needs.\r
\r
TestBed JSON validation:\r
https://www.itb.ec.europa.eu/docs/guides/latest/validatingJSON/index.html\r
\r
JSON Test suite in Github: \r
https://github.com/nst/JSONTestSuite\r
\r
JSON Compare:\r
https://jsoncompare.com/#!/simple/\r
\r
JSON Formatter:\r
https://jsonformatter.curiousconcept.com/\r
'"""@en ;
    cav:refersTo camssa:8890cb99-3812-4ee0-92ec-f00a958089ea .

