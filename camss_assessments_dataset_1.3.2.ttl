    cav:assignedTo sc:c-0e9bb259b84413d890a0fd548e40f255bb983a3add2eb7a737283f711e23d523 ;
    cav:value "100" .

camssa:4559981e-db80-4fa4-aae8-e559987ae4f9 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-fb2c0a4ddb03b09ecd5450c5a1d6aeed4e51c2a0387709a95a89cd850a7dd180 ;
    cav:value "100" .

camssa:456249e9-db87-4da0-a86f-fbe3efc3ed5d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The IT Professionalism Europe (ITPE) publishes some analysis on the EN 16234-1 e-CF component in different sectors of the European economy. The e-Competence Framework is positively evaluated as an effective enabler of SME communications. \r
\r
IT Professionalism Europe (ITPE) reference, Reports & Publications section, 'e-CF for SME’s – competence need analysis' document:\r
https://itprofessionalism.org/app/uploads/2019/08/Competence-need-Analysis.pdf\""""@en ;
