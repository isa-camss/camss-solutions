    cav:assignedTo sc:c-22c3c5b40201f4ab2cb64a2d34b7665f8d0d1562f2a3e1a493dd3312608c7537 ;
    cav:value "100" .

camssa:eb51026c-ac1d-49c2-b4d9-32f40d5bf060 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The specification has been implemented in four different repository platforms as part of the early adoption process. \r
Although these tools are a successful proof of concept for the specification, they are not sufficient to consider that the specification has a significant market share of adoption due to the fact that three out of the four implementations have been performed by the Working Group developing the specifications\r
See:\r
Fedora Commons,\r
ICAT https://github.com/RDAResearchDataRepositoryInteropWG/icat-bagit-tool/tree/master/demo\r
DARIAH Repository https://github.com/RDAResearchDataRepositoryInteropWG/icat-bagit-tool\r
KIT Data Manager https://github.com/RDAResearchDataRepositoryInteropWG/kitdm-bagit-tool\r
"""@en ;
    cav:refersTo camssa:c648cecb-2769-421a-b7ca-8e3415ca586d .

