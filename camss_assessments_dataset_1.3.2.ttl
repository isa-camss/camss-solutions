camssa:996fa547-231c-488d-bde2-72f55f241171 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Estonia plans wide use of XBRL-GL: "In order to create necessary preconditions for data-driven reporting\r
with the public sector and enable companies to exchange machine-readable transaction information, the\r
standard XBRL Global Ledger Taxonomy framework has been confirmed. The same standard is\r
implemented also in the Estonian Tax and Customs Board “Aruandlus 3.0” (Reporting 3.0) project."\r
\r
https://www.mkm.ee/en/objectives-activities/real-time-economy/projects\r
http://www.baltic-course.com/eng/good_for_business/?doc=159557'"""@en ;
    cav:refersTo camssa:47c6e6fb-4c44-46f8-bfe4-3f8e96a5caee .

