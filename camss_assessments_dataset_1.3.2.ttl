camssa:61fa1ec4-92c2-4fe2-b4ee-b4f45d73bf12 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The SAML 2.0 specification itself is focused on authentication, authorization, and federated identity, not directly on modelling business processes. However, federated identity, which SAML supports, can significantly streamline business processes:\r
Federated identity allows users to use a single set of credentials to access multiple systems or applications across different organizations.\r
\r
SAML2.0 Reference:\r
http://docs.oasis-open.org/security/saml/Post2.0/sstc-saml-tech-overview-2.0.html'"""@en ;
    cav:refersTo camssa:ea31f45c-c3a2-4ed2-a85d-4cfbd084f8a0 .

