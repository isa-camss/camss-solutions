    cav:assignedTo sc:c-d9b9ce1d270550422a8ea6097d2ffa1d923267fd681c56280e3b7810a14a580a ;
    cav:value "100" .

camssa:b3f077d9-e639-4354-a184-01478a27d5a1 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of TIFF/IT is not related to e-accessibility. Therefore, this criterion is considered not applicable to this specification.\r
\r
TIFF/IT ISO reference:\r
https://www.iso.org/standard/34342.html"""@en ;
    cav:refersTo camssa:fbcba4ed-5482-43ab-b4cf-72f3daccff2b .

camssa:b3f3fe52-01a6-4924-9fff-d5c6f1260265 a cav:Score,
