    cav:assignedTo sc:c-25deb65536af2c7e82f921c56df2c7e21093b2c06fdddd63021b4bccea0b9cd7 ;
    cav:value "100" .

camssa:8231683d-7240-4774-9b37-fc043f8a6b66 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The ebXML specification is included in 1 Member State catalogue of recommended specifications. It Member State is Norway.

CAMSS List of Standards:
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards

ebXML RegRep OASIS reference:
https://docs.oasis-open.org/regrep/regrep-core/v4.0/os/regrep-core-overview-v4.0-os.html'"""@en ;
