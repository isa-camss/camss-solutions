camssa:dd1db120-0a2c-412e-9d79-dfc11b47686a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The EIF4SCC initiative is the first adaptation of the EIF specification to a local context, which seeks to\r
support local administrations and other actors with the challenges related to the provision of interoperability\r
services to citizens and businesses.\r
\r
EIF4SCC reference:\r
https://ec.europa.eu/isa2/actions/continuously-updating-european-interoperability-strategy_en'"""@en ;
    cav:refersTo camssa:f2fe3a66-5cfd-4b51-b637-ddedd3bba3bb .

