camssa:d821de67-72ec-43fc-bdde-854bcd84b628 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The EIF is a set of recommendations and provides guidance to European public administrations. This\r
specification does not rely on any specific platform, and therefore is platform agnostic.\r
\r
EIF reference, 'EIF brochure' document:\r
https://ec.europa.eu/isa2/eif_en\""""@en ;
    cav:refersTo camssa:2dd3cee5-a25d-4496-a470-d49dbab1275f .

