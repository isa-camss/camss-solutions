    cav:assignedTo sc:c-583a0f52df591048a41be40620830a70260e77855364174d91ba159970d8488e ;
    cav:value "100" .

camssa:664499b2-6aa4-40b7-8f44-3dff28d20802 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The specification has the support of European Member States developing e-Law solutions at national and European Solutions. ELI is within the focus of ISA2, which aims to fund and improve interoperability solutions across Europe. The Publications Office is also supporting implementations of ELI and the shareability of dedicated data sets.\r
\r
ELI reference:\r
https://eur-lex.europa.eu/eli-register/about.html\r
\r
EU Open Data portal: \r
https://data.europa.eu/euodp/en/data/group/eli?groups=eli\r
\r
ISA2 and ELI: \r
https://ec.europa.eu/isa2/news/eli-and-eli-dl-greater-interoperability-legislation_en"""@en ;
    cav:refersTo camssa:9dd93db9-3fbc-4238-8251-869ff879e969 .

camssa:664e96ff-a59a-423d-84ef-8d5b7aa5d39c a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-c8a79448e829e27f47318879de4899c3a6404aa66d7d8954e7a680cf6e5d1ca2 ;
    cav:value "100" .

camssa:667012fc-e483-4408-8891-acc8a8dbaa6f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"TGF provides guidance and best practices for designing and implementing digital service delivery channels that are aligned with citizens' needs and preferences, and that promote efficiency, transparency, and accessibility in government service delivery.\r
\r
TGF specification:\r
http://docs.oasis-open.org/tgf/TGF/v2.0/cs01/TGF-v2.0-cs01.html\""""@en ;
    cav:refersTo camssa:810bd1a7-c1ec-4a4a-bdb3-afd40c71dfcd .

camssa:667049d6-b7f4-4ac1-ad9c-7671adc45667 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Since the specification has been developed by European Institutions for its implementation across borders to increase interoperability, it can be considered that it is legally compliant. \r
\r
Moreover, the ELI is a key aspect to ensure the development and transposition of European legislation into National Laws and vice versa, helping to standardise regulation creation and development across the European territory. \r
\r
ELI reference:\r
https://eur-lex.europa.eu/eli-register/about.html\r
\r
ELI Testimonials:\r
https://eur-lex.europa.eu/eli-register/testimonials.html\r
\r
ELI highlights: \r
https://eur-lex.europa.eu/eli-register/index.html\r
"""@en ;
    cav:refersTo camssa:8166ee11-1e59-40dd-981c-eff065bb4f89 .

