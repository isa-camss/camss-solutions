        owl:NamedIndividual ;
    cav:judgement """The W3C Royalty-Free IPR licenses granted under the W3C Patent Policy apply to all W3C specifications, including XSD.\r
\r
See:\r
https://www.w3.org/TR/patent-practice#ref-AC """@en ;
    cav:refersTo camssa:c32a3cf8-020a-4c1b-8d90-b4ece19a81c4 .

