camssa:ed682de8-f896-443d-a325-d155095c639e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The standard provides security features that foster the trustworthy data exchange between administration and stakeholders. PDF protects in itself data integrity, but also provides capabilities to protect with passwords and user roles the access to the document. "@en ;
    cav:refersTo camssa:fde198b6-98cc-41b6-8dfd-39004d9164d3 .

