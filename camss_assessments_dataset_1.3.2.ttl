camssa:527c603f-4734-44aa-a24c-c0f6f5080afd a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Domibus can contribute to the comprehensibility of data and services by promoting standardized messaging, and including metadata withing messages, thus providing additional context about the data being exchanged. This metadata enhances comprehensibility by offering insights into the purpose, source, and content of the messages.\r
\r
Domibus specification:\r
https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/Domibus'"""@en ;
    cav:refersTo camssa:bd1bcc70-0f40-49f6-a06e-0fe12aef4c61 .

