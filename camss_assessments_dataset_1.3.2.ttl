camssa:b7de81d3-e5ad-488c-9609-36c34368557f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The OASIS Technical Committee, in charge of the development of TOSCA, operates under RF (royalty-free) on RAND (reasonable and non-discriminatory) Mode of the OASIS IPR Policy. Therefore, the specification is licensed on a Royalty-free basis.\r
\r
TOSCA reference, Notices section:\r
http://docs.oasis-open.org/tosca/TOSCA/v1.0/os/TOSCA-v1.0-os.html\r
\r
OASIS Intellectual Property Rights Policy, section 10.2.2:\r
https://www.oasis-open.org/policies-guidelines/ipr/'"""@en ;
    cav:refersTo camssa:5721ff7a-86b0-4e03-ba39-b22937998935 .

