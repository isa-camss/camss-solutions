    cav:value "1" .

camssa:8b3f069b-5d54-4e90-8c7c-6c9ab419de32 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of HTML is not related to the availability of interfaces with internal information systems. Therefore, this criterion is not applicable to this specification. \r
\r
HTML W3C reference:\r
https://www.w3.org/TR/html401/"""@en ;
    cav:refersTo camssa:d742c629-810a-4655-bf0d-c9c479fb4b40 .

camssa:8b3f61a0-d4dd-47b6-8628-137dcabae662 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """After checking the different standard catalogues at supra-national level, there is no evidence of the inclusion of OWL2 within any European catalogue of standards.\r
