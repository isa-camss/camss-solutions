        owl:NamedIndividual ;
    cav:assignedTo sc:c-812668363d8f0cc562041fae6c588e1555372bf0bf5c16835be996dd72070013 ;
    cav:value "100" .

camssa:7985baa2-b792-4b03-9f89-07219a231528 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The specification is associated with two EIRA's ABB in the EIRA Library of Interoperabiliy Specifications (ELIS). The specification is associated with the European Legal Act and Legal Act  ABBs in the Legal View, and the Legal Act Representation in the Semantic View.\r
\r
ELIS reference:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/solution/elis/release/v501\""""@en ;
    cav:refersTo camssa:b565977b-37e5-492d-beb6-eb986b903630 .

