        owl:NamedIndividual ;
    cav:assignedTo sc:c-29023937877d658f898d48a06b2648e283306a041137cc58af4f79f061e1de4b ;
    cav:value "100" .

camssa:463ca312-3c4d-49cf-836e-99e4f30a146f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """EuroVoc is publicly available for implementation and use for free on EuroVoc's webpage. Therefore, it can be reused by the organisations, administrations, open communities, etc. that developed it.\r
\r
EuroVoc webpage:\r
https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource/dataset/eurovoc"""@en ;
    cav:refersTo camssa:fa3cf27e-141a-40ec-bade-6889f6f4d2ae .

camssa:463cab69-0a9a-4c65-9e96-bd2592ea78af a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The PAdEs Baseline profile is a business domain agnostic specification, meaningch means that it can be reused in a context where eSignatures are needed to develop an activity or solution. "@en ;
    cav:refersTo camssa:c1b970dc-4ce7-45a0-b323-bb9e54b78594 .

