        owl:NamedIndividual ;
    cav:judgement """"Schema.org grants data processing permissions through the schema.org type DigitalDocumentPermission. Such metadata improves the reliability of processed data between citizens, businesses and public administrations.\r
\r
Schema.org homepage reference, 'About Schema.org' section:\r
https://schema.org/docs/about.html\""""@en ;
    cav:refersTo camssa:074293cc-f9fc-4e7c-b3c3-95f61b414f7d .

camssa:b3ced4af-146d-4861-b4ef-e679de7323f2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OASIS is a non-profit consortium that drives the development, convergence and adoption of open standards for the global information society. SAML 2.0 is developed and maintained by OASIS. It also has the support from CEF eID Services and the Connecting Europe Facility (CEF).\r
\r
OASIS Reference:\r
https://www.oasis-open.org/org\r
\r
Connecting Europe Facility (CEF) Community:\r
https://commission.europa.eu/funding-tenders/find-funding/eu-funding-programmes/connecting-europe-facility_en\r
\r
CEF eID Services\r
https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/eIDAS+eID+Profile\r
\r
'"""@en ;
    cav:refersTo camssa:feaa9c50-e74a-4817-8c16-9b7e611f3e74 .

camssa:b3cfcb32-cf37-43a7-af9b-05901bd4f1da a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-812668363d8f0cc562041fae6c588e1555372bf0bf5c16835be996dd72070013 ;
    cav:value "100" .

