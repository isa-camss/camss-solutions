    cav:value "100" .

camssa:440b2d3d-3146-4a94-96b4-22252fa9031d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The E-ARK has been a project funded by the European Commission, and has now become a standard used for the development of e-archiving solutions, therefore E-ARK CSIP is a European Standard.\r
\r
E-ARK CSIP specification:\r
https://earkcsip.dilcis.eu/#introduction\r
\r
e-archiving projects using CSIP:\r
https://www.eark-project.com/stories.html'"""@en ;
    cav:refersTo camssa:edc13945-b6d3-4af5-85f0-62d91404db69 .

