        owl:NamedIndividual ;
    cav:judgement "The purpose of CSV is not related to e-accessibility. Therefore, this criterion is not applicable to the specification. "@en ;
    cav:refersTo camssa:7f2c4233-4c91-4ff0-8f5e-2fc2dc5e4152 .

