    cav:assignedTo sc:c-9420538a5a92af199b492414dd056ab7134e456f005895261b1a5b15a3f2814e ;
    cav:value "100" .

camssa:12d64571-254f-4b27-bf98-ff85d5445d83 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'E-ARK CSIP is not related to e-accessibility, therefore this criterion is not applicable to the specification.\r
\r
E-ARK CSIP specification:\r
https://earkcsip.dilcis.eu/#introduction'"""@en ;
    cav:refersTo camssa:3733bc52-3092-40f8-9280-53e7f19d94f6 .

camssa:12d98ec8-3e0b-4461-8705-a2e2aa224b13 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISO/IEC 18844-1 has been found included in the European Cybersecurity Certification Scheme for Cloud Services (EUCS) project, which uses components from ISO/IEC 17788 and ISO/IEC 17789, standards from which ISO19944-1 is derived and extended.\r
\r
ISO/IEC 19944-1 specification:\r
https://www.iso.org/standard/60545.html\r
\r
EUCS project:\r
https://www.enisa.europa.eu/publications/eucs-cloud-service-scheme'"""@en ;
    cav:refersTo camssa:a5cf5d4d-b9e3-406d-86d9-1a47d24bf398 .

