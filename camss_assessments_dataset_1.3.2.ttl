camssa:7b1cd997-bf1b-40c7-9b93-87cec20a3c6a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The specification was carried out in 2004 and has been developed and maintained by OASIS. It has had one update version 1.1 in 2006. The last version contained significant changes."@en ;
    cav:refersTo camssa:989fef96-565c-490d-b1db-775edb416856 .

camssa:7b23adda-4606-4e55-b174-9c0c3726096a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XHTML does not ensure and enable data processing accuracy. Therefore, this criterion is not applicable to
the specification.

XHTML W3C reference:
https://www.w3.org/TR/xhtml1/'"""@en ;
    cav:refersTo camssa:c3597718-9ef0-403b-8e5d-cf9fb159a3ca .

