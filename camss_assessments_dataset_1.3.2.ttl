camssa:3957f538-4a9a-491c-a9a4-0c2ca8b71960 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The implementation of the Core Location Vocabulary can enhance and foster the provision of digital services, avoiding the non-digital document exchange. \r
\r
CLV Joinup reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-location-vocabulary"""@en ;
    cav:refersTo camssa:f3674d66-3cbf-44f4-950b-a479336ef063 .

camssa:395da0a7-ec2e-4f6e-95ff-ce5a8669242b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'CPSV-AP is included in the SEMIC community in Joinup. The Semantic Interoperability Community (SEMIC) develops solutions to help European public administrations perform seamless and meaningful cross-border and cross-domain data exchanges.\r
\r
CPSV-AP Joinup webpage:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/core-public-service-vocabulary-application-profile/release/22    \r
                                                                                                         \r
SEMIC working groups:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/about'"""@en ;
    cav:refersTo camssa:6be25de1-b651-433a-a8f4-c38e468d91a1 .

