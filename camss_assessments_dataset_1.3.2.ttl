        owl:NamedIndividual ;
    cav:judgement """'The purpose of this Core Vocabulary is not related to security and privacy of the data exchange. Therefore, this criterion is not applicable to this specification.\r
\r
CPSV-AP Joinup webpage:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/core-public-service-vocabulary-application-profile/release/22'"""@en ;
    cav:refersTo camssa:91b87122-625d-4f9f-a1ce-fd99d809210b .

