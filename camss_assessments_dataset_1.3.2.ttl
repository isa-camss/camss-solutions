        dcat:Distribution ;
    dcat:accessURL "http://data.europa.eu/w21/fb0a7ac5-0792-439b-927f-4e7647b08ba1"^^xsd:anyURI .

camssa:b0d48e60-6639-4d18-ab10-b3b754920d68 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """\r
The purpose of EuroVoc is not related to the modelling of business processes. Therefore, this criterion is not applicable to the specification. \r
"""@en ;
    cav:refersTo camssa:6d66a519-fd91-4c28-ad2e-db51334c01b9 .

camssa:b0d5bdc9-b855-4d6b-92e1-15d4f0a22c74 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "PNG defines a format extension to save image, but does not define a cross-sector reusable data model."@en ;
    cav:refersTo camssa:b8332f71-f864-478e-9c39-2016c4ff9d9c .

camssa:b0e1526a-47b9-4f42-bc30-54409a488d45 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """WSDL is included in 3 national catalogues of recommended specifications. They belong to the Netherlands, Spain, and Sweden. The National Interoperability Framework (NIF) of these Member States is fully aligned with at least 4 out of 5 sections of the European Interoperability Framework (EIF) according to the National Interoperability Framework Observatory (NIFO) factsheets.\r
See:\r
https://joinup.ec.europa.eu/collection/national-interoperability-framework-observatory-nifo/nifo-factsheets"""@en ;
    cav:refersTo camssa:ab666ae9-fba6-4c6a-9e77-5e426b74fb47 .

camssa:b0f0fa4e-8d56-40bf-b286-09f2294f71c5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The purpose of the specification is not related to defining organisational interoperability aspects. Therefore, the criterion is not applicable to this specification. "@en ;
    cav:refersTo camssa:20a68973-54de-4f19-bb01-339a4ff1c8e2 .

