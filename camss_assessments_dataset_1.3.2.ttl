    cav:value "100" .

camssa:be8d6c8e-6a5b-4668-974c-c8ad48191dc5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "CSV makes sure content is available on the web, structures data and makes it usable in a non-proprietary open format. Consequently the CSV fosters data portability as it makes available files for any system. "@en ;
