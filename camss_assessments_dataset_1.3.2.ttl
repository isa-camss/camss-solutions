camssa:dc550dae-111b-4732-8cc6-854cf61991b9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Core Location Vocabulary specification is developed by SEMIC, an European organisation. Therefore, the specification can be considered a European standard.

Core Location Vocabulary:
https://interoperable-europe.ec.europa.eu/collection/semic-support-centre/solution/core-location-vocabulary/release/100'"""@en ;
    cav:refersTo camssa:f5959762-c3eb-4303-b0c5-916f06ed3f01 .

camssa:dc57dd35-55c0-44e5-921c-fedc57c53e8b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "XSLT is a language for transforming XML documents facilitating the process of it. Consequently, the implementation of eSignatures reduces the administrative burdens of the administration."@en ;
    cav:refersTo camssa:24eb8d2a-3bbb-4820-a06a-1626d9c97967 .

