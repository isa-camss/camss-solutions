camssa:2d945634-0d39-4d1f-9456-d8a2aa4dc944 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The European Commission (EC) ISA2 Programme provides an Interoperability Testbed where Stakeholders\r
can freely test these validation artefacts. All the ESPD-EDM artefacts necessary to perform the validation\r
are set up in the testbed. Thus developers and integrators can test the validity of the ESPD-Request and\r
ESDP-Response XML instances by uploading the instances in the testbed and launching the validation.\r
\r
Interoperability Testbed:\r
https://joinup.ec.europa.eu/collection/interoperability-test-bed-repository/solution/interoperability-test-bed\r
\r
ESPD Technical Handbook testbed:\r
https://docs.ted.europa.eu/ESPD-EDM/latest/xml_technical_handbook.html#_interoperability_testbed'"""@en ;
    cav:refersTo camssa:25ffadab-d7a2-4e21-9c89-12b0192fb1f6 .

