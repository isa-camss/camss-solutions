camssa:6d48d27f-c0ca-4c90-b3e3-5fa0d13d85ac a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SAMM aims to help organisations analyse their current software security practices. By following and implementing SAMM European Institutions can improve and develop software that allows data portability ensuring maximum security on these information transactions._x000D_
_x000D_
SAMM reference:_x000D_
https://owaspsamm.org/about/'"""@en ;
    cav:refersTo camssa:9d87e0d1-a338-45fe-9fc7-187eb8a91726 .

