camssa:d60fd84c-3343-435c-aa24-7074a360c1c2 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Domibus provides means for restriction of access to information through its access control mechanisms, which allow to manage user roles, permissions, and access rights within the Domibus platfform. Interaction with specific information or functionalities can be managed by the access control settings.\r
\r
Domibus specification:\r
https://ec.europa.eu/digital-building-blocks/wikis/display/DIGITAL/Domibus\r
\r
AS4 specification:\r
http://docs.oasis-open.org/ebxml-msg/ebms/v3.0/profiles/AS4-profile/v1.0/AS4-profile-v1.0.html'"""@en ;
    cav:refersTo camssa:6d0bc2e6-2704-4003-89a2-8741004b8c45 .

camssa:d614141f-64de-4a1b-b09e-e84fc74705f9 a cav:Score,
