    cav:assignedTo sc:c-e225f44a0b0939b1b30a1ab03b2f38baeca8699c0cd44b4e39adbe19ffbb3542 ;
    cav:value "100" .

camssa:087f5068-fd74-43ee-974b-dc634ada1b95 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """SMP is not included in any Member States' catalogues of recommended specifications.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards"""@en ;
    cav:refersTo camssa:f534cde9-dc7f-4169-bcea-a706c9326842 .

