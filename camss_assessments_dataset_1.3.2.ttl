camssa:0c58310d-ee40-409b-96c9-406472baac2e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The main purpose of the specification is about Testing the Conformance and Interoperability of Trusted Lists, \r
so in each one of the test that are performed in the specification, conformance is assessed.\r
\r
ETSI TS 119 614-1 reference:\r
https://www.etsi.org/deliver/etsi_ts/119600_119699/11961401/01.01.01_60/ts_11961401v010101p.pdf'"""@en ;
    cav:refersTo camssa:29d5f9e0-e09b-403e-b9d9-e863fb6501cd .

camssa:0c598e27-b8f7-4323-befa-56b9ce24932f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The W3C Royalty-Free IPR licenses granted under the W3C Patent Policy apply to all W3C specifications, including SOAP 1.2.\r
\r
See:\r
https://www.w3.org/TR/patent-practice#ref-AC"""@en ;
    cav:refersTo camssa:83e13152-5069-4eb9-94ca-3aaaa31ad0db .

camssa:0c5aca2a-d3eb-44c8-89ff-cc890e224d65 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISO 639-2 cannot be changed, and therefore does not allow customisation.\r
\r
ISO 639-2 reference:\r
https://www.loc.gov/standards/iso639-2/'"""@en ;
    cav:refersTo camssa:102e0bf2-46a0-49d7-af29-8e715abe056b .

