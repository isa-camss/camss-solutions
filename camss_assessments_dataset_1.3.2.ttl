camssa:fada458c-8931-4c29-a86c-c1c8e399a265 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'DCAT is a domain-agnostic specification that can be reused for the description of any catalogue of dataset independently from the business domain addressed. For DCAT users having business-specific requirements, the specification is generally extended (e.g. StatDCAT-AP for statistical data).\r
\r
DCAT-AP Specification:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/200\r
\r
StatDCAT-AP:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/statdcat-application-profile-data-portals-europe/release/101'"""@en ;
    cav:refersTo camssa:b591aeb7-bc91-450a-8f4d-f61d60077eac .

