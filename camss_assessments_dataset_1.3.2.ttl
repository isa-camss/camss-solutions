    cav:value "1" .

camssa:0fcf0e1b-0528-4bfd-9238-8af3414bb8c8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """As  protocol for data exchange, FTP can be used for the exchange of documents solving administrative burden. Additionally, it can avoid the exchange of non-digital documents that are generally source of administrative burden.\r
\r
See: \r
https://tools.ietf.org/html/rfc959 """@en ;
    cav:refersTo camssa:8ee97962-1a6e-4169-af60-997ba7b6e5b7 .

camssa:0fd1acce-4021-4374-b701-f763a06fcd89 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-52e41801b0db7274d934a229fee15e657273655d70d448d16706fcbe0e4f9746 ;
    cav:value "100" .

camssa:0fd5011c-135c-4506-98ef-130cff710dae a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Xforms 2.0 is maintained by W3C which is an international community developing open standards. \r
\r
Developer community W3C:\r
https://www.w3.org/Consortium/"""@en ;
    cav:refersTo camssa:86a1ba79-c464-4bcc-8ad2-ef94d1486e50 .

