camssa:a22f2eac-2c86-4e58-8859-4c781ea4e3c7 a owl:NamedIndividual,
        dcat:Distribution ;
    dcat:accessURL "http://data.europa.eu/w21/0c07f9f6-6607-4117-9ca8-2b6b2cee7263"^^xsd:anyURI .

camssa:a80d6999-e6f4-4f86-adac-c620631cf14c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"XML is included in 17 national catalogues of recommended specifications. They belong to Bulgaria and Croatia, among others. The National Interoperability Framework (NIF) of Bulgaria and the Croatia are aligned with at least 3 out of 4 scoreboards of the EIF Monitoring according to the National Interoperability Framework Observatory (NIFO) factsheets._x000D_
_x000D_
CAMSS List of Standards:_x000D_
https://interoperable-europe.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards_x000D_
_x000D_
NIFO Factsheets:_x000D_
https://interoperable-europe.ec.europa.eu/collection/nifo-national-interoperability-framework-observatory/digital-public-administration-factsheets-2024_x000D_
_x000D_
Bulgaria's catalogue:_x000D_
https://www.mtitc.government.bg/upload/docs/2016-01/BNIF_EN.pdf_x000D_
_x000D_
Croatia's catalogue:_x000D_
https://ssi.gov.hr/en/catalogue_x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/\""""@en ;
    cav:refersTo camssa:5d3bc77b-66cd-45f9-a6d4-361ad302cd23 .

camssa:ab54788d-272e-4963-80b6-f92536f5f0b3 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-c2d03f19521389763921ce9c758a3697caa22bed98c2c11c3b10344b11c468bb ;
    cav:value "80"^^xsd:string .

camssa:ac0ed21c-4f92-42d4-a298-3a867f45e816 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-69e927013383f3944a629c01e930a6663b8304aa5f3137b9a5de3c02d34da401 ;
    cav:value "100"^^xsd:string .

camssa:acb4e0d0-5d75-4ab3-8240-8a9d15a0e3b9 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-0e9bb259b84413d890a0fd548e40f255bb983a3add2eb7a737283f711e23d523 ;
    cav:value "100"^^xsd:string .

camssa:afa7bfe5-7741-4f8a-a865-43e054ddba7b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The XML specification itself does not provide built-in mechanisms to guarantee the authenticity of the agents involved in data transactions. In systems based on XML exchanges, this is achieved using other specifications, such as XML Signature Syntax and Processing, which is based on XML and developed by W3C. This specification provides a method for digitally endorsing an XML file, allowing authentication of the sender and verification of data integrity._x000D_
_x000D_
Another related specification is XAdES, which extends XML Signature Syntax and Processing by supporting the long-term validity of signatures in accordance with Directive 1999/93/EC of the European Parliament and of the Council of 13 December 1999 on a Community framework for electronic signatures._x000D_
_x000D_
W3C XML Signature Syntax and Processing:_x000D_
https://www.w3.org/TR/xmldsig-core/_x000D_
_x000D_
XML Advanced Electronic Signatures (XAdES) reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31913201/01.03.01_60/en_31913201v010301p.pdf_x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:ab54788d-272e-4963-80b6-f92536f5f0b3 .

camssa:aff47574-bfd3-49f6-90fb-3d0a5004b884 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-50ab6a29689585b917f7b2972d2c41e8c8c52723c2d58eb9b92109c938d4e825 ;
    cav:value "100"^^xsd:string .

camssa:b018e668-2ff4-4ae1-8dd5-6a5837fd060f a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-17a2b7a0ca372f407c300b69049faf9d92cbf274964290ba278b18cf10bf5dbf ;
    cav:value "100"^^xsd:string .

camssa:b0e3fb13-3b61-497c-9be8-0ebf4ff1e914 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The XML specification itself does not provide inherent protection against unauthorised changes to the information it represents. In this sense, XML depends on the implementation of related elements. Thus, specifications such as the XML Signature Syntax and Processing and the XML Encryption Syntax and Processing can be applied to achieve a more robust protection mechanism, ensuring that data is inaccessible to third parties or unauthorised users._x000D_
_x000D_
W3C XML Signature Syntax and Processing:_x000D_
https://www.w3.org/TR/xmldsig-core/_x000D_
_x000D_
W3C XML Encryption Syntax and Processing:_x000D_
https://www.w3.org/TR/xmlenc-core1/_x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:24cc4a89-a296-4c1f-9aff-47cbec59dfd8 .

camssa:b66bf2fe-33c1-48d9-a1c6-edf38df94e6c a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-e225f44a0b0939b1b30a1ab03b2f38baeca8699c0cd44b4e39adbe19ffbb3542 ;
    cav:value "100"^^xsd:string .

camssa:b682a7c5-ea0d-4bd2-8a2c-5e40b6e0d28d a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d2c939f8f97b2a02c254da4add5fcbea1311d465178344adc029d82366a0f642 ;
    cav:value "100"^^xsd:string .

camssa:c15df20e-21e9-458c-9cf1-1a79e3f29303 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XML is already associated to EIRA ABBs in the EIRA Library of Interoperability Specifications (ELIS). More specifically, XML can define the interoperability aspects of the "Data Representation" and "Knowledge" ABBs of the EIRA Semantic View._x000D_
_x000D_
EIRA Library of Interoperability Specifications (ELIS):_x000D_
https://interoperable-europe.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/solution/elis/release/611_x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:dbfc4f7f-d39e-4c3a-abdb-7c60f883995d .

camssa:c70b91fe-0b8f-4ee7-99ba-77c8240bcf3e a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-0b00b9b74de866ed2278d14d1b9d7ecf2c06950d296bb2f17013c7b710d6de41 ;
    cav:value "100"^^xsd:string .

camssa:c7216a90-53df-4e01-bdf6-ab5bc030a99b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XML is used to encode all communications between web services. Therefore, it fosters the visibility and comprehensibility of public administrations data and services. XML allows the separation of information through tags and attributes, making the structure clearer and easier to understand for users working with the data._x000D_
An example of such application is the eForms service for Public procurement standards on the European Union._x000D_
_x000D_
eForms reference:_x000D_
https://docs.ted.europa.eu/eforms/latest/schema/introduction.html_x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:22ccf30a-5ae6-4cc3-8f02-735c4fa25e77 .

camssa:c809a6e5-c5c3-40aa-b537-0470af8ca38f a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
    cav:value "100"^^xsd:string .

camssa:c930e330-2fb5-4f48-b2c6-7a4e0a3a0e85 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification does not allow customisation on the syntax. However, although the default attributes of XML can not be changed, new attributes and tags can be created and modified to meet specific needs._x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:d764edbc-acb5-49dd-a8c2-3e36bd37a378 .

camssa:c9ff7c44-9019-4800-9082-38621008870c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The efficiency of the XML specification has been assessed by the Southern University of Science and Technology (China) and the National University of Singapore (Singapore). In the "Finding XPath Bugs in XML Document Processors via Differential Testing" study, XML is addressed as the essential data format on which the processors under test operate, with meticulous attention to its structure and the controlled generation of XML documents to create effective test cases._x000D_
_x000D_
"Finding XPath Bugs in XML Document Processors via Differential Testing" study:_x000D_
https://dl.acm.org/doi/10.1145/3597503.3639208_x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:b682a7c5-ea0d-4bd2-8a2c-5e40b6e0d28d .

camssa:ce3fcdde-c067-407f-beaf-150a4ad2f14f a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3b3b2febe9a7e3ad44bdefc47b0bbcafc7a2e677e9570d6ad822efbe1f7d41e2 ;
    cav:value "100"^^xsd:string .

camssa:d3cf7f23-99a8-4afe-aff7-994404225609 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a16c678a586cf542d2ae1d6cd8a987bd6ed0b2af52ba0e04d8872fe616a9b7bd ;
    cav:value "100"^^xsd:string .

camssa:d4982d07-b3cc-4da6-9239-8e55416cced2 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a6184fb705cfed44856c7b9594b492926f7a63a128a5a2be7b896294d8c79838 ;
    cav:value "100"^^xsd:string .

camssa:d5f669eb-b3f3-4a39-8e60-4c88f415ec9c a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-f53dee88cf8529a93a68be781005e903c270057da1a72e2f89e8cb154be0c51b ;
    cav:value "100"^^xsd:string .

camssa:d64f2503-c831-4eae-a5fc-952fae2912af a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XML is a markup language designed for structuring and representing data, enabling the exchange and storage of information in a standardised format. To ensure a higher degree of personal data protection managed by public administrations, the specification can be combined with the XML Encryption Syntax and Processing specification, which allows data to be encrypted while in transit, ensuring that only authorised parties can access it. In this way, personal data remains protected._x000D_
_x000D_
XML Encryption Syntax and Processing reference:_x000D_
https://www.w3.org/TR/xmlenc-core1/_x000D_
_x000D_
XML 1.1 W3C  reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:9cf00248-d246-4789-9a0c-0fc9f42f9f76 .

camssa:d6bfa6ab-c8df-48b6-9708-da109767885b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Apart from XAdES, the specification is used in the European Single Procurement Document (ESPD), which uses XML 1.0 to standardise information exchange in public procurement, significantly reducing administrative burden for businesses across member states._x000D_
_x000D_
ESPD reference:_x000D_
https://ec.europa.eu/isa2/solutions/european-single-procurement-document-espd_en/ _x000D_
_x000D_
XML Advanced Electronic Signatures (XAdES) reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31913201/01.03.01_60/en_31913201v010301p.pdf_x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:d4982d07-b3cc-4da6-9239-8e55416cced2 .

camssa:d764edbc-acb5-49dd-a8c2-3e36bd37a378 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d9b9ce1d270550422a8ea6097d2ffa1d923267fd681c56280e3b7810a14a580a ;
    cav:value "20"^^xsd:string .

camssa:dbfc4f7f-d39e-4c3a-abdb-7c60f883995d a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-583a0f52df591048a41be40620830a70260e77855364174d91ba159970d8488e ;
    cav:value "100"^^xsd:string .

camssa:ddf9ea6c-1152-40b0-83d1-bea03838b8bb a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-b71e04068a444f6ee23c0863df43f19957762528381d6edece40e35c0efab242 ;
    cav:value "100"^^xsd:string .

camssa:e5e0297c-f947-485f-b661-a48122edba54 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Although the specification defines the core syntax and parsing rules that all XML documents must follow, components such as attributes and tags can be created and extended to meet specific needs. Therefore, the specification allows for extension._x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:c809a6e5-c5c3-40aa-b537-0470af8ca38f .

camssa:e8f78d4f-2dcc-4435-a441-2e7f42342687 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XML acts as a common, platform-independent language for data exchange. By defining standardised XML schemas (vocabularies) for specific public service domains (e.g., procurement, social security, health), different systems can exchange data in a mutually understandable format. This is crucial for cross-border services and for connecting different government agencies within a single country._x000D_
_x000D_
Examples include the European Single Procurement Document (ESPD), which uses XML to standardise information exchange in public procurement, significantly reducing administrative burden for businesses across member states. It is worth mentioning that ESPD uses XML 1.0 but given the nature of the project and its long development it is normal to use the 1.0 version._x000D_
_x000D_
ESPD reference:_x000D_
https://ec.europa.eu/isa2/solutions/european-single-procurement-document-espd_en/_x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:2ecf7cca-f979-4003-ac37-c2e15c96d5d0 .

camssa:e92b12b8-22cf-4b66-8e8c-9affc20b4f11 a cav:Score,
        owl:NamedIndividual ;
    cav:value "92.38%AssessmentScoreAverage"^^xsd:string,
        "100%StrengthOfAssessmentScoreAverage"^^xsd:string .

camssa:f18cdf58-72fa-47b5-a7d9-af5b77e10409 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'W3C has a defined and publicly available Process for the Development and approval process of the specification as a recommended standard. Also, a clear Release Notes tracking the changes of the different versions is archived.

W3C Process document:
https://www.w3.org/2018/Process-20180201/#Policies'"""@en ;
    cav:refersTo camssa:267c4451-5475-41cd-a60b-cac046b7af7b .

camssa:f4f9cce3-723f-4a99-9995-c44e8772d035 a cav:Score,
