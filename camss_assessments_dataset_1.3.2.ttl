    cav:value "1" .

camssa:a6a75a6c-7800-4b85-93ea-da867f943621 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """JPEG is a valuable image format for sharing information through the internet between administrations and stakeholders in a graphical manner. Allowing sharing data and information the standard foster the visibility of administration data and services. Fostering the collaboration between public administrations, the specification eases the decision-making process of institutions.\r
\r
JEPG ISO reference:\r
https://www.iso.org/standard/18902.html\r
\r
JPEG public reference:\r
https://jpeg.org/jpeg/"""@en ;
    cav:refersTo camssa:63a68b92-f0ff-4385-b0d9-9dbd98f89da3 .

camssa:a6a7b609-99d5-4374-b29c-f77a7ff9bea0 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a60f86e868fe2bdcf0c5c47111455d1d5b59498172688e36f23a77baa347d916 ;
    cav:value "100" .

