        owl:NamedIndividual ;
    cav:judgement """'The purpose of ISO 639-2 is not related to security and privacy of the data exchange. Therefore, this criterion is not applicable to this specification.\r
\r
ISO 639-2 reference:\r
https://www.iso.org/standard/4767.html'"""@en ;
    cav:refersTo camssa:b5d257a1-7442-4f9d-a542-71bddd125c33 .

