camssa:9393fb79-18fa-4f58-92d1-2fa8897c47db a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """XAdES is independent of any software, hardware, or operating system. So it can be said that the specification is independent of any specific technology or platform. \r
\r
XAdES ISO reference:\r
https://www.iso.org/standard/56025.html\r
\r
XAdES ETSI reference:\r
https://www.etsi.org/deliver/etsi_ts/101900_101999/101903/01.04.02_60/ts_101903v010402p.pdf"""@en ;
    cav:refersTo camssa:064d59b1-fcfe-4e72-b41b-83d8c934b4af .

