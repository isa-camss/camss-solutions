        owl:NamedIndividual ;
    cav:judgement """'The purpose of OData is not related to the modelling of business processes. Therefore, this criterion is not applicable to the specification. \r
\r
OData reference:\r
https://docs.oasis-open.org/odata/odata/v4.01/odata-v4.01-part1-protocol.html'"""@en ;
    cav:refersTo camssa:c6a77275-ae4d-47fd-b6a8-ebbe654ed47b .

