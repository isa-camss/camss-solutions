camssa:f3b5d6c8-e50c-4cee-8b96-552a242224aa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "By describing web services in terms of functionalities and accessibility to them, WSDL fosters the visibility of administration web services for the reusing of existing applications by other administrations and stakeholders."@en ;
    cav:refersTo camssa:30d0680a-316d-49b2-9ac9-54ddc83cd64f .

