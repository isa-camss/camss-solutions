    cav:value "100" .

camssa:7f4b1410-eb7f-4cb6-8fb8-10a858ef8186 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """This standard is licensed CC-0, which essentially means that the project, along with the contributions, is in the public domain in whatever jurisdiction possible, and everyone can do whatever they want with it.\r
\r
The Standard for Public Code webpage:\r
https://standard.publiccode.net/"""@en ;
    cav:refersTo camssa:e95ccbf4-0de4-4e0d-87dd-0adbc239c95b .

camssa:7f6354ac-dbaf-41fc-9d58-d368d72ed7f5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are several studies assessing ShEx efficiency when it comes to modelling and validating RDF graphs. For example, there has been found an interesting study assessing the efficiency of ShEx when it comes to create subsets of knowledge graphs.  \r
\r
Creating Knowledge Graphs Subsets using Shape Expressions:\r
https://arxiv.org/abs/2110.11709\r
\r
Using Shape Expressions (ShEx) to Share RDF Data Models and to Guide Curation with Rigorous Validation:\r
https://link.springer.com/chapter/10.1007/978-3-030-21348-0_39'"""@en ;
    cav:refersTo camssa:7aa858ec-5f92-4306-95a7-acb69943bfa8 .

