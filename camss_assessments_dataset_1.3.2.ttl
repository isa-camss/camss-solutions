camssa:f29939a5-2c47-477e-9fe5-412f99cf41ab a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of TS 119 614-1 is not related to ensuring the protection of personal data managed by public \r
administrations. Therefore, this criterion is not applicable to the specification. \r
\r
ETSI TS 119 614-1 reference:\r
https://www.etsi.org/deliver/etsi_ts/119600_119699/11961401/01.01.01_60/ts_11961401v010101p.pdf'"""@en ;
    cav:refersTo camssa:2df3f43c-9c29-4660-8d41-1eab22f885f5 .

