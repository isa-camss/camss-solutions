        owl:NamedIndividual ;
    cav:judgement """'DCAT-AP is a common format fot data exchange that supports the sharing, discovery and reuse of public sector data, therefore, it can enable digital service delivery channels.\r
\r
DCAT-AP Specification:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/200'"""@en ;
    cav:refersTo camssa:524d018a-7449-49e2-9a15-78b1123c6862 .

