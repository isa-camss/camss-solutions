camssa:0b0d6710-63c6-4b48-a552-1bde7a47b038 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'By allowing the exchange of datasets metadata, DCAT increases the searchability, visibility, discoverability, comprehensibility and reuse of existing data, including information on processes and administrative rules.      \r
                                                                                                     \r
DCAT (v2.0.0) reference:             \r
https://www.w3.org/TR/vocab-dcat-2/ '"""@en ;
    cav:refersTo camssa:786b882a-6ea7-4152-a3f4-b7e84b51ee9a .

