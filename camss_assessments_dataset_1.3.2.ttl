        owl:NamedIndividual ;
    cav:judgement """'ISO standards are not licensed on a royalty-free basis since they require an initial payment for accessing it\r
and using it. Moreover, conformance testing requires payment in some cases.\r
\r
ISO 27001 foreword:\r
https://www.iso.org/obp/ui/#iso:std:54534:en'"""@en ;
    cav:refersTo camssa:43bfe11c-bc2e-49c7-a57b-e46166519532 .

