camssa:f8647a34-10db-46d5-8b7c-58b1e7216b21 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Apache License 2.0 is known for being permissive and allowing users to freely use, modify, and distribute the software. It does not impose restrictions on how the software can be used in proprietary or open-source projects. Furthermore, International Data Space - Global is licensed under License Creative Commons Attribution 4.0 International, which permits almost any use subject to providing credit and license notice.\r
\r
License Creative Commons Attribution 4.0 International: https://github.com/International-Data-Spaces-Association/IDS-G/blob/main/LICENSE.md\r
\r
Apache 2.0: https://www.apache.org/licenses/LICENSE-2.0'"""@en ;
    cav:refersTo camssa:4ed6c9b6-ba7f-40b8-9856-448aa64384c8 .

