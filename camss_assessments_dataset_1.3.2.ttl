    cav:value "100"^^xsd:string .

camssa:24cc4a89-a296-4c1f-9aff-47cbec59dfd8 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-5a7323988b5d96da801e2abd4d95248af758fe9adbbafd09dd76114629567ff4 ;
    cav:value "80"^^xsd:string .

camssa:267c4451-5475-41cd-a60b-cac046b7af7b a cav:Score,
        owl:NamedIndividual ;
