camssa:1fc0a775-9f9e-4268-b6e4-b941838fefc9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"There is a reference study on the de facto implementation of the EIF components, where a section is dedicated\r
to the effectiveness of the EIF components. Besides, there are assessments produced by arbitrary\r
stakeholders (public representatives) from different Member States directly addressing the specification's\r
effectiveness (see 'EIF evaluation and strategy' initiative); however, these assessments are not finely\r
structured, and as a consequence the reader needs to consult different stakeholder inputs.\r
\r
EIF components evaluation, page 35:\r
https://op.europa.eu/en/publication-detail/-/publication/29d694d4-4696-11ec-89db-01aa75ed71a1/languageen\r
\r
EIF evaluation and strategy, Feedback section:\r
https://ec.europa.eu/info/law/better-regulation/have-your-say/initiatives/12579-European-Interoperability-\r
Framework-EIF-evaluation-and-EU-governments-interoperability-strategy\""""@en ;
    cav:refersTo camssa:82cef204-ef23-412d-8f4a-029417cf2a5a .

