camssa:2b41ae6e-5144-417a-bb9d-ad32866c9ce4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The SHACL specification allows to introduce modelling techniques and also conduct processes in alignment with delivery standards.

SHACL W3C reference:
https://www.w3.org/TR/shacl/'"""@en ;
    cav:refersTo camssa:07c02b5e-e731-4740-a7f5-bc161b36953f .

