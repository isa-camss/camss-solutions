        owl:NamedIndividual ;
    cav:assignedTo sc:c-50ab6a29689585b917f7b2972d2c41e8c8c52723c2d58eb9b92109c938d4e825 ;
    cav:value "100" .

camssa:aeec768c-3ab2-4e6c-9b0d-55d56d069a89 a cav:Score,
