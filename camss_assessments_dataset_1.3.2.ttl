        owl:NamedIndividual ;
    cav:judgement """'The purpose of NFVI is not related to e-accessibility. Therefore, this criterion is considered not applicable to this specification.\r
\r
NFVI Deliver, Infrastructure Overview section 4:\r
https://www.etsi.org/deliver/etsi_gs/NFV-INF/001_099/001/01.01.01_60/'"""@en ;
    cav:refersTo camssa:6bc1fca2-730c-4e7a-8ede-69e38c9076a0 .

camssa:176d5118-19af-4cf1-9992-ec7adb485a37 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OSI is independent of any platform and can be implemented without dependencies with technologies.
Furthermore, OSI is designed to support information system interconnection, enhancing interoperability by definition.

OSI reference
https://www.iso.org/standard/20269.html'"""@en ;
    cav:refersTo camssa:0f402113-f324-44a1-b0c6-3230c8f29115 .

camssa:176e207b-9701-47ea-996e-f35fadf6f604 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-29023937877d658f898d48a06b2648e283306a041137cc58af4f79f061e1de4b ;
