camssa:3b32cff4-9bd1-4c00-8d1b-83c5d18bcaec a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The W3C Verifiable Credentials specification allows for customization to a certain extent. This means that users can tailor the structure of the credentials to their specific needs. For example, if they are dealing with educational credentials, they might define a credential type specific to educational achievements.\r
\r
Verifiable Credentials: \r
https://www.w3.org/TR/vc-data-model/'"""@en ;
    cav:refersTo camssa:df6ca80c-a6bf-4e80-8e87-0c1d14a54850 .

