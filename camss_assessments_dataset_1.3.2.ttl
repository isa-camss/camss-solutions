camssa:9e3a9278-790b-4042-afc4-643e8371b21c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'the CEF Digital eArchiving project aims to create a model that keeps important information accessible and reusable over long periods of time. The E-ARK specifications are used in this solution for describing the most common principles and requirements for the preservation of information packages.\r
\r
CEF Digital e-archiving:\r
https://digital-strategy.ec.europa.eu/en/activities/earchiving'"""@en ;
    cav:refersTo camssa:37bb6deb-abe9-4f13-b85a-b0facfff34af .

camssa:9e3ac27a-8156-4528-80da-2451750bb76a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The Core Public Service Vocabulary Application Profile is publicly available for implementation and use for free on Joinup's webpage. Therefore, it can be reused by the organisations, administrations, open communities, etc. that developed it.\r
\r
CPSV-AP reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-public-service-vocabulary-application-profile"""@en ;
    cav:refersTo camssa:3833001f-19de-4ddf-8351-8b844491dcc4 .

