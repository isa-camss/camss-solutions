        owl:NamedIndividual ;
    cav:judgement """'Verifiable Credentials can play a role in facilitating organizational interoperability agreements, particularly in the context of identity management and secure exchange of private personal data.\r
\r
Verifiable Credentials: \r
https://www.w3.org/TR/vc-data-model/'"""@en ;
    cav:refersTo camssa:c66b38b9-686e-4b86-bd72-a4476e2f021c .

