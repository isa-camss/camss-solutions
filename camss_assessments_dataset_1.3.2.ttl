camssa:cc0b4afa-fd80-4001-86ba-a7cf832ccbec a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The purpose of XSD 1.1 is not related to define organisational interoperability aspects. Therefore this criterion is considered not applicable to this specification."@en ;
    cav:refersTo camssa:293175de-92ec-4125-834d-09b2fce0d5a6 .

