camssa:9e55bd83-418c-40bf-beb3-9d2c29ec03b9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISO 3166-1 provides a collection of codes for the names of countries, dependent territories and special areas of geographical interest, regardless of any specific domain. Therefore, the specification can be implemented in any domain.\r
\r
ISO 3166-1 reference:\r
https://www.iso.org/standard/72482.html '"""@en ;
    cav:refersTo camssa:adb22f5a-4dfd-4b3e-8fbc-7569648ae7c3 .

camssa:9e5debef-6a55-4b44-92f2-896e374e9004 a cav:Score,
