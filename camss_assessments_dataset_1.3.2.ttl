    cav:assignedTo sc:c-3671439b412291ce208a0ade6313c64aeb2942059c7543ca39322c56458bcf96 ;
    cav:value "1" .

camssa:16891e34-5fee-4175-87a5-b11f37db4ae7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Semantic Interoperability Community (SEMIC) develops solutions to help European public administrations perform seamless and meaningful cross-border and cross-domain data exchanges. They develop semantic specifications and interoperability solutions under the ISA² Programme. When a new solution release is finished, it is submitted for a public review with a minimum period of four weeks.\r
\r
Specification development process by the ISA Programme:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/document/description-change-management-release-and-publication-process-structural-metadata-specifications\r
\r
Detailed document ISA Programme:\r
https://joinup.ec.europa.eu/sites/default/files/document/2016-10/description_of_a_change_management_release_and_publication_process_for_structural_metadata_specifications_developed_by_the_isa_progr.pdf'"""@en ;
    cav:refersTo camssa:d5112e15-7ce9-4b8a-9594-3aab2942288e .

camssa:168e5f7e-7b8b-445b-93d8-a86116cfc357 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-f53dee88cf8529a93a68be781005e903c270057da1a72e2f89e8cb154be0c51b ;
    cav:value "80" .

camssa:16916bb0-9e9b-42e5-a4eb-59ed056ebeaf a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SCIM plays a foundational role in identity management, and its implementation can contribute to digital service delivery channels. Efficient identity provisioning and management through SCIM can support operations for creating, updating, and deactivating user identities, ensuring that users can quickly access and utilise digital services.

SCIM: https://scim.cloud/'"""@en ;
    cav:refersTo camssa:b073a43c-1c38-40a8-a16d-57060ce454bb .

camssa:16916cc2-6b01-4e5e-9542-c9ca857f04f3 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The business domain in which the specification was developed was mainly the legal resources, political/administrative and contract management. It can be applied across sectors since the management of these aspects and the interaction between normative institutions and stakeholders are based and regulated by legal text and resources.  \r
\r
LegalRuleML reference:\r
http://docs.oasis-open.org/legalruleml/legalruleml-core-spec/v1.0/legalruleml-core-spec-v1.0.html"""@en ;
    cav:refersTo camssa:8b47f5f4-005b-43ac-88dc-e1b2b83aa772 .

