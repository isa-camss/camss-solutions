    cav:value "100" .

camssa:1e1d20fe-3b40-413e-91d2-bb8367a5bffa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The DPV is based on the legislative requirements of the European Union, such as the GDPR, which aims to harmonize data privacy laws across Europe.  Therefore, the DPV promotes the comprehensibility of administrative procedures by providing a clear vocabulary that defines all levels at which personal data will be processed.\r
\r
DPV specification: \r
https://w3c.github.io/dpv/dpv/\r
\r
DPV primer document:\r
https://w3c.github.io/dpv/primer/#introduction\r
\r
GDPR reference:\r
https://gdpr.eu/'"""@en ;
    cav:refersTo camssa:4f3d3e6e-0489-4f66-b9d4-249f147be32b .

camssa:1e1f4ba2-6886-48c1-9fc5-ec298532b0b8 a cav:Score,
