camssa:89d959ce-b170-40f0-9e74-e979a437f10c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'An important aspect of UBL design is its support for customization to meet the needs of individual organizations while maintaining complete interoperability within the standard framework. To suit the requirements of specific relationships, data structures of arbitrary complexity can be added to UBL documents without breaking XML validation against the standard schemas.\r
\r
UBL v2.3 reference:\r
http://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html\r
\r
Developer community OASIS. UBL functionalities:\r
https://www.oasis-open.org/committees/tc_home.php?wg_abbrev=ubl#functionality\r
\r
UBL Guidelines for customization:\r
https://docs.oasis-open.org/ubl/guidelines/UBL2-Customization1.0cs01.pdf'"""@en ;
    cav:refersTo camssa:b6e43218-f86c-4daa-a83e-b3d2e4289b37 .

