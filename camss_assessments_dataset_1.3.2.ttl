    cav:assignedTo sc:c-c265ca0c56e0f29a34039d496ba707b5486ccf6d445f9f058c19b4ece977861f ;
    cav:value "2" .

camssa:d41c5109-a291-42d3-9179-48351e446ee8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of this specification is not related to security and privacy of the data exchange. Therefore, this criterion is not applicable to this specification.

LDES specification: 
https://joinup.ec.europa.eu/collection/semic-support-centre/linked-data-event-streams-ldes'"""@en ;
    cav:refersTo camssa:1720fac8-b031-441f-8729-f27abc75dea9 .

camssa:d42d4e45-b0d9-4151-a511-b2a4a5b4eedb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """ODF was initially published by OASIS, an international organisation aimed to develop open standards and specifications. Afterwards, it was standardised by ISO, which is also an international organisation with standardisation purposes. Moreover, the specification has the support of the Document Foundation, which is in charge of evolving the LibreOffice. \r
\r
The Document Foundation:\r
https://wiki.documentfoundation.org/ODF \r
\r
ODF ISO reference:\r
https://www.iso.org/standard/66363.html\r
\r
ODF OASIS reference:\r
https://www.oasis-open.org/committees/tc_home.php?wg_abbrev=office"""@en ;
    cav:refersTo camssa:372419b9-6667-4e5a-ba9e-c939fe63e7e0 .

camssa:d42e3fe3-55ab-4b39-a138-c24f79cb3a01 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The OASIS Technical Committee, in charge of the development of WS-BPEL, operates under RF on RAND Mode of the OASIS IPR Policy. The specification is licensed on a Royalty-free and (F)RAND basis.\r
\r
OASIS IPR:\r
https://www.oasis-open.org/committees/security/ipr.php\r
https://www.oasis-open.org/policies-guidelines/ipr"""@en ;
    cav:refersTo camssa:cab6c9de-35a8-4cb0-83bb-a8c6202ecbac .

