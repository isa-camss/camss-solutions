    cav:assignedTo sc:c-0e9bb259b84413d890a0fd548e40f255bb983a3add2eb7a737283f711e23d523 ;
    cav:value "100" .

camssa:0fd83efc-f34b-4698-b942-1c6dbbb3ba07 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The OASIS TC in charge of LegalRuleML operates under the Royalty Free on Limited Terms IPR mode as defined in the OASIS Intellectual Property Rights (IPR) Policy.\r
\r
LegalRuleML reference:\r
http://docs.oasis-open.org/legalruleml/legalruleml-core-spec/v1.0/legalruleml-core-spec-v1.0.html"""@en ;
    cav:refersTo camssa:9a773827-0ab6-4932-b2d9-bb2f5830dd7d .

camssa:0fddf1b4-8127-44af-ab0a-53dd37bdf7b8 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-19c639047dab46befb5839503733c8f1e7ed8278f788a089d11d2caee84a8f7c ;
    cav:value "2" .

