camssa:5751e5b7-1410-4d6b-90d1-ad8ab9dc2515 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There is no Member State that includes schema.org in their national catalogue with The National Interoperability Framework (NIF) in alignment with the three categories: 1. Conceptual model for integrated public services provision, 2. interoperability layers, and 3. interoperability principles.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards'"""@en ;
    cav:refersTo camssa:643b8e92-42b8-41af-af0c-ff6d15f4b2f0 .

camssa:5757e484-c5b8-4e5e-8dc2-6afb81a138a5 a cav:Score,
