camssa:4889ee2f-81bf-422a-bd88-188cb13c9807 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"In the specification's documentation there is a specific part where is mentions the extension of SMP and the use of it as optional.\r
\r
SMP OASIS reference:\r
https://docs.oasis-open.org/bdxr/bdx-smp/v2.0/cs02/bdx-smp-v2.0-cs02.html#_Toc30505009\""""@en ;
    cav:refersTo camssa:93c78ec8-c7b6-4779-863f-b51009dbaaec .

camssa:488cca7b-7f7c-478f-a06f-7a6544012b1f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Asset Administration Shell (AAS) has specific provisions regarding encryption of data shared among partners that allow the confidentiality of data. Specifically the specification encrypts the data once it is packed. Furthermore, the specification also allows third party extensions to conform to more strict encryption.

Security aspects of the Asset Administration Shell:
https://admin-shell-io.github.io/aas-specs-antora/IDTA-01004/v3.0/introduction.html

Details of the Asset Administration Shell (AAS)
https://industrialdigitaltwin.org/en/wp-content/uploads/sites/2/2024/06/IDTA-01001-3-0-1_SpecificationAssetAdministrationShell_Part1_Metamodel.pdf'"""@en ;
    cav:refersTo camssa:29d7e321-e51b-4d21-8ca1-b46b69c080fb .

camssa:488d081f-8d6f-4a38-8d59-6b7673d23328 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-9b3cb1ef128e2a87386258a5812c05b520024e6e4a404d1f1d6f0e35707e8a7b ;
    cav:value "100" .

camssa:48937621-7ba2-480e-9a7d-16f2519b341f a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d9b9ce1d270550422a8ea6097d2ffa1d923267fd681c56280e3b7810a14a580a ;
    cav:value "20" .

