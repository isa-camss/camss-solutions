        owl:NamedIndividual ;
    cav:judgement "No formal agreement has been found established between organisations or administrations involved in European public service provision including the usage of WS-BPEL."@en ;
    cav:refersTo camssa:7197eef9-e629-448e-b824-4aa06a78b38d .

