        owl:NamedIndividual ;
    cav:judgement """SOAP 1.2 is available for free at the European Collaborative platform for the development of ICT solutions. \r
See: \r
https://joinup.ec.europa.eu/solution/soap-version-12-part-0-primer"""@en ;
    cav:refersTo camssa:857e8d0f-05d8-4081-8679-821a3fda5c18 .

