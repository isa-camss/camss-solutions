    cav:assignedTo sc:c-3beae22dd24b0dbc955ce74a9fe755390983d8436a45b401461ceaaa7a5d1609 ;
    cav:value "100" .

camssa:843eefea-6082-4e34-82d2-09105bd64c1a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"In accordance with Common Patent Policy for ITU-T/ITU-R/ISO/IEC the ISO 3166-1 is licensed under (F)RAND basis. Although there are terms included that allow patent holder to apply specific costs. It is defined in IPR disclosures that can be found at ISO's webpage. \r
\r
ISO patents:\r
https://www.iso.org/iso-standards-and-patents.html \r
\r
ISO standards and patents IPR database:\r
http://isotc.iso.org/livelink/livelink/13622347/Patents_database.xls?func=doc.Fetch&nodeId=13622347 \""""@en ;
    cav:refersTo camssa:dc809d0e-2b1e-485f-bf4a-323ab4b2bd4b .

