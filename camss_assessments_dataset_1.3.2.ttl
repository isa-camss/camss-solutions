    cav:assignedTo sc:c-9b3cb1ef128e2a87386258a5812c05b520024e6e4a404d1f1d6f0e35707e8a7b ;
    cav:value "20" .

camssa:9347bf15-aeaa-43fb-8b36-4d5915f03ccb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OAS includes support for REST APIs.  A RESTful API is a clear enabler of the exposure of interfaces, given that it performs information exchange with secure, reliable and efficient software communication standards.\r
\r
OAS specification:\r
https://spec.openapis.org/oas/latest.html#openapi-specification\r
\r
OAS in Github:\r
https://github.com/OAI/OpenAPI-Specification/#participation'"""@en ;
    cav:refersTo camssa:3271566a-2357-4040-81e8-291f3cf0610a .

camssa:93562f6c-9efd-4591-91c9-96545b053e5b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'IETF is a vendor neutral SDO. However, FTP relies on TCP to ensure that all data exchanged is sent correctly to the proper destination.\r
\r
FTP Specification Reference:\r
https://tools.ietf.org/html/rfc959\r
\r
Transmission Control Protocol (TCP) Reference:\r
https://tools.ietf.org/html/rfc793'"""@en ;
    cav:refersTo camssa:93214f48-03c4-40f5-a625-c7adb64039a9 .

