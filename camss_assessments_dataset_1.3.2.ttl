camssa:5541df10-0d9f-4c65-b07d-02fab2b5a30e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There is no Member State that includes Core Criterion and Core Evidence Vocabulary in their national catalogue with the National Interoperability Framework (NIF) aligned with at least 2 out of 3 sections of the European Interoperability Framework (EIF) according to the National Interoperability Framework Observatory (NIFO) factsheets.\r
\r
NIFO factsheets:\r
https://joinup.ec.europa.eu/collection/nifo-national-interoperability-framework-observatory/digital-public-administration-factsheets-2022\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards   '"""@en ;
    cav:refersTo camssa:bc195783-e13e-42ff-bb63-59381ac1678d .

camssa:5543ede6-c294-4324-a4e0-3cf12e11664a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'EN 303 645 is associated to the consumer IoT devices domain and is not intended to be used in other domains. Therefore, the specification does not allow customisation. \r
\r
EN 303 645 reference:\r
https://www.etsi.org/deliver/etsi_en/303600_303699/303645/02.01.01_60/en_303645v020101p.pdf'"""@en ;
    cav:refersTo camssa:e178b190-c542-4045-834d-a8906f04840e .

