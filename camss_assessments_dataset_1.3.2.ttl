    cav:assignedTo sc:c-4ac14cafe608f1dbe7e48f96edd7574c55f0aac2c2e99ede0418dae7225977af ;
    cav:value "1" .

camssa:928e594c-8239-4708-bbdc-3f19657bb51f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XSLT can contribute to the reuse of information. However, this is a limited functionality since the specification only enables the reuse of some pieces of data be means of variables.

XSLT Reference:
https://www.w3.org/TR/xslt-30'"""@en ;
    cav:refersTo camssa:470eab57-6ad6-48f1-aedf-c41ec2b4ae90 .

