\r
Catalogue reference Norway:\r
https://www.difi.no/fagomrader-og-tjenester/digitalisering-og-samordning/standarder\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards'"""@en ;
    cav:refersTo camssa:dbead966-0314-42ac-9b92-c2005ab2fa4f .

