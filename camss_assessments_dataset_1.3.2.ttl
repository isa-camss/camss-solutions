        owl:NamedIndividual ;
    cav:judgement """'REM is a type of electronic registered delivery, which increases usability and ensures integrity, confidentiality \r
and non-repudiation and protects against the risk of loss, theft, damage and any illegitimate modification.\r
\r
ETSI EN 319 532-3 reference:\r
https://www.etsi.org/deliver/etsi_en/319500_319599/31953203/01.02.01_60/en_31953203v010201p.pdf'"""@en ;
    cav:refersTo camssa:9ea7579d-4554-41f9-bae9-5d909572b623 .

