        owl:NamedIndividual ;
    cav:assignedTo sc:c-cc272cd8a2e3e9c5e4edaa5ac7d59735c377a9db89d6958335a2cf0538761ab3 ;
    cav:value "20" .

camssa:394ae282-f940-4ff2-a9a5-99c4448b0d2c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of PDF/A is not related to the delivery of multilingual public services. Therefore, this criterion is not applicable to this specification. \r
\r
PDF/A reference:\r
https://www.iso.org/standard/38920.html\r
https://www.iso.org/standard/50655.html"""@en ;
