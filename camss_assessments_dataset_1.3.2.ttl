        owl:NamedIndividual ;
    cav:judgement """'The SAML 2.0 specification is recognized and integrated in several initiatives at both European and national levels, especially those concerning identity management, privacy, and electronic transactions such as eIDAS.\r
\r
eIDAS Reference:\r
https://digital-strategy.ec.europa.eu/es/policies/eidas-regulation\r
\r
SAML 2.0 Reference:\r
http://docs.oasis-open.org/security/saml/Post2.0/sstc-saml-tech-overview-2.0.html'"""@en ;
    cav:refersTo camssa:61561c25-2355-4574-b221-046b070ea4de .

