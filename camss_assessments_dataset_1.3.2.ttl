    cav:assignedTo sc:c-0b00b9b74de866ed2278d14d1b9d7ecf2c06950d296bb2f17013c7b710d6de41 ;
    cav:value "100" .

camssa:84c7bdb9-b76c-4f17-97d4-a2c6ff5f7580 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """3 Member States are recommending OWL2 in their ICT National Catalogues. This Member States are France, the Netherlands and Spain.\r
\r
National catalogue France:\r
http://references.modernisation.gouv.fr/sites/default/files/Referentiel_General_Interoperabilite_V2.pdf\r
\r
National catalogue the Netherlands: \r
https://www.forumstandaardisatie.nl/open-standaarden\r
\r
National catalogue Spain:\r
https://administracionelectronica.gob.es/pae_Home/pae_Estrategias/pae_Interoperabilidad_Inicio/pae_Normas_tecnicas_de_interoperabilidad.html#CATALOGOESTANDARES"""@en ;
    cav:refersTo camssa:bced8230-b39b-4946-9c17-94ca442fc21b .

