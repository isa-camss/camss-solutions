camssa:5e1556f0-9c55-4b7f-b640-a66294770407 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'On September 9th, 2024, eIDAS adopted TLS 1.3 as a required protocol within its framework. The eIDAS Regulation, is a key European Union regulation aimed at ensuring secure and seamless digital interactions across member states. It establishes standards for electronic identification and trust services, enabling businesses, citizens, and public authorities to carry out secure cross-border transactions. By adopting TLS 1.3, eIDAS reinforces its commitment to the protection of digital communications.

eIDAS Regulation Reference:
https://digital-strategy.ec.europa.eu/en/policies/eidas-regulation

eIDAS eID Profile Reference:
https://ec.europa.eu/digital-building-blocks/sites/display/DIGITAL/eIDAS+eID+Profile

eIDAS eID Profile Cryptographic Reference:
https://ec.europa.eu/digital-building-blocks/sites/download/attachments/467109280/eIDAS%20Cryptographic%20Requirement%20v.1.4.1_final.pdf?version=2&modificationDate=1729176493701&api=v2'"""@en ;
    cav:refersTo camssa:d0f35ce0-3461-4512-a3a5-978d3b683a7e .

camssa:5e160535-de32-4a90-b1b8-dc638c09a73c a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-c2d03f19521389763921ce9c758a3697caa22bed98c2c11c3b10344b11c468bb ;
    cav:value "80" .

