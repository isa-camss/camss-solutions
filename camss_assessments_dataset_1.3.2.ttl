        owl:NamedIndividual ;
    cav:assignedTo sc:c-ffdbd22af1ff3c1ebb100043d062a3df160007af761caf0a8c9f50f02e609c9e ;
    cav:value "1" .

camssa:ac0b2e9b-eda0-4f5c-858f-51a045cc9e57 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
