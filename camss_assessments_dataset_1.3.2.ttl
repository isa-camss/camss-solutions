    cav:value "20" .

camssa:378422e8-2215-4f8e-87a3-977c023f9c9c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of XACML is not related to the long-term preservation of electronic records and other kinds of 
information. Therefore, this criterion is not applicable to the specification.

XACML OASIS reference:
https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html'"""@en ;
    cav:refersTo camssa:0e5ca165-dc58-4134-90e9-9aab6b93ac8f .

camssa:378dc108-0ef8-41a1-9cd6-77b1f1ceb570 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-5879b43fc249f0098f3ed687235f432f71bf0c11bd3aa95e063dfdacd64606c8 ;
    cav:value "1" .

camssa:3792bd83-18fb-46b6-8c54-821764ad1fa8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SHACL can be effectively used in systems that control access to information or data. In this context, the specification can establish a type of an access control using SHACL-ACL to determine the access to data, and make it more secure. 

"SHACL-ACL: Access Control with SHACL" study:
https://link.springer.com/chapter/10.1007/978-3-031-43458-7_4

SHACL W3C reference:
https://www.w3.org/TR/shacl/'"""@en ;
    cav:refersTo camssa:2bb8b70a-577b-4d46-9d2d-ca223b0ba72f .

