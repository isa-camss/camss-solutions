        owl:NamedIndividual ;
    cav:judgement "XSLT does not provide a cross sector reusable data model. The specification transforms XML documents into other formats."@en ;
    cav:refersTo camssa:e5233f2a-cf58-4591-ac0c-048d63dc2911 .

