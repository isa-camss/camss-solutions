camssa:2088291d-ae17-4a0c-a948-185049297209 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'CAdES guarantees that signed data on electronic format remains authentic, integral, and legally defensible when transmitted or archived. CAdES signatures, especially when based on Qualified Certificates (which are common in Public Administrations under eIDAS), link the document directly to a verified identity._x000D_
_x000D_
CAdES reference:_x000D_
https://www.etsi.org/deliver/etsi_en/319100_319199/31912201/01.03.01_60/en_31912201v010301p.pdf'"""@en ;
    cav:refersTo camssa:0f5a66b7-adb2-4848-85a3-58c96821632b .

