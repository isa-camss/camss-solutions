    cav:assignedTo sc:c-8c0e1d9d02fa1d534bed0962df3492708c99afbc6343ac8dc671bbabae75aca2 ;
    cav:value "None" .

camssa:fe908197-50fe-4be1-9577-64c84a4d3454 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The purpose of SOAP 1.2 is not related to security and privacy. Therefore, this criterion is not applicable to the specification."@en ;
    cav:refersTo camssa:2b5f8ef7-a348-4479-9031-e36130a5654b .

camssa:fe94e821-20f6-4659-af24-eb2593401dea a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Ogg does not provide for any generic encryption or signing of itself or its contained content. However, it is also possible to add an external security mechanism that encrypts or signs an Ogg physical bitstream and thus provides content confidentiality and authenticity.\r
\r
Ogg XIPH reference:\r
https://xiph.org/ogg/doc/rfc3533.txt"""@en ;
    cav:refersTo camssa:9d7afe62-9650-4e18-94eb-076ce6b111bd .

camssa:fe96db11-4699-4d0e-b8a5-1318d8ad067f a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-812668363d8f0cc562041fae6c588e1555372bf0bf5c16835be996dd72070013 ;
    cav:value "20" .

camssa:fe972b20-7794-4322-9c89-37f51f232fcc a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """ETSI has provided a conformance testing tool for electronic signatures according to the European Commission Mandate 460. The conformity testing tool involves different standards applied in the development of eSignatures, including PAdES, CAdES, XAdES, and ASiC ant their respective Baseline profiles. \r
\r
See:\r
https://signatures-conformance-checker.etsi.org/pub/ASiCConformanceTestChecker_v1.0.pdf\r
https://signatures-conformance-checker.etsi.org/pub/index.shtml"""@en ;
    cav:refersTo camssa:7e092bf5-a251-477e-8828-40abae99575b .

camssa:fe9a2d43-68dc-4ae4-9f26-f8b531efb303 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Like all the IETF standards, this specification is a free and open technical specification, built on IETF standards and licenses from the Open Web Foundation. Therefore it is licensed on a royalty-free basis.\r
No IPR disclosures have been submitted directly on this RFC.\r
\r
Intellectual Property Rights in IETF:\r
https://tools.ietf.org/doc/html/rfc8179'"""@en ;
    cav:refersTo camssa:ddba8bb2-b47d-4a1d-b752-f865dc3a6861 .

