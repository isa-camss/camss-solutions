camssa:e4056963-602d-4530-a541-8a8161b59c60 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """There is a code validator for WS-BPEL that helps developers create well-formed, valid and standard-compliant code. The code is checked for errors and the user is notified if validation fails.\r
 \r
The WS-BPEL Validator: \r
https://docs.oracle.com/cd/E19182-01/821-0539/cnfg_bpel-guide-validation_r/index.html"""@en ;
    cav:refersTo camssa:65539ea7-053c-4000-b78c-e4e2fe42b170 .

