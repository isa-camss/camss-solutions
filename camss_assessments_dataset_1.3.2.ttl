    cav:assignedTo sc:c-d520eae57650560dd54723cdcdd166243c9a0b1458a4afdc331175b5c1cada7e ;
    cav:value "100" .

camssa:86bf030b-ec83-4d3b-ad41-ed64b8a8a622 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'OAS defines a standard, programming language-agnostic interface description for HTTP APIs, which allows both humans and computers to discover and understand the capabilities of a service without requiring access to source code, additional documentation, or inspection of network traffic. OAS usefulness, therefore, lies in the  comprehensibility of the APIs development, as it facilitates coding and also documenting the development in an easy, understandable way.\r
\r
OAS specification:\r
https://spec.openapis.org/oas/latest.html#openapi-specification\r
\r
OAS in Github:\r
https://github.com/OAI/OpenAPI-Specification/#participation\r
'"""@en ;
    cav:refersTo camssa:1673150e-34db-45a3-b0b0-cbc6d0d577b7 .

