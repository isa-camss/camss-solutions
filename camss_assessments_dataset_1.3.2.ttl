    cav:refersTo camssa:7f6763da-7f4a-4075-9ca0-458392cb32e8 .

camssa:160de17b-6476-4c32-82a3-b9ac0dfef3de a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'SFIA is intended to serve as a device to represent skills and competences of any ICT professional workforce. There is no possibility of tailoring the SFIA specification, nor any kind of authorising process is allowed, since SFIA has a single purpose.\r
\r
SFIA reference:\r
https://sfia-online.org/en/sfia-8'"""@en ;
    cav:refersTo camssa:104f5d02-723d-4208-b4ce-14ea74822297 .

