    cav:assignedTo sc:c-7a18abe4842e04b608025fd70e54c3db5c2a10130c0dab0495479e7d5effb55d ;
    cav:value "0" .

camssa:d6d2c90f-ef3c-4498-8042-1fb69fae4f0e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The Core Location Vocabulary is a business domain agnostic specification that can be reused in a cross-domain way.\r
\r
CLV Joinup reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-location-vocabulary"""@en ;
    cav:refersTo camssa:617c387d-b4e7-4b74-9f12-31d4bc7cddbe .

camssa:d6d93e32-38a5-4aec-9c97-e2bd27fca110 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of SOAP 1.2 is to store, transport and exchange data through interoperable systems. Moreover, SOAP 1.2 uses XML which defines a set of rules for encoding documents in a human-readable format and machine-readable format enhancing the reusability of data and stimulating the interoperability of systems and services.  \r
\r
Additionally, W3C develops its specification independently from any vendor. Thus, the adoption of SOAP 1.2 does not hamper the data portability of data expressed with it. In fact, the adoption of SOAP endorses the binding and invoking of web services allowing data exchange across borders.\r
\r
SOAP Reference:\r
https://www.w3.org/TR/soap12/'"""@en ;
    cav:refersTo camssa:207f84c3-2221-4ec1-a429-faf185ccca14 .

camssa:d6dd5905-1975-4040-a8ae-b72264f2e6cb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """CAdES Baseline is available for free at the ETSI’s Catalogue of Standards. It can be found at ETSI’s webpage. \r
See:\r
https://www.etsi.org/standards#page=1&search=ETSI%20TS%20103%20173&title=1&etsiNumber=1&content=1&version=0&onApproval=1&published=1&historical=1&startDate=1988-01-15&endDate=2020-01-08&harmonized=0&keyword=&TB=&stdType=&frequency=&mandate=&collection=&sort=1"""@en ;
    cav:refersTo camssa:12aa82d4-8183-4f0f-a8fd-2a62260ef1b6 .

camssa:d6e19c26-5e66-42a2-9bcc-706846dda306 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-b37687b8bb3dbd4c6f96969358cf5d70900d1ccd01402cea7668da6303bec4b4 ;
    cav:value "60" .

camssa:d6e571ac-689d-45ba-89d9-d0b0a5df6cc3 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The CPOV eases the description and publication of datasets including information of different public organisations, their services and responsibilities. These descriptions are done using human-readable formats which ease the reusability and the information exchange across-borders. 

CPOV Joinup reference:
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-public-organisation-vocabulary

5-star linked open data:
https://www.w3.org/DesignIssues/LinkedData.html'"""@en ;
    cav:refersTo camssa:b062f011-bbe1-49e5-a565-304e7073c74e .

camssa:d6e5a491-5e86-420f-a665-e7a501ee0e41 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The recommendation is aiming to achieve seamless interoperability, trust, and ultimately to provide growth and employment opportunities by facilitating data exchange across organisations, disciplines and geographical borders."@en ;
    cav:refersTo camssa:03216a3b-e881-432b-a310-29d6d2670c2f .

