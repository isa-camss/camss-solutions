camssa:dca4e073-7bfc-49ac-81ec-9abf99ae477c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"DAPS can simplify the delivery of European public services as it offers a technique to modulate access to certain data in International Data Spaces, which aligns with Europe's vision of data.\r
\r
DAPS: https://github.com/International-Data-Spaces-Association/IDS-G/tree/main/Components/IdentityProvider/DAPS\""""@en ;
    cav:refersTo camssa:ee915aac-a9f4-4f13-b934-b84d6a6743ec .

