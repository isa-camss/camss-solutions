    cav:value "100" .

camssa:eaa65c7d-1e13-413d-98bc-cab73e5114c5 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-624bc49501d58649e27cae4fb89fb5a56844685e54c5ce1625633894f8f752e1 ;
    cav:value "2" .

