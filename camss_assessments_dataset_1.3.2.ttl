camssa:59578920-a5f4-42c7-87d5-e09aa0a475f6 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The Github platform hosts the OpenAPI guidelines and specifications, as well as a space for contributions and proposals of improvements in which any individual interested is encouraged to participate and raise issues regarding OAS implementation.  OAS has also been found to be featured in the Central Digital and Data Office platform from the United Kingdom.  In this platform, information about the use and implementation of OAS is shared and reviewed,   \r
\r
OAS discussion forum in Github:\r
https://github.com/OAI/OpenAPI-Specification/discussions\r
\r
\r
Describing RESTful APIs with OpenAPI 3:\r
https://www.gov.uk/government/publications/recommended-open-standards-for-government/describing-restful-apis-with-openapi-3\r
\r
'"""@en ;
    cav:refersTo camssa:78ba759e-fcad-4a92-9f19-777e9b0cdbfb .

camssa:595ad340-5bce-4f7f-b56a-8c7435238a8d a cav:Score,
