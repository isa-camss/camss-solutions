        owl:NamedIndividual ;
    cav:judgement "HTTP is used for any solution using internet, including innovative solutions."@en ;
    cav:refersTo camssa:75c08ea3-f4f7-48c5-aca7-9b55103e947e .

camssa:3f5a1fa7-f711-4ced-b70c-5116327ba216 a cav:Score,
