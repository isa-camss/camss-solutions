camssa:122dd09f-878f-4fe2-bbad-4f4a9d5df86b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The efficiency of the SAMM specification has been assessed by the University of Porto. In the "Measuring the Efficiency of Software Security Maturity Models" study, the SAMM specification is proposed as a framework to evaluate the performance of security activities, facilitating the identification of more efficient ways to implement security practices and allocate resources effectively._x000D_
_x000D_
"Measuring the Efficiency of Software Security Maturity Models" study:_x000D_
https://repositorio-aberto.up.pt/handle/10216/128456_x000D_
_x000D_
SAMM reference:_x000D_
https://owaspsamm.org/about/'"""@en ;
    cav:refersTo camssa:e55cb4ea-cb52-4176-af28-caa902f2c119 .

camssa:15f91fda-4eaa-4df6-b58d-c225f1d90cd0 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-5a7323988b5d96da801e2abd4d95248af758fe9adbbafd09dd76114629567ff4 ;
    cav:value "80"^^xsd:string .

