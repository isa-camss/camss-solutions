camssa:a7769539-1acd-4c37-b8dd-8c306ce360d9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ETSI TS 119 612 provides a common time-stamping protocol and token profiles for a Trusted List Scheme Operator (TLSO) to provide information on the status and history of Trusted Service Provider (TSP) services. Since it has had two major versions it would be acceptable to consider it has a sufficient market acceptance for its use.\r
\r
ETSI TS 119 612 specification:\r
https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.02.01_60/ts_119612v020201p.pdf'"""@en ;
    cav:refersTo camssa:a10bbca3-3422-463b-bd48-1adc99942f0b .

