        owl:NamedIndividual ;
    cav:judgement "RDF is a business domain agnostic specification that can be used at any business domain requiring RDF features."@en ;
    cav:refersTo camssa:46f06158-7143-4e17-8c74-c375efdd9dbb .

camssa:c9552720-f223-4025-97d8-22869f742f1d a cav:Score,
