    cav:value "100" .

camssa:747e1489-9a6f-43f5-be6a-6a0995293aaf a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "PDF 1.7 is not included at any European platform and has to be paid for its usage. However, Adobe has also made the specification available free of charge on the website, but notes that, although it has identical content, the document in question is not an official ISO document."@en ;
    cav:refersTo camssa:a847af59-20d3-4684-8730-d8281ec0b2ad .

