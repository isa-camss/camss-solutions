        owl:NamedIndividual ;
    cav:judgement """"After some research, there has not been found anything regarding the specification's effectiveness.\r
\r
ETSI TS 119 612 specification:\r
https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.02.01_60/ts_119612v020201p.pdf\""""@en ;
    cav:refersTo camssa:56725144-6c7f-4a55-b304-c19df97bca36 .

camssa:2dfd8260-1be7-4acc-83f7-3c05351bd1b5 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of JSON is not related to data or information confidetiality. Therefore, this criterion is not applicable to the specification.\r
\r
JSON specification:\r
https://www.ecma-international.org/wp-content/uploads/ECMA-404_2nd_edition_december_2017.pdf'"""@en ;
    cav:refersTo camssa:0a8bb95c-07dc-42c1-a480-84460e7d53ec .

camssa:2dfdac56-0f2a-4fc9-b541-76fad28b7cb7 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "No evidences have been found of the specification being included in a formal interoperability agreement between organisations involved in the European public services provision."@en ;
    cav:refersTo camssa:c4e9f095-ebf1-4925-bc5d-d6938c4ff2f8 .

