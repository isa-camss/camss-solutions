camssa:0c4f0b11-7477-4bcd-b4e3-12a9237e2069 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"DCAT-AP can contribute to the delivery of European public services by facilitating the discovery and access to data services provided by public administrations and by supporting the implementation of the European Union's digital single market strategy.\r
\r
DCAT-AP Specification:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/200\r
\""""@en ;
    cav:refersTo camssa:84e7b82b-9fb1-4ec9-b0b5-704f3a61c812 .

