        owl:NamedIndividual ;
    cav:judgement """The Core Public Service Vocabulary Application Profile can be found for free along within the European Collaborative Platform, Joinup.\r
\r
CPSV-AP reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-public-service-vocabulary-application-profile"""@en ;
    cav:refersTo camssa:6717547e-1912-4718-a57c-714814792b2b .

