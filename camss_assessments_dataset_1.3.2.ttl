    cav:assignedTo sc:c-4017a1ae4d077fbb3847280a1c20b41bf00c32d65fc9beaa2bea8cce550ac463 ;
    cav:value "1" .

camssa:42e3d47b-bed8-4f9e-b9dd-946884ea0cda a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """There is no Member State that includes CPSV-AP in their national catalogue with the National Interoperability Framework (NIF) aligned with at least 4 out of 5 sections of the European Interoperability Framework (EIF) according to the National Interoperability Framework Observatory (NIFO) factsheets.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards"""@en ;
    cav:refersTo camssa:1ab5a9e3-3b75-4aa5-958e-13467820b279 .

