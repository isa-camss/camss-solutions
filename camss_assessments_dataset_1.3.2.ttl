camssa:fa569fe6-26f8-4a4a-a7f2-9d3143ef1df3 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of XML is not related to e-accessibility. Therefore, this criterion is not applicable to this specification._x000D_
_x000D_
XML 1.1 W3C reference:_x000D_
https://www.w3.org/TR/xml11/'"""@en ;
    cav:refersTo camssa:f4f9cce3-723f-4a99-9995-c44e8772d035 .

