camssa:5b56066a-3de9-48e3-8d29-9e709f2f2ecc a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification counts with a specific section (5.1.4) that is about Language Support, so it can be determined that is designed to fully support multilingualism.

ETSI TS 119 612:
https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.02.01_60/ts_119612v020201p.pdf'"""@en ;
    cav:refersTo camssa:9ce9e00e-dff5-4890-84ee-57a908e30d03 .

