    cav:value "1" .

camssa:6ffca7fa-ef30-48ff-ba51-c387f254a9d6 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """DCAT-AP has a strong support from different communities. In fact, it is a joint initiative of:\r
• The DCAT-AP Working Group; the Directorate-General for Informatics: DG • DIGIT - in particular the SEMIC action of the ISA² programme;\r
the Directorate-General for Communications Networks, Content & • Technology: DG CONNECT; and\r
• The Publications Office of the EU.\r
\r
See:\r
https://joinup.ec.europa.eu/solution/dcat-application-profile-data-portals-europe/about  \r
https://ec.europa.eu/isa2/sites/isa/files/leaflet_dcat-ap_lr_v13.pdf \r
"""@en ;
    cav:refersTo camssa:6c5fc144-a013-4daa-9297-574f5992589b .

camssa:6ffcb5ac-2acd-4bc3-b047-c0190f7f59d8 a cav:Score,
