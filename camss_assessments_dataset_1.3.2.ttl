        owl:NamedIndividual ;
    cav:judgement """"The specification does not dwell in the exposure of interfaces to access the public administration's services in a direct way but it can ease the process. 

BFO reference:
https://www.iso.org/standard/74572.html\""""@en ;
    cav:refersTo camssa:1c0c1501-82b3-4f6e-9a3a-7ae839fffa64 .

