camssa:115ea1cb-b179-4ad9-a51f-573b6adaf322 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "No assessment in terms of efficiency or effectiveness has been found regarding ASiC Baseline Profile performance. "@en ;
    cav:refersTo camssa:e3538edd-6353-4043-a214-776ec50dccfc .

camssa:115f83e3-e71b-442b-80a8-d14da75a3cee a cav:Score,
        owl:NamedIndividual ;
