camssa:e696119e-91d9-4b74-856a-12184078fafe a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'XSD is a business domain agnostic specification that can be used at any business domain. \r
\r
XSD Reference:\r
https://www.w3.org/TR/2012/REC-xmlschema11-1-20120405/'"""@en ;
    cav:refersTo camssa:15905cf3-a442-4e26-929a-3dc890e20e89 .

