        owl:NamedIndividual ;
    cav:judgement """'TSP can be implemented in any platform and it is independent of any technology.

TSP IETF reference:
https://tools.ietf.org/html/rfc3161'"""@en ;
    cav:refersTo camssa:1107a6d2-ddc9-469a-a5a3-14ba4c065b9d .

