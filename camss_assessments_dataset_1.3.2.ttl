    cav:assignedTo sc:c-483e8900c47b40bc67a6bd1cbfce07884b9ac5f2c85e0214f334cc37e4e65c35 ;
    cav:value "0" .

camssa:9e69e799-f3ac-4e02-ab17-b92ba951b99b a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The purpose of IPv4 is not related to long term preservation of electronic records. Therefore this criterion is considered not applicable to this specification."@en ;
    cav:refersTo camssa:d2365989-314e-4c8f-a093-e6c52e344f4c .

