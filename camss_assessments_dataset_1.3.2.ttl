        owl:NamedIndividual ;
    cav:judgement "WSDL is a business agnostic specification that can be implemented in any domain requiring web services description and access. "@en ;
    cav:refersTo camssa:5318f7da-f10c-46ca-a637-ccb862a2b854 .

