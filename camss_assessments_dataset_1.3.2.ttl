        owl:NamedIndividual ;
    cav:assignedTo sc:c-c967c90bfc7bc13426924eca012de349ae51d4e8f652fe64bfbec2cccc8c8146 ;
    cav:value "1" .

camssa:e54e270d-6083-47c2-9cd0-ba3a069194f4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"Nowadays, SOAP 1.2 is a de-facto messaging protocol for exchanging information in a structured way, and invoke web services SOAP-based. It is used in a wide variety of solutions, while REST is widely used as well, SOAP remains as one of the main protocol to implement SOAs, and this fact includes innovative solutions. \r
\r
SOAP Reference:\r
https://www.w3.org/TR/soap12/  \r
\r
REST Reference:\r
https://docs.github.com/es/rest?apiVersion=2022-11-28\r
\r
Advantage of SOA's and explanation Reference:\r
https://medium.com/@amitbd1508/advantage-of-soa-over-msa-ee50636b9655\""""@en ;
    cav:refersTo camssa:ac6f3afc-5b56-4427-9b7d-78cad4b5abb9 .

camssa:e5513b49-82c1-4b1e-8353-8933e3bce563 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-3aec34db3622bf18675b8216d0fc1d68fc7eeb501b4f3326402038a3ceb95c21 ;
    cav:value "1" .

camssa:e55a6aa2-ae01-4bd1-b477-9af543609bdb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The ELI Governance Rules Document establishes that decisions are made using working group discussions and having consensus. However, there is no public review as part of the decision making process. \r
\r
Even though there is no specific public review process open like public consultations, the specifications is evolved following the consensus of participants who are the Member States.\r
\r
ELI reference:\r
https://eur-lex.europa.eu/eli-register/about.html\r
\r
Governance Rules: \r
https://eur-lex.europa.eu/content/eli-register/governance_rules.pdf """@en ;
    cav:refersTo camssa:b4590a02-1a0f-42cf-b736-625b9cfa3bb7 .

