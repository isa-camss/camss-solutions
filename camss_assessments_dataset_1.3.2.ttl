    cav:assignedTo sc:c-5df7a9f6081c945a22f500aa0ba2c452b8b9cd9497bd643ac76c39d34a18c319 ;
    cav:value "1" .

camssa:368426e1-8bdd-4ae9-a247-f2f3a7752d0f a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'After being evaluated compliant with the Regulation on Standardisation 1025/2012, IPsec has been identified by Commission Implementing Decision and included in the European list of ICT Standards for eprocurement. 
The specification can also be found in the Joinup repository (Interoperable Europe Portal).

ICT Technical Specifications:
https://single-market-economy.ec.europa.eu/single-market/european-standards/ict-standardisation/ict-technical-specifications_en'"""@en ;
    cav:refersTo camssa:cb54c357-cc7e-4748-9ea9-1552733f57cf .

camssa:368a4df4-b08e-4f57-82e4-8ed56334a800 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """XAdES Baseline profile has been selected within the CEF Digital Signature Service (hereby DSS) along with CAdES, ASiC and PAdES Baseline profiles.  \r
\r
Digital Signature Service is an open-source software library for electronic signature creation and validation supporting the interoperability of electronic signatures. The initiative is an enabler for cross borders interoperability between administrations and businesses.\r
\r
See: \r
https://ec.europa.eu/cefdigital/wiki/display/CEFDIGITAL/Standards+and+specifications\r
https://ec.europa.eu/cefdigital/DSS/webapp-demo/doc/dss-documentation.html\r
https://ec.europa.eu/cefdigital/wiki/pages/viewpage.action?pageId=82773260"""@en ;
    cav:refersTo camssa:825a3ed2-43e8-4d1c-b012-ce3e33ccb021 .

