camssa:dbbd40bf-702d-4461-9187-f8630a08efaa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "HTTP is publicly available for implementation and use, and therefore for everyone to study, for free on IETF's webpage.                                                           See:                                                                                                                                        https://tools.ietf.org/html/rfc2616  "@en ;
    cav:refersTo camssa:550fcccd-9b02-4e5d-b9ef-5d4c165b445b .

camssa:dbbfb154-69b3-43b7-942c-85b48610fce8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'TOSCA conformance can be manually assessed by following the TOSCA schema (CSAR) and the syntax and semantics defined in section 14 of the specification. Besides, the specification conformance requirements can be automatically measured via the OASIS Test Assertion Markup Language, as exemplified in TOSCA Github (see Github reference).\r
\r
TOSCA reference:\r
https://docs.oasis-open.org/tosca/TOSCA-Simple-Profile-YAML/v1.3/os/TOSCA-Simple-Profile-YAML-v1.3-os.html\r
\r
TOSCA-Github reference:\r
https://github.com/oasis-open/tosca-community-contributions/tree/master/tests'"""@en ;
    cav:refersTo camssa:a01380c8-0da9-4e5c-a7c0-4065ee6fd802 .

