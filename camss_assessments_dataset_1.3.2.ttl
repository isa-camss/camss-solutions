camssa:58c937f4-c739-45f3-8ced-03fdcc9273a6 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'NFVI fosters and simplifies ditigal services, but does not consistently offer any delivery channel. This specification contains some counterparts in terms of systems connectivity, basically brought by its discrete connectivity (i.e., services are separate from each other and not interconnectable with \r
each other).\r
\r
NFVI Deliver, Infrastructure Overview section 7.3:\r
https://www.etsi.org/deliver/etsi_gs/NFV-INF/001_099/001/01.01.01_60/ '"""@en ;
    cav:refersTo camssa:c10238ee-efa7-47f0-8a9d-1d957fed9c77 .

