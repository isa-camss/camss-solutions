camssa:79c61728-df01-4b5c-92d8-7f315abfb6f4 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ISO/IEC 27001 does not depend on other standards such as ISO/IEC 27002.  Moreover, it can be implemented without relying on specific technologies, as ISO/IEC 27001 comprises a set of requirements that ensure the compliance with ISMS.\r
\r
ISO 27001 reference:\r
https://www.iso.org/obp/ui/#iso:std:iso-iec:27001:ed-2:v1:en\r
'"""@en ;
    cav:refersTo camssa:fd5cef57-4def-4942-ae1c-c20608e29030 .

