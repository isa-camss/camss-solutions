    cav:assignedTo sc:c-cc5bd9a7d0b2acc7f246522414fd5f5d579b977180bb04fa60a545cb35dae90f ;
    cav:value "1" .

camssa:625a9db6-16c6-4cc5-bbb6-b0d89c2c91fc a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The purpose of RegOrg is not related to organisational interoperability. Therefore, this criterion is not applicable to the specification.\r
\r
RegOrg Joinup reference:\r
https://joinup.ec.europa.eu/solution/registered-organization-vocabulary"""@en ;
    cav:refersTo camssa:fa0775bc-f80d-493d-b3a8-f97f096ef8ad .

camssa:625d17ba-9bd3-4bee-bcda-2381c701fb90 a cav:Score,
