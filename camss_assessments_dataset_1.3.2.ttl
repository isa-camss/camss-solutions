    cav:assignedTo sc:c-26aeec3cf5b3b4879325e85fcd751d0c17f62c6c3113109fb100883a553ec0af ;
    cav:value "100" .

camssa:38566e80-be35-4e3f-9757-44266ab40d82 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The specification is included in 8 Member States' catalogues of recommended specifications. Some examples of Member States including CSV on their catalogues are the Netherlands, Slovenia or Sweden.\r
See: \r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards\r
"""@en ;
    cav:refersTo camssa:27d93604-cf9d-4094-8780-7100a666200a .

