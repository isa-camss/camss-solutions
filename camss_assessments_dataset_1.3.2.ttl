        owl:NamedIndividual ;
    cav:assignedTo sc:c-b45c8f7e446b1343c6b6961290d2106768aa43c1f123f5e436d0255c003abb50 ;
    cav:value "1" .

camssa:1f30522e-2ac9-405c-829f-bc0715c620c8 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """OASIS has defined a clear Technical Committee (hereby TC) process where all the stakeholders involved have the opportunity to participate in the development of the specification development process. \r
All the information related to a TC activity is hosted and can be consulted. \r
See: \r
https://www.oasis-open.org/policies-guidelines/tc-process-2017-05-26"""@en ;
    cav:refersTo camssa:11e2b629-bfda-4d67-a4c3-0e4071503216 .

