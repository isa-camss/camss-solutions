    cav:assignedTo sc:c-3671439b412291ce208a0ade6313c64aeb2942059c7543ca39322c56458bcf96 ;
    cav:value "1" .

camssa:c781060c-787b-47f4-b13e-a44135ef9adf a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Although the specification is a common method used by European Institutions for the development of projects, no formal agreement (SLAs among others) has been found to consider this criterion positive. \r
\r
However, it is worth to note that there are several initiatives that trust OpenPM2 for the development of projects and reach objectives. As an example, OpenPM2 supports CSDP Missions and Operations.\r
\r
CSDP Missions and Operations:\r
https://www.pm2alliance.eu/our-news/pm2-in-support-of-csdp-missions-and-operations/\r
\r
PM2 Alliance official webpage:\r
https://www.pm2alliance.eu/"""@en ;
    cav:refersTo camssa:4e05dd2e-2141-41b0-ae97-447772e5f3aa .

camssa:c7892f51-435e-4e17-86c8-91e27d2f78ae a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification can be used as a communication protocol in systems that facilitate the delivery of European public services. It is commonly employed in web services architectures to enable interoperability and communication between different systems, which can be beneficial in the context of public service delivery.\r
\r
SOAP Reference:\r
https://www.w3.org/TR/soap12/'"""@en ;
    cav:refersTo camssa:2cd927e1-b406-4e4a-8949-578c755b0bd2 .

