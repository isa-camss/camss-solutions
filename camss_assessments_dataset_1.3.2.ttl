        owl:NamedIndividual ;
    cav:assignedTo sc:c-d129862d6c9639e131c7d5eef095af16ef94d57ec0d52f955bf909ba8ec688e8 ;
    cav:value "1" .

camssa:2b286924-3bac-4f6f-b925-fca0cd869e40 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """There are existing documentation and studies assessing the effectiveness and efficiency of IPv4. It is a constant in studies the comparison between both versions, IPv4 and IPv6. As well, the studies show the relevance of coexisting before finding the most efficient method to move on from one protocol to another. \r
See:\r
https://www.researchgate.net/publication/317135434_A_STUDY_ON_IPv4_and_IPv6_THE_IMPORTANCE_OF_THEIR_CO-EXISTENCE\r
https://pdfs.semanticscholar.org/3455/fdc0741edc3263295ae8d0c226119613db81.pdf\r
https://www.researchgate.net/publication/224593091_A_comparative_review_of_IPv4_and_IPv6_for_research_test_bed"""@en ;
    cav:refersTo camssa:553bef2d-7c83-468c-ba4e-069a5ae8f5d0 .

