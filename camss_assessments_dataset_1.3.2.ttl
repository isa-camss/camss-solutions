camssa:d98a6986-ae13-4ad8-b49f-a5040aefe78d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"EuroVoc is a multidisciplinary thesaurus created for communication purposes in the European Union so, \r
allowing customisation would dampen the specification's main purpose. Nonetheless, it is possible to create your own subsets and mappings (while maintaining the consistency of the structure and main classifications of the specification).\r
\r
EuroVoc:\r
https://op.europa.eu/es/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu/resource\r
/dataset/eurovoc\""""@en ;
    cav:refersTo camssa:c77f4e7c-b8c7-4c5c-bec9-ddfc539e26c8 .

