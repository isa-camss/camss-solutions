        owl:NamedIndividual ;
    cav:judgement """'Slovakia is recommending ADMS in its ICT National Catalogues. \r
\r
Slovakia’s Catalogue:\r
https://www.mirri.gov.sk/sekcie/informatizacia/governance-a-standardy/standardy-isvs/index.html\r
\r
CAMSS List of standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards'"""@en ;
    cav:refersTo camssa:40824c37-bc70-422b-b5e4-94b4d7342c6f .

