        owl:NamedIndividual ;
    cav:judgement """'The specification is not a European Standard.

World Wide Web Consortium (W3C) reference:
https://www.w3.org/'"""@en ;
    cav:refersTo camssa:648295cd-6d0c-42c6-8974-7dd5f7950c78 .

