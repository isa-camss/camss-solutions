camssa:1080b90b-6f70-4717-bf0e-5d2b10c24905 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The flexiblity of DCAT-AP makes it possible for organisations to choose the parts of the specification they want to implement. For example, an organisation may choose to implement only the core elements of DCAT-AP in order to describe and publish metadata about their datasets. Alternatively, they may choose to implement additional elements of the standard, such as those related to access control or provenance, in order to support more advanced use cases.\r
\r
DCAT-AP Specification:\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/200'"""@en ;
    cav:refersTo camssa:903bad8c-9645-47da-a1cc-64c01a5ed1ee .

camssa:108185c8-51bf-40a9-a12e-01c25c9e52a4 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d83a73b3287a82d85b1bd3f5b18089e9794b091b6c6457992a77d5be6bc1500a ;
    cav:value "100" .

