        owl:NamedIndividual ;
    cav:assignedTo sc:c-b8f7f5098ef900044e245ff5b30832215e00204b1e244545d80a28013685c811 ;
    cav:value "100" .

camssa:8b66590c-c041-4289-a76e-3afdf9f657af a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is more towards semantic interoperability and does not adress UX and data representation\r
layers.'"""@en ;
    cav:refersTo camssa:598d0003-d5ab-457a-a704-c7d8fc7dbc4e .

camssa:8b6743fd-329d-4472-aa41-68c89baecb03 a cav:Score,
