camssa:6c36e71f-c9f3-49b5-8336-7f407d7d1aa3 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The roles, state and properties that are defined in this specification do not form a complete web language or format. The implementation of WAI-ARIA relies on the context of a host language, like HTML, and can be partially implemented.\r
\r
WAI-ARIA Authoring Practice reference:\r
https://www.w3.org/TR/wai-aria-practices/\r
\r
WAI-ARIA User Agent Implementation Guide:\r
https://www.w3.org/TR/wai-aria-implementation/'"""@en ;
    cav:refersTo camssa:96552449-6544-4c41-ac77-c2c0d8cecb7a .

camssa:6c3c83b7-74bc-42a0-adec-e48a1b547b9e a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d9b9ce1d270550422a8ea6097d2ffa1d923267fd681c56280e3b7810a14a580a ;
    cav:value "100" .

camssa:6c3d09dd-6e0b-4d13-84b0-e093c2e260f6 a cav:Score,
