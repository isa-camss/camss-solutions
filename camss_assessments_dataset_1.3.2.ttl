camssa:968a079d-7214-46c5-9ac4-5cfd8cc83457 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'CSV makes sure content is available on the web, structures data and makes it usable in a non-proprietary open format. Consequently the CSV fosters the simplification of the delivery of  European public services as it makes files available for any system.   \r
                           \r
CSV reference:\r
https://datatracker.ietf.org/doc/html/rfc4180'"""@en ;
    cav:refersTo camssa:087c3897-f1d0-4c38-a0a8-6e87a1196245 .

