    cav:assignedTo sc:c-50ab6a29689585b917f7b2972d2c41e8c8c52723c2d58eb9b92109c938d4e825 ;
    cav:value "100" .

camssa:930e2d8a-f992-4585-900a-a626aac208ef a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Indexed Database API is not included in any national catalogue of recommended specifications whose Member State NIF has a high performance on interoperability according to NIFO factsheets.

NIFO Factsheets:
https://interoperable-europe.ec.europa.eu/collection/nifo-national-interoperability-framework-observatory/digital-public-administration-factsheets-2024

CAMSS list of standards:
https://interoperable-europe.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards'"""@en ;
    cav:refersTo camssa:9bbdf3a5-b25f-42db-81de-d5a4853381f4 .

camssa:9315a96a-b5a4-403c-a930-d44706cf82d7 a cav:Score,
