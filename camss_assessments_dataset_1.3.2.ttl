    cav:value "100" .

camssa:b32026b1-0c3e-40ab-92c0-42c759d5099c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There has not been found any community sharing their data and results on national platforms. However, IPv4 indirectly encourages the creation of communities on national and European platforms sharing news and updates about IPv4 addresses, such as RIPE organisation.

IPv4 IETF:
https://www.rfc-editor.org/rfc/rfc791

RIPE organisation:
https://www.ripe.net/'"""@en ;
    cav:refersTo camssa:9318c0d8-1233-42ab-86ef-84e0671c2ea1 .

camssa:b3238ecb-c6ee-4c63-bf32-b9ed6be6ac43 a cav:Score,
