    cav:value "100" .

camssa:70186bc5-d85b-4b7c-ba48-6b02c699ab8e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of genericode is not related to covering privacy aspects at European nor National level. Therefore, this criterion is considered not applicable to this specification.

Code List Representation (genericode): https://docs.oasis-open.org/codelist/genericode/v1.0/os/genericode-v1.0-os.html'"""@en ;
    cav:refersTo camssa:7b4f5368-d73d-450c-a7fc-3231ce4fe6ed .

camssa:701a581c-a878-4b3d-9177-33945cbf9592 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """SMTP is maintained and developed by IETF which is an international community developing open standards. \r
\r
Developer community IETF:\r
https://www.ietf.org/about/"""@en ;
    cav:refersTo camssa:05c24b94-6f3f-43b4-9cdb-038c2c04a181 .

camssa:701d0ec5-2484-4ab6-94ce-1f451a311608 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'ETSI TS 119 612 supports digital signatures and other trust services, which rely on strong authentication methods to verify the identity of the individuals or entities involved in a transaction. These mechanisms help ensure that only authorised individuals can perform actions like signing or accessing data.

ETSI TS 119 612:
https://www.etsi.org/deliver/etsi_ts/119600_119699/119612/02.02.01_60/ts_119612v020201p.pdf'"""@en ;
    cav:refersTo camssa:4a1f88f7-6e09-4ead-92ac-0d2a43224c43 .

camssa:701e1bad-93c4-46d7-979f-3b2e22ce0849 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The PROV family of documents is designed to promote data portability through interoperability, support data exchange through various serialization formats, allow for semantic alignment with other ontologies, and enables customization and extensions to meet specific service requirements, it can be stated that it can support the implementation or evolution of European public services.\r
\r
PROV Primer document:\r
https://www.w3.org/TR/prov-primer/'"""@en ;
    cav:refersTo camssa:a626ddf0-cb7f-42b0-89c8-d56d48b9281c .

camssa:701fcbfa-24b3-45f4-b42c-2fc269c9b031 a cav:Score,
