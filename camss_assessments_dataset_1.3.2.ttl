    cav:value "1" .

camssa:fc5bb37c-fe74-40c6-9442-984f3b8e4479 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is platform agnostic because it is sufficiently agnostic to work in any search engine, referring to as a program that searches for and identifies terms in a database that correspond to keywords or characters specified by the user.\r
\r
\r
DCMI About:\r
https://www.dublincore.org/about/ '"""@en ;
    cav:refersTo camssa:51eac1e6-8b8d-450f-9663-6e015fe8ef54 .

