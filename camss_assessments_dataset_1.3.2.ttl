    cav:assignedTo sc:c-0229101dfe08cbe58da1e454363d30a8178a2e120466c8db23965488cae5c8b1 ;
    cav:value "1" .

camssa:e4217165-dd42-4790-b9c6-b5c235618fcf a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Preservation profiles may contain descriptions in more than one language, (see section 6.4 of the specification).  Nontheless, specific provisions to this end are not given.\r
\r
ETSI TS 119 511 specification:\r
https://www.etsi.org/deliver/etsi_ts/119500_119599/119511/01.01.01_60/ts_119511v010101p.pdf'"""@en ;
    cav:refersTo camssa:f7bb63aa-dd07-467f-a294-64a410b8a66c .

