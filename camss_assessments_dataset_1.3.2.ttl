        owl:NamedIndividual ;
    cav:assignedTo sc:c-f53dee88cf8529a93a68be781005e903c270057da1a72e2f89e8cb154be0c51b ;
    cav:value "100" .

camssa:6fb8688c-9e6a-41fa-ab65-d154c9d44f33 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of IPv4 is not related to e-accessibility. Therefore this criterion is considered not applicable to the specification.

IPv4 IETF:
https://www.rfc-editor.org/rfc/rfc791'"""@en ;
    cav:refersTo camssa:b582ca96-034d-455f-9a92-c05faa378b2e .

camssa:6fbb2b22-f08b-4f0a-95a3-2c2afcbaee47 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The Web Services Security (WS-Security) main function is to reinforce integrity and confidentiality of the messages used by SOAP specification. Therefore, this criterion is not applicable to the specification."@en ;
    cav:refersTo camssa:d721e916-7a92-4a4d-9e31-969c5dbc6093 .

camssa:6fc03a66-f41f-440e-b1ed-75bf29888dc9 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Linked Data Event Streams offers a service to help e-Government professionals share their experience with each other, so it fosters the creation of innovative solutions. By making data accessible via one URI endpoint, LDES makes it easy to retrieve data which is published as a uniform linked data standard. 

LDES specification: 
https://joinup.ec.europa.eu/collection/semic-support-centre/linked-data-event-streams-ldes'"""@en ;
    cav:refersTo camssa:287274da-cb90-4c3c-9e3c-a71d4ce44fea .

camssa:6fc41e82-47cc-42ba-8f88-86b4ef8d1634 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-d129862d6c9639e131c7d5eef095af16ef94d57ec0d52f955bf909ba8ec688e8 ;
    cav:value "1" .

camssa:6fc931c9-23f8-4ef7-aa48-d1d971377199 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'To ensure information is protected against unauthorised changes, UTF-8 needs to use additional security measures that may include digital signatures or encryption mechanisms.\r
\r
UTF-8 specification:\r
https://datatracker.ietf.org/doc/html/rfc3629\r
\r
Integrity constraints to UTF-8:\r
https://documentation.sas.com/doc/en/pgmsascdc/9.4_3.5/viyadatamig/p03xdtcn8yshoan1f26is9okzn4p.htm\r
'"""@en ;
    cav:refersTo camssa:5cee092a-1485-4aac-b99b-ce84d7a9681b .

camssa:6fcaf3fa-37ce-4494-9f2c-5ac12da594bb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """Betterr Regulation Toolbox can be found for free on the European Comission webpage.\r
\r
Better Regulation Toolbox reference:\r
https://ec.europa.eu/info/sites/info/files/better-regulation-toolbox_2.pdf"""@en ;
    cav:refersTo camssa:79649f37-06d1-4df3-b922-2982681f6499 .

