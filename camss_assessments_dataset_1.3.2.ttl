camssa:9cae4c55-3268-45f7-96fe-aa55026cb93a a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'After carrying out a search, two projects involving the specification were found: the Data Dictionary (DD) system developed under the IDA/EINRC framework running at the European Environment Agency’s site, and eCertis under ISA².\r
\r
European Environment Agency reference:\r
http://dd.eionet.europa.eu\r
\r
ISA² reference:\r
https://ec.europa.eu/isa2/solutions/e-certis_en#:~:text=e-Certis%20is%20a%20free%20online%20tool%20mapping%20documents,%28e.g.%20tax%2C%20social%20security%20obligations%2C%20criminal%20records%2C%20etc.%29.'"""@en ;
    cav:refersTo camssa:de813c3f-2ebb-4b3a-895c-8cb4bdbca250 .

