    cav:value "100" .

camssa:d9de3c2d-bc48-40bf-9a04-a6c80eab5a5d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The standard or specification is included in 3 national catalogues. They belong to Member States which comply with at least 4 out of 5 sections of the EIF according to the NIFO factsheets. (e.g. the Netherlands, Spain, Sweden).  \r
                                                                                         \r
See:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards"""@en ;
    cav:refersTo camssa:add0385f-bf20-4bc0-8715-2aa5a6d6d2f9 .

