        owl:NamedIndividual ;
    cav:judgement """'WAI-ARIA enhances assistive technologies to interact with accessibility APIs and can restructure, simplify, stylise, or rescale content to help a different set of users.\r
\r
WAI-ARIA reference, section 1.6:\r
https://www.w3.org/TR/wai-aria/'"""@en ;
    cav:refersTo camssa:40dba7a7-82a9-46a9-bb04-cf7fae4b636d .

