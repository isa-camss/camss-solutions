    cav:assignedTo sc:c-812668363d8f0cc562041fae6c588e1555372bf0bf5c16835be996dd72070013 ;
    cav:value "20" .

camssa:d9bc0b5f-940d-4900-b421-a2405a71ea59 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-26aeec3cf5b3b4879325e85fcd751d0c17f62c6c3113109fb100883a553ec0af ;
    cav:value "100" .

camssa:d9bcead6-6fa2-47da-9fe0-0e7c093e2afb a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """DNS is already associated to an EIRA ABB in the EIRA Library Of Interoperability Specifications (ELIS). More specifically, DNS can define the interoperability aspects of the "Network Service" and "Network Component" ABBs of the EIRA Technical View.\r
\r
See: \r
https://joinup.ec.europa.eu/solution/elis/distribution/eliscataloguev100betaxlsx"""@en ;
    cav:refersTo camssa:467e1e2b-ff80-4fc5-8fe5-a6cb5c329f08 .

camssa:d9bdc5fa-1639-4baf-856e-0efbaf3e2a95 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-1cd71a7b6d54631ba58cc8b0655a443d696f49ec74a0f4cccc871de7789d6a60 ;
    cav:value "1" .

camssa:d9be1784-5e48-4b85-b491-142365d33a69 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a6fa642bc8eceff2b1d333dc1123748399264c028fde2fd78308f0a0209ae21b ;
    cav:value "100" .

camssa:d9bf730c-2e81-406f-a126-4d2abf214c9e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "WS-Security main function is to enforce security for messages as an extension of SOAP, it can be said that is part ensuring the availability of the internal information."@en ;
    cav:refersTo camssa:f9b401a6-390c-4dd1-a628-785309bbb16c .

camssa:d9c496ea-f89a-4d31-af53-1de8bac47402 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The JSON specification itself does not provide inherent features for ensuring data integrity, nonetheless, developers can incorporate security practices, cryptographic techniques, and data validation mechanisms to maintain data integrity when working with JSON.\r
\r
How do you secure and encrypt JSON and XML data in web communication:\r
https://www.linkedin.com/advice/0/how-do-you-secure-encrypt-json-xml-data-web-communication\r
\r
Use Cases and Requirements for JSON Object Signing and Encryption (JOSE):\r
https://www.rfc-editor.org/rfc/rfc7165.html'"""@en ;
    cav:refersTo camssa:ef285b5b-d495-4a36-8cb4-49eb19e6ef96 .

camssa:d9c624d0-8dce-4db5-9ab9-1f190431d72c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'While genericode itself is not a dedicated business process modeling tool, its standardised representation of code lists and controlled values can support and enhance the modeling of business processes within organisations. By providing a common framework for representing data elements used in business processes, genericode contributes to semantic clarity, standardization, interoperability, and customisation, which are essential aspects of effective business process modeling.

Code List Representation (genericode): https://docs.oasis-open.org/codelist/genericode/v1.0/os/genericode-v1.0-os.html'"""@en ;
    cav:refersTo camssa:10ff946e-6c5c-4712-95c8-df19051e9a00 .

camssa:d9c66fb3-b48e-4c98-8782-0bb283deb136 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The purpose of UBL is other than ensuring the protection of personal data.  Therefore this criterion is not applicable to this specification.\r
\r
UBL v2.3 reference:\r
http://docs.oasis-open.org/ubl/os-UBL-2.3/UBL-2.3.html'"""@en ;
    cav:refersTo camssa:9ab3bd6c-0214-43d2-a401-943066f21f1b .

camssa:d9c6f984-0bcd-4e44-9c4a-7ee14d9b87d2 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-483e8900c47b40bc67a6bd1cbfce07884b9ac5f2c85e0214f334cc37e4e65c35 ;
    cav:value "1" .

camssa:d9ce51e3-a544-4737-bd3d-f63a34aebe33 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """OASIS has defined a clear Technical Committee (hereby TC) process where all the stakeholders involved have the opportunity to participate in the development of the specification development process.\r
\r
OASIS guideline:\r
https://www.oasis-open.org/policies-guidelines/tc-process-2017-05-26"""@en ;
    cav:refersTo camssa:bb862b5e-1430-4427-bb1e-cda2073d1411 .

camssa:d9cf3743-00a6-440b-898f-bd782faba11d a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-53abe85b1365f86aa58a25566e54e082ea2d70ee8d9fbaf09ccab20af30f3332 ;
    cav:value "0" .

camssa:d9d503dd-eb65-4e67-b597-83fbe8f5d00e a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'Although ADMS was developed taking into account the perspective of the eGovernment System Development, it is a vocabulary that could be reused beyond this domain. It aims to ease the standardisation of assets description in assets repositories, to enhance the discoverability and reuse of assets and solutions. \r
\r
ADMS Specification W3C:\r
https://www.w3.org/TR/vocab-adms/'"""@en ;
    cav:refersTo camssa:d72a2d6c-8a68-4b91-a7df-cbcf99c9a7c0 .

