        owl:NamedIndividual ;
    cav:judgement """'ETSI TS 119 511 can be found on the specifications and standards repository of its own standards\r
development organization, the European Telecommunication Standards Institute (ETSI).\r
\r
ETSI standards repository:\r
https://www.etsi.org/committee/1399-esi'"""@en ;
    cav:refersTo camssa:7cbc17d3-227d-43ed-808d-e7ae6fbbf823 .

camssa:b1fb3b4f-6fd0-4873-b3d3-ee6ba13eac73 a cav:Score,
