camssa:e0c95c68-6924-4d3d-b837-2cecdada16e6 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'This specification is currently not included in the EIRA Library of Interoperability Specifications (ELIS), but will be included in the next release of the ELIS. The response to this criterion is positive because OData is mappable to the European Interoperability Reference Architecture (EIRA).\r
\r
EIRA Library of Interoperability Specifications (ELIS):\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/solution/elis/release/v110'"""@en ;
    cav:refersTo camssa:a11d9462-50d3-4834-84c4-9e2018b37505 .

