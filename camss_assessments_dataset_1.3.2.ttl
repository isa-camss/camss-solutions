camssa:05aaeaff-7ca0-4116-adab-a3b4c7923b38 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "The specification defines an XML based data model for describing web services. This data-model can be reused as a cross-sector data model on how to proceed with a web service description and all elements that it should contain. "@en ;
    cav:refersTo camssa:b86d23c3-b779-4707-9d1a-91c18fffbaac .

