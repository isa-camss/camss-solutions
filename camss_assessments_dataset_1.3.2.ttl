camssa:d8fcdf78-8219-4136-9f62-b2ea76830269 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'While the ELI system itself does not specifically address the protection of personal data, any data processed
within the EU is subject to the General Data Protection Regulation (GDPR). Therefore, this criterion is
considered not applicable to this specification.

ELI reference:
https://eur-lex.europa.eu/eli-register/about.html

GDPR Regulation (EU) 2016/679 reference:
https://eur-lex.europa.eu/eli/reg/2016/679/oj'"""@en ;
    cav:refersTo camssa:882543e9-0b6a-4e52-8f78-2c01fbf56bed .

camssa:d8fdbd8f-7035-442e-b601-6377ef523213 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-e225f44a0b0939b1b30a1ab03b2f38baeca8699c0cd44b4e39adbe19ffbb3542 ;
    cav:value "100" .

