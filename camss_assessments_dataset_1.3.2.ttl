        owl:NamedIndividual ;
    cav:judgement """'The purpose of DNS is not related to the reuse of information.  Therefore, this criterion is not applicable to the specification.  \r
\r
DNS IETF reference:\r
https://www.ietf.org/rfc/rfc1034.txt'"""@en ;
    cav:refersTo camssa:bff90d33-714b-4529-8e58-6143f39364b1 .

