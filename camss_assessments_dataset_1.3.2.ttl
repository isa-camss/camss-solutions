camssa:5ae096b6-a3a9-4bec-9fd7-797ca942d3d6 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'When serializing JavaScript objects into JSON, properties with a value of undefined are omitted from the resulting JSON string. This flexibility enables working with JSON data that may not contain all the expected fields or may vary in structure, thus allowing for partial implementations.\r
\r
JSON specification:\r
https://www.ecma-international.org/wp-content/uploads/ECMA-404_2nd_edition_december_2017.pdf'"""@en ;
    cav:refersTo camssa:4c0e1ee5-f8b2-4cfa-af6e-3155af519658 .

