    cav:assignedTo sc:c-fb2c0a4ddb03b09ecd5450c5a1d6aeed4e51c2a0387709a95a89cd850a7dd180 ;
    cav:value "100" .

camssa:07fa1d39-c2d0-479d-9cc5-c4e0ae6d70b1 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'The specification is available without any restrictions related to Fair, Reasonable, and Non-Discriminatory ((F)RAND) licensing terms. The specification is published under an open source license.                                           \r
\r
EUPL 1.2 reference: \r
https://eupl.eu/1.2/es/'"""@en ;
    cav:refersTo camssa:07748b12-5e63-4523-a84b-f6d901061dd4 .

