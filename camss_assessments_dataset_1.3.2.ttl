        owl:NamedIndividual ;
    cav:judgement """"EuroVoc is used to technogically maintain a single consistent definition of various domains (eg. Politics, \r
Euopean Union). Therefore, EuroVoc's users such as the European Union institutions and the Publications \r
Office of the EU use it consistently.\r
\r
EuroVoc Browser:\r
https://eur-lex.europa.eu/browse/eurovoc.html?locale=en\r
\r
EuroVoc: https://op.europa.eu/en/web/eu-vocabularies/dataset/-/resource?uri=http://publications.europa.eu\r
/resource/dataset/eurovoc\""""@en ;
    cav:refersTo camssa:fbe3faae-985a-4926-b223-6ad834bd22a3 .

