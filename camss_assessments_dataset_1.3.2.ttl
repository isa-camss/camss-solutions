    cav:assignedTo sc:c-50ab6a29689585b917f7b2972d2c41e8c8c52723c2d58eb9b92109c938d4e825 ;
    cav:value "100" .

camssa:5758366e-5093-4327-befc-b2843d960a3c a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """The application of the once-only principle in all EU Member States' public administrations aims at reducing the administrative burden. This Core Vocabulary fosters interoperability between public administrations, cross border services and impacts positively the development of eGovernment.\r
\r
CCCEV reference:\r
https://joinup.ec.europa.eu/solution/e-government-core-vocabularies/core-criterion-and-core-evidence-vocabulary\r
\r
Joinup news page "CCCEV - a key enabler of the Once-Only Principle":\r
https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/news/cccev-and-once-only-principle"""@en ;
    cav:refersTo camssa:56c84aab-7b4d-4a4f-96e4-a6d0a8b529f0 .

camssa:575b689b-7365-4cc4-a8e0-ab4699936aee a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """'There are many documents that provide an overview of the usage and functionalities of MIME. Such is the case of a scholar paper whcih describes the efficiency of the mechanisms provided by MIME for Internet multimedia mail.\r
\r
MIME: a portable and robust multimedia format for Internet mail:\r
https://link.springer.com/article/10.1007/BF01210505'"""@en ;
    cav:refersTo camssa:7224dafa-2501-4743-92f6-b3c24e4c29da .

camssa:575e9e02-730e-47d2-9822-5c6cc184ed4d a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """OpenPM2 is not included in any national catalogue of recommended specifications whose Member State NIF is fully aligned with at least 4 out of 5 sections of the EIF according to NIFO factsheets.\r
\r
CAMSS List of Standards:\r
https://joinup.ec.europa.eu/collection/common-assessment-method-standards-and-specifications-camss/camss-list-standards"""@en ;
    cav:refersTo camssa:11f72433-26cc-4bd9-bea0-90d1ea649de1 .

