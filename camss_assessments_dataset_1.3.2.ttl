    cav:assignedTo sc:c-f6669d041c301e6aadc132bb9de2d1d2f620f9fcb8b5d147c7b08c0393b53d0c ;
    cav:value "0" .

camssa:280c182c-1db0-4065-82b1-000f93e55b31 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement """"The IPsec specification is a key protocol for data security and privacy. This protocol has been integrated into the latest version of the Internet protocol (IPv6), and it can also be integrated with IPv4 as an extension. In addition, it is used to configure VPNs and to encrypt IP packets.

IPSec reference:
https://www.rfc-editor.org/rfc/rfc6071.html

IPsec VPN's:
https://www.cloudflare.com/es-es/learning/network-layer/what-is-ipsec/

IPsec IPv6:
https://www.cisco.com/c/en/us/td/docs/ios-xml/ios/ipv6/configuration/xe-3s/ipv6-xe-3s-book/ip6-ipsec.pdf

Ipsec IPv4:
https://www.twingate.com/blog/ipsec\""""@en ;
    cav:refersTo camssa:21c5d444-ca54-4b3b-9346-ccdcdfa01079 .

camssa:280ec7cb-f6ff-40e6-ad80-8b4f0532a672 a cav:Score,
        owl:NamedIndividual ;
    cav:assignedTo sc:c-a16c678a586cf542d2ae1d6cd8a987bd6ed0b2af52ba0e04d8872fe616a9b7bd ;
    cav:value "100" .

