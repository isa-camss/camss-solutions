        owl:NamedIndividual ;
    cav:assignedTo sc:c-51782b9aa4b92f4aba322a549b9d3972e304ca68f9353073c29add782502d910 ;
    cav:value "100" .

camssa:e151848b-3b61-42c5-8e2b-0cb665fce2aa a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "As a common data exchange format, CSV fosters the visibility of administration's data. It eases the publication of structured data for the consumption by the different stakeholders. Therefore, CSV fosters the visibility of administrations data. Additionally, it can be used internally easing as well de decision-making process. "@en ;
    cav:refersTo camssa:4b49c0c4-56dc-4bd7-90ad-f207446dd582 .

