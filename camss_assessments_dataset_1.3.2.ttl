    cav:value "100" .

camssa:cafd447c-6e7e-46e2-bbbc-41621c027973 a cav:Statement,
        owl:NamedIndividual ;
    cav:judgement "ASiC Baseline Profile provides basic features needed to overcome barriers in the accomplishment of signed data interchange across borders. By providing different levels of conformity according to data transaction needs, it is highly scalable without hampering the interoperability between actors involved. "@en ;
    cav:refersTo camssa:99d89ab6-21fb-4146-a857-df3484d674d8 .

